{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slashobserve.com/schemas/observespec.v0.json",
  "title": "Dashboard",
  "description": "ObserveSpec v0: one SlashObserve dashboard.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "title", "timeRange", "panels"],
  "properties": {
    "specVersion": { "const": "0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 2000 },
    "tags": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,39}$" }
    },
    "timeRange": { "$ref": "#/$defs/timeRange" },
    "refresh": {
      "description": "Auto-refresh interval such as 30s, 1m or 1h.",
      "type": "string",
      "pattern": "^[1-9][0-9]{0,4}[smh]$"
    },
    "variables": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/variable" } },
    "panels": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/panel" } }
  },
  "$defs": {
    "timeRange": {
      "title": "TimeRange",
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/timeExpression" },
        "to": { "$ref": "#/$defs/timeExpression" }
      }
    },
    "timeExpression": {
      "description": "Relative (now, now-6h, now+1d, now-1d/d) or absolute RFC 3339 time.",
      "type": "string",
      "pattern": "^(now([+-][1-9][0-9]*[smhdwMy])?(/[smhdwMy])?|[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2}))$"
    },
    "variable": {
      "title": "Variable",
      "type": "object",
      "discriminator": { "propertyName": "type" },
      "oneOf": [{ "$ref": "#/$defs/queryVariable" }, { "$ref": "#/$defs/customVariable" }]
    },
    "variableName": {
      "description": "Referenced in queries as $name, ${name} or ${name:format}.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$"
    },
    "queryVariable": {
      "title": "QueryVariable",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "datasource", "query"],
      "properties": {
        "name": { "$ref": "#/$defs/variableName" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "type": { "const": "query" },
        "datasource": { "$ref": "#/$defs/datasourceRef" },
        "query": { "$ref": "#/$defs/query" },
        "multi": { "type": "boolean" },
        "includeAll": { "type": "boolean" }
      }
    },
    "customVariable": {
      "title": "CustomVariable",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "options"],
      "properties": {
        "name": { "$ref": "#/$defs/variableName" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "type": { "const": "custom" },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "multi": { "type": "boolean" },
        "includeAll": { "type": "boolean" }
      }
    },
    "panel": {
      "title": "Panel",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "gridPos", "datasource", "query"],
      "properties": {
        "id": {
          "description": "Stable across versions; comments anchor to it.",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "type": { "$ref": "#/$defs/panelType" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "gridPos": { "$ref": "#/$defs/gridPos" },
        "datasource": { "$ref": "#/$defs/datasourceRef" },
        "query": { "$ref": "#/$defs/query" },
        "legend": { "type": "string", "minLength": 1, "maxLength": 200 },
        "unit": { "$ref": "#/$defs/unit" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 10 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "thresholds": {
          "description": "Strictly ascending by value.",
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/threshold" }
        }
      }
    },
    "panelType": { "title": "PanelType", "enum": ["timeseries", "stat", "table", "bargauge"] },
    "gridPos": {
      "title": "GridPos",
      "description": "Position on the 24-column grid; x + w must not exceed 24.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 23 },
        "y": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "w": { "type": "integer", "minimum": 1, "maximum": 24 },
        "h": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "datasourceRef": {
      "title": "DatasourceRef",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "uid"],
      "properties": {
        "type": { "$ref": "#/$defs/datasourceType" },
        "uid": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$" }
      }
    },
    "datasourceType": { "title": "DatasourceType", "enum": ["prometheus", "clickhouse"] },
    "query": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "threshold": {
      "title": "Threshold",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "color"],
      "properties": {
        "value": { "type": "number" },
        "color": { "$ref": "#/$defs/thresholdColor" }
      }
    },
    "thresholdColor": {
      "title": "ThresholdColor",
      "description": "A semantic color (ok, info, warning, critical) or a #rrggbb hex color.",
      "type": "string",
      "pattern": "^(ok|info|warning|critical|#[0-9a-fA-F]{6})$"
    },
    "unit": { "title": "Unit", "description": "A Grafana unit id.", "enum": ["none", "short", "sishort", "percent", "percentunit", "humidity", "dB", "hex0x", "hex", "sci", "locale", "pixel", "string", "bool", "bool_yes_no", "bool_on_off", "bits", "bytes", "kbytes", "mbytes", "gbytes", "tbytes", "pbytes", "decbits", "decbytes", "deckbytes", "decmbytes", "decgbytes", "dectbytes", "decpbytes", "pps", "binBps", "Bps", "binbps", "bps", "KiBs", "Kibits", "KBs", "Kbits", "MiBs", "Mibits", "MBs", "Mbits", "GiBs", "Gibits", "GBs", "Gbits", "TiBs", "Tibits", "TBs", "Tbits", "cps", "ops", "reqps", "rps", "wps", "iops", "eps", "mps", "recps", "rowsps", "cpm", "opm", "rpm", "wpm", "hertz", "ns", "µs", "ms", "s", "m", "h", "d", "dtdurationms", "dtdurations", "dthms", "dtdhms", "timeticks", "clockms", "clocks", "dateTimeAsIso", "dateTimeAsIsoNoDateIfToday", "dateTimeAsUS", "dateTimeAsUSNoDateIfToday", "dateTimeAsLocal", "dateTimeAsLocalNoDateIfToday", "dateTimeAsSystem", "dateTimeFromNow", "watt", "kwatt", "mwatt", "watth", "kwatth", "joule", "amp", "mamp", "volt", "mvolt", "dBm", "celsius", "fahrenheit", "kelvin", "currencyUSD", "currencyEUR", "currencyGBP", "currencyJPY", "currencyINR", "lengthmm", "lengthm", "lengthkm", "massg", "masskg"] }
  }
}
