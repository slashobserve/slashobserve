{
  "specVersion": "0",
  "title": "Group by on a ClickHouse datasource variable",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "variables": [
    {
      "name": "source",
      "type": "datasource",
      "datasourceType": "clickhouse"
    },
    {
      "name": "groupby",
      "type": "groupby",
      "datasource": "${source}"
    }
  ],
  "panels": [
    {
      "id": "p_up",
      "type": "timeseries",
      "title": "Up",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": "${source}",
      "queries": [
        {
          "query": "SELECT 1"
        }
      ]
    }
  ]
}
