{
  "specVersion": "0",
  "title": "Minimal",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": "p1",
      "type": "stat",
      "title": "Log rows",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": "ch",
      "queries": [
        {
          "query": "SELECT count() FROM otel_logs WHERE ServiceName IN (${svc}) AND $__timeFilter(Timestamp)"
        }
      ]
    }
  ],
  "variables": [
    {
      "name": "svc",
      "type": "custom",
      "options": [
        "a",
        "b"
      ],
      "multi": true,
      "default": [
        "$__all",
        "a"
      ],
      "includeAll": true
    }
  ]
}
