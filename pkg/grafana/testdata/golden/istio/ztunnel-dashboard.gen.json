  "spec": {
    "specVersion": "0",
    "title": "Istio Ztunnel Dashboard",
    "time": {
      "from": "now-30m",
      "to": "now"
    },
    "refresh": "15s",
    "timezone": "utc",
    "cursorSync": "crosshair",
    "variables": [
      {
        "name": "datasource",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      }
    ],
    "panels": [
      {
        "id": "p1",
        "type": "row",
        "title": "Process",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p2",
            "type": "timeseries",
            "title": "Ztunnel Versions",
            "description": "Version number of each running instance",
            "gridPos": {
              "x": 0,
              "y": 1,
              "w": 8,
              "h": 8
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (tag) (istio_build{component=\"ztunnel\"})",
                "legend": "Version ({{tag}})"
              }
            ],
            "fill": 10,
            "interval": "5s",
            "display": {
              "legendValues": [
                "last",
                "max"
              ]
            }
          },
          {
            "id": "p3",
            "type": "timeseries",
            "title": "Memory Usage",
            "description": "Memory usage of each running instance",
            "gridPos": {
              "x": 8,
              "y": 1,
              "w": 8,
              "h": 8
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (pod) (container_memory_working_set_bytes{container=\"istio-proxy\",pod=~\"ztunnel-.*\"})",
                "legend": "Container ({{pod}})"
              }
            ],
            "unit": "bytes",
            "fill": 10,
            "interval": "5s",
            "display": {
              "legendValues": [
                "last",
                "max"
              ]
            }
          },
          {
            "id": "p4",
            "type": "timeseries",
            "title": "CPU Usage",
            "description": "CPU usage of each running instance",
            "gridPos": {
              "x": 16,
              "y": 1,
              "w": 8,
              "h": 8
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (pod) (irate(container_cpu_usage_seconds_total{container=\"istio-proxy\",pod=~\"ztunnel-.*\"}[$__rate_interval]))",
                "legend": "Container ({{pod}})"
              }
            ],
            "fill": 10,
            "interval": "5s",
            "display": {
              "legendValues": [
                "last",
                "max"
              ]
            }
          }
        ]
      },
      {
        "id": "p5",
        "type": "row",
        "title": "Network",
        "gridPos": {
          "x": 0,
          "y": 9,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p6",
            "type": "timeseries",
            "title": "Connections",
            "description": "Connections opened and closed per instance",
            "gridPos": {
              "x": 0,
              "y": 10,
              "w": 8,
              "h": 8
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (pod) (rate(istio_tcp_connections_opened_total{pod=~\"ztunnel-.*\"}[$__rate_interval]))",
                "legend": "Opened ({{pod}})"
              },
              {
                "query": "-sum by (pod) (rate(istio_tcp_connections_closed_total{pod=~\"ztunnel-.*\"}[$__rate_interval]))",
                "legend": "Closed ({{pod}})"
              }
            ],
            "unit": "cps",
            "fill": 10,
            "interval": "5s",
            "display": {
              "legendValues": [
                "last",
                "max"
              ]
            }
          },
          {
            "id": "p7",
            "type": "timeseries",
            "title": "Bytes Transmitted",
            "description": "Bytes sent and received per instance",
            "gridPos": {
              "x": 8,
              "y": 10,
              "w": 8,
              "h": 8
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (pod) (rate(istio_tcp_sent_bytes_total{pod=~\"ztunnel-.*\"}[$__rate_interval]))",
                "legend": "Sent ({{pod}})"
              },
              {
                "query": "sum by (pod) (rate(istio_tcp_received_bytes_total{pod=~\"ztunnel-.*\"}[$__rate_interval]))",
                "legend": "Received ({{pod}})"
              }
            ],
            "unit": "Bps",
            "fill": 10,
            "interval": "5s",
            "display": {
              "legendValues": [
                "last",
                "max"
              ]
            }
          },
          {
            "id": "p8",
            "type": "timeseries",
            "title": "DNS Request",
            "description": "DNS queries received per instance",
            "gridPos": {
              "x": 16,
              "y": 10,
              "w": 8,
              "h": 8
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (pod) (rate(istio_dns_requests_total{pod=~\"ztunnel-.*\"}[$__rate_interval]))",
                "legend": "Request ({{pod}})"
              }
            ],
            "fill": 10,
            "interval": "5s",
            "display": {
              "legendValues": [
                "last",
                "max"
              ]
            }
          }
        ]
      },
      {
        "id": "p9",
        "type": "row",
        "title": "Operations",
        "gridPos": {
          "x": 0,
          "y": 18,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p10",
            "type": "timeseries",
            "title": "XDS Connections",
            "description": "Count of XDS connection terminations.\nThis will typically spike every 30min for each instance.\n",
            "gridPos": {
              "x": 0,
              "y": 19,
              "w": 8,
              "h": 8
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (pod) (rate(istio_xds_connection_terminations_total{pod=~\"ztunnel-.*\"}[$__rate_interval]))",
                "legend": "XDS Connection Terminations ({{pod}})"
              }
            ],
            "fill": 10,
            "interval": "5s",
            "display": {
              "legendValues": [
                "last",
                "max"
              ]
            }
          },
          {
            "id": "p11",
            "type": "timeseries",
            "title": "XDS Pushes",
            "gridPos": {
              "x": 8,
              "y": 19,
              "w": 8,
              "h": 8
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (url) (irate(istio_xds_message_total{pod=~\"ztunnel-.*\"}[$__rate_interval]))",
                "legend": "{{url}}"
              }
            ],
            "unit": "ops",
            "style": "bars",
            "fill": 100,
            "stack": "normal",
            "overrides": [
              {
                "match": {
                  "series": "cds"
                },
                "displayName": "Clusters"
              },
              {
                "match": {
                  "series": "eds"
                },
                "displayName": "Endpoints"
              },
              {
                "match": {
                  "series": "lds"
                },
                "displayName": "Listeners"
              },
              {
                "match": {
                  "series": "rds"
                },
                "displayName": "Routes"
              },
              {
                "match": {
                  "series": "nds"
                },
                "displayName": "DNS Tables"
              },
              {
                "match": {
                  "series": "istio.io/debug"
                },
                "displayName": "Debug"
              },
              {
                "match": {
                  "series": "istio.io/debug/syncz"
                },
                "displayName": "Debug"
              },
              {
                "match": {
                  "series": "wads"
                },
                "displayName": "Authorization"
              },
              {
                "match": {
                  "series": "wds"
                },
                "displayName": "Workloads"
              },
              {
                "match": {
                  "series": "type.googleapis.com/istio.security.Authorization"
                },
                "displayName": "Authorizations"
              },
              {
                "match": {
                  "series": "type.googleapis.com/istio.workload.Address"
                },
                "displayName": "Addresses"
              }
            ],
            "interval": "15s"
          },
          {
            "id": "p12",
            "type": "timeseries",
            "title": "Workload Manager",
            "description": "Count of active and pending proxies managed by each instance.\nPending is expected to converge to zero.\n",
            "gridPos": {
              "x": 16,
              "y": 19,
              "w": 8,
              "h": 8
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (pod) (workload_manager_active_proxy_count{pod=~\"ztunnel-.*\"})",
                "legend": "Active Proxies ({{pod}})"
              },
              {
                "query": "sum by (pod) (workload_manager_pending_proxy_count{pod=~\"ztunnel-.*\"})",
                "legend": "Pending Proxies ({{pod}})"
              }
            ],
            "fill": 10,
            "interval": "5s",
            "display": {
              "legendValues": [
                "last",
                "max"
              ]
            }
          }
        ]
      },
      {
        "id": "p13",
        "type": "row",
        "title": "Network Resources",
        "gridPos": {
          "x": 0,
          "y": 27,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p14",
            "type": "timeseries",
            "title": "Resource Usage",
            "description": "Active TCP connections, open file descriptors, and open sockets per instance",
            "gridPos": {
              "x": 0,
              "y": 28,
              "w": 24,
              "h": 8
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (pod) (istio_tcp_connections_opened_total{app=\"ztunnel\"}) - sum by (pod) (istio_tcp_connections_closed_total{app=\"ztunnel\"})",
                "legend": "TCP Connections ({{pod}})"
              },
              {
                "query": "sum by (pod) (process_open_fds{app=\"ztunnel\"})",
                "legend": "Open File Descriptors ({{pod}})"
              },
              {
                "query": "sum by (pod) (istio_tcp_sockets_open{app=\"ztunnel\"})",
                "legend": "Open Sockets ({{pod}})"
              }
            ],
            "unit": "short",
            "decimals": 0,
            "fill": 10,
            "interval": "5s",
            "display": {
              "legendValues": [
                "last",
                "max"
              ]
            }
          }
        ]
      }
    ]
  }
}
