          "h": 7
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "sum(irate(redis_commands_duration_seconds_total{instance=~\"$instance\"}[1m])) by (cmd) != 0",
            "legend": "{{ cmd }}",
            "interval": "240s",
            "intervalFactor": 2
          }
        ],
        "unit": "s",
        "fill": 80,
        "stack": "normal",
        "display": {
