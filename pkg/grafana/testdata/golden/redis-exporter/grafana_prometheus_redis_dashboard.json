  "spec": {
    "specVersion": "0",
    "title": "Redis Dashboard for Prometheus Redis Exporter 1.x",
    "description": "Redis Dashboard for Prometheus Redis Exporter 1.x",
    "tags": [
      "prometheus",
      "redis"
    ],
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "cursorSync": "crosshair",
    "variables": [
      {
        "name": "DS_PROM",
        "label": "datasource",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": "prom",
        "query": "label_values(redis_up, namespace)",
        "sort": "alpha",
        "refresh": "timeRange"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": "prom",
        "query": "label_values(redis_up{namespace=~\"$namespace\"}, instance)",
        "sort": "alpha",
        "refresh": "timeRange",
        "multi": true
      }
    ],
    "panels": [
      {
        "id": "p9",
        "type": "stat",
        "title": "Max Uptime",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 3,
          "h": 7
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "max(max_over_time(redis_uptime_in_seconds{namespace=~\"$namespace\", instance=~\"$instance\"}[$__interval]))",
            "interval": "1800s",
            "intervalFactor": 2
          }
        ],
        "unit": "s",
        "decimals": 0,
        "thresholds": [
          {
            "color": "ok"
          },
          {
            "value": 80,
            "color": "critical"
          }
        ],
        "color": "#1f78c1",
        "mappings": [
          {
            "special": "null",
            "text": "N/A"
          }
        ],
        "maxDataPoints": 100,
        "display": {
          "colorMode": "none",
          "orientation": "horizontal"
        }
      },
      {
        "id": "p12",
        "type": "stat",
        "title": "Clients",
        "gridPos": {
          "x": 3,
          "y": 0,
          "w": 2,
          "h": 7
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "sum(redis_connected_clients{namespace=~\"$namespace\", instance=~\"$instance\"})",
            "interval": "2s",
            "intervalFactor": 2
          }
        ],
        "unit": "none",
        "decimals": 0,
        "thresholds": [
          {
            "color": "ok"
          },
          {
            "value": 80,
            "color": "critical"
          }
        ],
        "color": "#1f78c1",
        "mappings": [
          {
            "special": "null",
            "text": "N/A"
          }
        ],
        "timeFrom": "now-1m",
        "maxDataPoints": 100,
        "display": {
          "colorMode": "none",
          "orientation": "horizontal"
        }
      },
      {
        "id": "p11",
        "type": "gauge",
        "title": "Memory Usage",
        "gridPos": {
          "x": 5,
          "y": 0,
          "w": 3,
          "h": 7
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "sum(100 * (redis_memory_used_bytes{namespace=~\"$namespace\", instance=~\"$instance\"}  / redis_memory_max_bytes{namespace=~\"$namespace\", instance=~\"$instance\"}))",
            "interval": "2s",
            "intervalFactor": 2
          }
        ],
        "unit": "percent",
        "decimals": 0,
        "min": 0,
        "max": 100,
        "thresholds": [
          {
            "color": "#32ac2d"
          },
          {
            "value": 80,
            "color": "warning"
          },
          {
            "value": 95,
            "color": "#f53636"
          }
        ],
        "mappings": [
          {
            "special": "null",
            "text": "N/A"
          }
        ],
        "timeFrom": "now-1m",
        "maxDataPoints": 100
      },
      {
        "id": "p18",
        "type": "timeseries",
        "title": "Total Commands / sec",
        "gridPos": {
          "x": 8,
          "y": 0,
          "w": 8,
          "h": 7
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "sum(rate(redis_commands_total{namespace=~\"$namespace\", instance=~\"$instance\"} [1m])) by (cmd)",
            "legend": "{{ cmd }}",
            "interval": "240s",
            "intervalFactor": 2
          }
        ],
        "unit": "short",
        "fill": 80,
        "stack": "normal",
        "display": {
          "legend": "hidden",
          "tooltip": "all"
        }
      },
      {
        "id": "p1",
        "type": "timeseries",
        "title": "Hits / Misses per Sec",
        "gridPos": {
          "x": 16,
          "y": 0,
          "w": 8,
          "h": 7
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "irate(redis_keyspace_hits_total{instance=~\"$instance\"}[5m])",
            "legend": "hits, {{ instance }}",
            "interval": "240s",
            "intervalFactor": 2
          },
          {
            "query": "irate(redis_keyspace_misses_total{instance=~\"$instance\"}[5m])",
            "legend": "misses, {{ instance }}",
            "interval": "240s",
            "intervalFactor": 2
          }
        ],
        "unit": "short",
        "min": 0,
        "fill": 10,
        "display": {
          "legend": "hidden",
          "tooltip": "all"
        }
      },
      {
        "id": "p7",
        "type": "timeseries",
        "title": "Total Memory Usage",
        "gridPos": {
          "x": 0,
          "y": 7,
          "w": 12,
          "h": 7
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "redis_memory_used_bytes{instance=~\"$instance\"}",
            "legend": "used, {{ instance }}",
            "interval": "240s",
            "intervalFactor": 2
          },
          {
            "query": "redis_memory_max_bytes{instance=~\"$instance\"}",
            "legend": "max, {{ instance }}",
            "interval": "240s",
            "intervalFactor": 2
          }
        ],
        "unit": "bytes",
        "min": 0,
        "fill": 10,
        "overrides": [
          {
            "match": {
              "series": "max"
            },
            "color": "#BF1B00"
          }
        ],
        "display": {
          "tooltip": "all"
        }
      },
      {
        "id": "p10",
        "type": "timeseries",
        "title": "Network I/O",
        "gridPos": {
          "x": 12,
          "y": 7,
          "w": 12,
          "h": 7
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "sum(rate(redis_net_input_bytes_total{instance=~\"$instance\"}[5m]))",
            "legend": "{{ input }}",
            "interval": "240s",
            "intervalFactor": 2
          },
          {
            "query": "sum(rate(redis_net_output_bytes_total{instance=~\"$instance\"}[5m]))",
            "legend": "{{ output }}",
            "interval": "240s",
            "intervalFactor": 2
          }
        ],
        "unit": "bytes",
        "fill": 10,
        "display": {
          "tooltip": "all"
        }
      },
      {
        "id": "p5",
        "type": "timeseries",
        "title": "Total Items per DB",
        "gridPos": {
          "x": 0,
          "y": 14,
          "w": 12,
          "h": 7
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "sum (redis_db_keys{instance=~\"$instance\"}) by (db, instance)",
            "legend": "{{ db }}, {{ instance }}",
            "interval": "240s",
            "intervalFactor": 2
          }
        ],
        "unit": "short",
        "fill": 70,
        "stack": "normal",
        "display": {
          "legendValues": [
            "lastNotNull"
          ],
          "tooltip": "all"
        }
      },
      {
        "id": "p13",
        "type": "timeseries",
        "title": "Expiring vs Not-Expiring Keys",
        "gridPos": {
          "x": 12,
          "y": 14,
          "w": 12,
          "h": 7
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "sum (redis_db_keys{instance=~\"$instance\"}) by (instance) - sum (redis_db_keys_expiring{instance=~\"$instance\"}) by (instance)",
            "legend": "not expiring, {{ instance }}",
            "interval": "240s",
            "intervalFactor": 2
          },
          {
            "query": "sum (redis_db_keys_expiring{instance=~\"$instance\"}) by (instance)",
            "legend": "expiring, {{ instance }}",
            "interval": "240s",
            "intervalFactor": 2
          }
        ],
        "unit": "short",
        "fill": 70,
        "stack": "normal",
        "display": {
          "tooltip": "all"
        }
      },
      {
        "id": "p8",
        "type": "timeseries",
        "title": "Expired/Evicted Keys",
        "gridPos": {
          "x": 0,
          "y": 21,
          "w": 12,
          "h": 7
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "sum(rate(redis_expired_keys_total{instance=~\"$instance\"}[5m])) by (instance)",
            "legend": "expired, {{ instance }}",
            "interval": "240s",
            "intervalFactor": 2
          },
          {
            "query": "sum(rate(redis_evicted_keys_total{instance=~\"$instance\"}[5m])) by (instance)",
            "legend": "evicted, {{ instance }}",
            "interval": "240s",
            "intervalFactor": 2
          }
        ],
        "unit": "short",
        "fill": 10,
        "overrides": [
          {
            "match": {
              "series": "evicts"
            },
            "color": "#890F02"
          },
          {
            "match": {
              "series": "memcached_items_evicted_total{instance=\"172.17.0.1:9150\",job=\"prometheus\"}"
            },
            "color": "#890F02"
          },
          {
            "match": {
              "series": "reclaims"
            },
            "color": "#3F6833"
          }
        ],
        "display": {
          "tooltip": "all"
        }
      },
      {
        "id": "p16",
        "type": "timeseries",
        "title": "Connected/Blocked Clients",
        "gridPos": {
          "x": 12,
          "y": 21,
          "w": 12,
          "h": 7
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "sum(redis_connected_clients{instance=~\"$instance\"})",
            "legend": "connected"
          },
          {
            "query": "sum(redis_blocked_clients{instance=~\"$instance\"})",
            "legend": "blocked"
          }
        ],
        "unit": "short",
        "fill": 10,
        "display": {
          "tooltip": "all"
        }
      },
      {
        "id": "p20",
        "type": "timeseries",
        "title": "Average Time Spent by Command / sec",
        "gridPos": {
          "x": 0,
          "y": 28,
          "w": 12,
          "h": 7
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "sum(irate(redis_commands_duration_seconds_total{namespace=~\"$namespace\", instance =~ \"$instance\"}[1m])) by (cmd)\n  /\nsum(irate(redis_commands_total{namespace=~\"$namespace\", instance =~ \"$instance\"}[1m])) by (cmd)\n",
            "legend": "{{ cmd }}",
            "interval": "240s",
            "intervalFactor": 2
          }
        ],
        "unit": "s",
        "display": {
