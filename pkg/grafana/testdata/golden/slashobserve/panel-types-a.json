  "spec": {
    "specVersion": "0",
    "title": "Panel types A",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": "p1",
        "type": "barchart",
        "title": "Requests by pod",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "sum by (pod) (increase(http_requests_total[$__range]))",
            "legend": "{{pod}}",
            "instant": true,
            "format": "table"
          }
        ],
        "unit": "short",
        "fill": 80,
        "stack": "normal",
        "display": {
          "orientation": "horizontal",
          "showValues": "always",
          "xField": "pod",
          "barWidth": 0.6
        }
      },
      {
        "id": "p2",
        "type": "status-history",
        "title": "Service up",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "up",
            "legend": "{{job}}"
          }
        ],
        "thresholds": [
          {
            "color": "ok"
          },
          {
            "value": 80,
            "color": "critical"
          }
        ],
        "mappings": [
          {
            "value": "1",
            "text": "Up",
            "color": "ok"
          },
          {
            "value": "0",
            "text": "Down",
            "color": "critical"
          }
        ],
        "fill": 70,
        "display": {
          "showValues": "never"
        }
      },
      {
        "id": "p3",
        "type": "trend",
        "title": "Latency by payload size",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "datasource": "ch",
        "queries": [
          {
            "query": "SELECT toUInt32(length(Body) / 100) * 100 AS size, avg(length(Body)) AS avg_len FROM otel_logs WHERE $__timeFilter(Timestamp) GROUP BY size ORDER BY size",
            "format": "table"
          }
        ],
        "unit": "bytes",
        "thresholds": [
          {
            "color": "ok"
          },
          {
            "value": 80,
            "color": "critical"
          }
        ],
        "fill": 10,
        "thresholdsStyle": "line",
        "display": {
          "legend": "right",
          "tooltip": "all",
          "tooltipSort": "none",
          "xField": "size"
        }
      },
      {
        "id": "p4",
        "type": "xychart",
        "title": "Body length against severity",
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "datasource": "ch",
        "queries": [
          {
            "query": "SELECT SeverityNumber AS severity, length(Body) AS body_length FROM otel_logs WHERE $__timeFilter(Timestamp) LIMIT 500",
            "format": "table"
          }
        ],
        "fill": 50,
        "display": {
          "xField": "severity",
          "show": "points+lines",
          "pointSize": 6
        }
      },
      {
        "id": "p5",
        "type": "candlestick",
        "title": "Open file descriptors",
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 12,
          "h": 8
        },
        "datasource": "prom",
        "queries": [
          {
            "ref": "open",
            "query": "min_over_time(process_open_fds[5m])",
            "legend": "open"
          },
          {
            "ref": "high",
            "query": "max_over_time(process_open_fds[5m])",
            "legend": "high"
          },
          {
            "ref": "low",
            "query": "min_over_time(process_open_fds[5m])",
            "legend": "low"
          },
          {
            "ref": "close",
            "query": "process_open_fds",
            "legend": "close"
          }
        ],
        "thresholds": [
          {
            "color": "ok"
          },
          {
            "value": 80,
            "color": "critical"
          }
        ],
        "thresholdsStyle": "line",
        "display": {
          "tooltipSort": "none",
          "mode": "candles",
          "candleStyle": "ohlcbars",
          "colorStrategy": "close-close",
          "upColor": "info",
          "downColor": "warning",
          "open": "open",
          "high": "high",
          "low": "low",
          "close": "close"
        }
      },
      {
        "id": "p6",
        "type": "nodeGraph",
        "title": "Service map",
        "gridPos": {
          "x": 12,
          "y": 16,
          "w": 12,
          "h": 10
        },
        "datasource": "ch",
        "queries": [
          {
            "ref": "nodes",
            "query": "SELECT ServiceName AS id, ServiceName AS title, toString(count()) AS mainstat, toString(round(avg(Duration) / 1000000, 1)) AS secondarystat, (count() - countIf(StatusCode = 'Error')) / count() AS arc__success, countIf(StatusCode = 'Error') / count() AS arc__errors FROM otel_traces WHERE $__timeFilter(Timestamp) GROUP BY ServiceName LIMIT 30",
            "format": "table"
          },
          {
            "ref": "edges",
            "query": "SELECT concat(p.ServiceName, '-', c.ServiceName) AS id, p.ServiceName AS source, c.ServiceName AS target, count() AS mainstat FROM otel_traces AS c INNER JOIN otel_traces AS p ON c.ParentSpanId = p.SpanId AND c.TraceId = p.TraceId WHERE $__timeFilter(c.Timestamp) AND p.ServiceName != c.ServiceName GROUP BY source, target LIMIT 50",
            "format": "table"
          }
        ],
        "overrides": [
          {
            "match": {
              "field": "mainstat"
            },
            "unit": "ms"
          },
          {
            "match": {
              "field": "secondarystat"
            },
            "unit": "percentunit"
          },
          {
            "match": {
              "field": "arc__success"
            },
            "color": "#73BF69"
          },
          {
            "match": {
              "field": "arc__errors"
            },
            "color": "#F2495C"
          }
        ]
      },
      {
        "id": "p7",
        "type": "traces",
        "title": "Recent traces",
        "gridPos": {
          "x": 0,
          "y": 24,
          "w": 12,
          "h": 8
        },
        "datasource": "ch",
        "queries": [
          {
            "query": "SELECT TraceId, SpanId, ParentSpanId, SpanName, ServiceName, Timestamp, Duration FROM otel_traces WHERE $__timeFilter(Timestamp) ORDER BY Timestamp DESC LIMIT 200",
            "format": "table"
          }
        ]
      },
      {
        "id": "p8",
        "type": "flamegraph",
        "title": "CPU profile",
        "gridPos": {
          "x": 12,
          "y": 26,
          "w": 12,
          "h": 8
        },
        "datasource": "ch",
        "queries": [
          {
            "query": "SELECT stack AS label, 0 AS level, sum(samples) AS value, sum(samples) AS self FROM profiles WHERE $__timeFilter(Timestamp) GROUP BY stack",
            "format": "table"
          }
        ]
      },
      {
        "id": "p9",
        "type": "table",
        "title": "Inventory grid",
        "gridPos": {
          "x": 0,
          "y": 32,
          "w": 12,
          "h": 8
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "kube_pod_info",
            "legend": "__auto",
            "instant": true,
            "format": "table"
          }
        ]
      },
      {
        "id": "p10",
        "type": "logs",
        "title": "Recent logs",
        "gridPos": {
          "x": 12,
          "y": 34,
          "w": 12,
          "h": 8
        },
        "datasource": "ch",
        "queries": [
          {
            "query": "SELECT Timestamp AS timestamp, Body AS body, SeverityText AS level FROM otel_logs WHERE $__timeFilter(Timestamp) ORDER BY Timestamp DESC LIMIT 200",
            "format": "logs"
          }
        ],
        "display": {
          "wrap": true,
          "showTime": true,
          "order": "oldest"
        }
      },
      {
        "id": "p11",
        "type": "table",
        "title": "Logs as a table",
        "gridPos": {
          "x": 0,
          "y": 40,
          "w": 12,
          "h": 8
        },
        "datasource": "ch",
        "queries": [
          {
            "query": "SELECT Timestamp AS timestamp, Body AS body, SeverityText AS level FROM otel_logs WHERE $__timeFilter(Timestamp) ORDER BY Timestamp DESC LIMIT 200",
            "format": "logs"
          }
        ]
      },
      {
        "id": "p12",
        "type": "stat",
        "title": "Error ratio",
        "gridPos": {
          "x": 12,
          "y": 42,
          "w": 6,
          "h": 4
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "sum(rate(http_requests_total{code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m]))"
          }
        ],
        "unit": "percentunit",
        "decimals": 2,
        "thresholds": [
          {
            "color": "ok"
          },
          {
            "value": 0.01,
            "color": "warning"
          },
          {
            "value": 0.05,
            "color": "critical"
          }
        ],
        "mappings": [
