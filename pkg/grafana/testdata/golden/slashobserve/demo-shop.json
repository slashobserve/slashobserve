        "panels": [
          {
            "id": "p7",
            "type": "timeseries",
            "title": "Log volume by severity",
            "gridPos": {
              "x": 0,
              "y": 66,
              "w": 12,
              "h": 8
            },
            "datasource": "ch",
            "queries": [
              {
                "query": "SELECT $__timeInterval(Timestamp) AS time, SeverityText AS severity, count() AS n FROM otel_logs WHERE $__timeFilter(Timestamp) AND ServiceName IN (${service:singlequote}) GROUP BY time, severity ORDER BY time"
              }
            ],
            "unit": "short",
            "fill": 10,
            "thresholdsStyle": "off"
          },
          {
            "id": "p8",
            "type": "table",
            "title": "Slowest spans",
            "gridPos": {
              "x": 12,
              "y": 66,
              "w": 12,
              "h": 8
            },
            "datasource": "ch",
            "queries": [
              {
                "query": "SELECT SpanName AS span, quantile(0.99)(Duration) / 1e6 AS p99_ms, count() AS n FROM otel_traces WHERE $__timeFilter(Timestamp) GROUP BY span ORDER BY p99_ms DESC LIMIT 10",
                "format": "table"
              }
            ],
            "overrides": [
              {
                "match": {
                  "field": "p99_ms"
                },
                "unit": "ms"
              }
            ]
          },
          {
            "id": "p9",
            "type": "logs",
            "title": "Error logs",
            "gridPos": {
              "x": 0,
              "y": 74,
              "w": 12,
              "h": 8
            },
            "datasource": "ch",
            "queries": [
              {
                "query": "SELECT Timestamp, Body FROM otel_logs WHERE $__timeFilter(Timestamp) AND SeverityText = 'ERROR' ORDER BY Timestamp DESC LIMIT 100",
                "format": "logs"
              }
            ]
          },
          {
            "id": "p23",
            "type": "nodeGraph",
            "title": "Service map",
            "description": "Services with their request count and average latency; the ring shows the share of failed spans. Edges count calls between services.",
            "gridPos": {
              "x": 12,
              "y": 74,
              "w": 12,
              "h": 8
            },
            "datasource": "ch",
            "queries": [
              {
                "query": "SELECT ServiceName AS id, ServiceName AS title, count() AS mainstat, avg(Duration) / 1e6 AS secondarystat, 1 - countIf(StatusCode = 'Error') / count() AS arc__success, countIf(StatusCode = 'Error') / count() AS arc__errors FROM otel_traces WHERE $__timeFilter(Timestamp) AND SpanKind = 'Server' GROUP BY ServiceName",
                "format": "table"
              },
              {
                "query": "SELECT concat(p.ServiceName, ' -> ', c.ServiceName) AS id, p.ServiceName AS source, c.ServiceName AS target, count() AS mainstat FROM otel_traces AS c INNER JOIN otel_traces AS p ON c.ParentSpanId = p.SpanId AND c.TraceId = p.TraceId WHERE $__timeFilter(c.Timestamp) AND $__timeFilter(p.Timestamp) AND p.ServiceName != c.ServiceName GROUP BY source, target LIMIT 200",
                "format": "table"
              }
            ],
            "overrides": [
              {
                "match": {
                  "field": "mainstat"
                },
                "unit": "short"
              },
              {
                "match": {
                  "field": "secondarystat"
                },
                "unit": "ms"
              },
              {
                "match": {
                  "field": "arc__success"
                },
                "color": "#73BF69"
              },
              {
                "match": {
                  "field": "arc__errors"
                },
                "color": "#F2495C"
              }
            ]
          },
          {
            "id": "p22",
            "type": "traces",
            "title": "Slowest request in range",
            "description": "The span waterfall of the slowest request that started in the selected time range.",
            "gridPos": {
              "x": 0,
              "y": 82,
              "w": 12,
              "h": 9
            },
            "datasource": "ch",
            "queries": [
              {
                "query": "SELECT TraceId AS traceID, SpanId AS spanID, ParentSpanId AS parentSpanID, ServiceName AS serviceName, SpanName AS operationName, Timestamp AS startTime, Duration / 1000000 AS duration, StatusCode AS statusCode, SpanAttributes AS tags FROM otel_traces WHERE TraceId = (SELECT TraceId FROM otel_traces WHERE $__timeFilter(Timestamp) AND ParentSpanId = '' ORDER BY Duration DESC LIMIT 1) ORDER BY startTime LIMIT 1000",
                "format": "table"
              }
            ]
          },
          {
            "id": "p24",
            "type": "flamegraph",
            "title": "Where request time goes",
            "description": "Time spent in each service operation across the latest 300 requests; wider bars cost more.",
            "gridPos": {
              "x": 12,
              "y": 82,
              "w": 12,
              "h": 9
            },
            "datasource": "ch",
            "queries": [
              {
                "query": "WITH RECURSIVE spans AS ( SELECT TraceId, SpanId, ParentSpanId, concat(ServiceName, ' ', SpanName) AS name, Duration / 1e6 AS ms FROM otel_traces WHERE $__timeFilter(Timestamp) AND TraceId IN (SELECT TraceId FROM otel_traces WHERE $__timeFilter(Timestamp) AND ParentSpanId = '' ORDER BY Timestamp DESC LIMIT 300) ), tree AS ( SELECT TraceId, SpanId, ['all requests', name] AS path, ms FROM spans WHERE ParentSpanId = '' UNION ALL SELECT s.TraceId, s.SpanId, arrayPushBack(t.path, s.name), s.ms FROM spans AS s INNER JOIN tree AS t ON s.TraceId = t.TraceId AND s.ParentSpanId = t.SpanId ), paths AS ( SELECT path, sum(ms) AS value FROM tree GROUP BY path UNION ALL SELECT ['all requests'] AS root, sum(ms) AS root_ms FROM tree WHERE length(tree.path) = 2 ), children AS ( SELECT arrayPopBack(path) AS parent, sum(value) AS spent FROM paths GROUP BY parent ) SELECT length(p.path) - 1 AS level, round(p.value, 3) AS value, round(greatest(p.value - c.spent, 0), 3) AS self, p.path[-1] AS label FROM paths AS p LEFT JOIN children AS c ON p.path = c.parent ORDER BY p.path",
                "format": "table"
              }
            ],
            "unit": "ms"
          }
        ]
      },
