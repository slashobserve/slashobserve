  "spec": {
    "specVersion": "0",
    "title": "Demo shop (Grafana)",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "variables": [
      {
        "name": "service",
        "type": "custom",
        "options": [
          "frontend",
          "checkout",
          "payments"
        ],
        "multi": true,
        "includeAll": true,
        "allowCustomValue": true
      },
      {
        "name": "route",
        "type": "query",
        "datasource": "prom",
        "query": "label_values(http_requests_total{service=~\"$service\"}, route)",
        "refresh": "timeRange",
        "multi": true,
        "includeAll": true,
        "allowCustomValue": true
      }
    ],
    "panels": [
      {
        "id": "p1",
        "type": "row",
        "title": "Traffic",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p2",
            "type": "stat",
            "title": "Error ratio",
            "gridPos": {
              "x": 0,
              "y": 1,
              "w": 6,
              "h": 4
            },
            "datasource": "prom",
            "queries": [
              {
                "query": "sum(rate(http_requests_total{service=~\"$service\",status=~\"5..\"}[$__rate_interval])) / sum(rate(http_requests_total{service=~\"$service\"}[$__rate_interval]))",
                "legend": "__auto"
              }
            ],
            "unit": "percentunit",
            "thresholds": [
              {
                "color": "ok"
              },
              {
                "value": 0.01,
                "color": "warning"
              },
              {
                "value": 0.05,
                "color": "critical"
              }
            ],
            "display": {
              "wideLayout": true
            }
          },
          {
            "id": "p3",
            "type": "gauge",
            "title": "CPU busy",
            "gridPos": {
              "x": 6,
              "y": 1,
              "w": 6,
              "h": 4
            },
            "datasource": "prom",
            "queries": [
              {
                "query": "sum(rate(container_cpu_usage_seconds_total{service=~\"$service\"}[$__rate_interval]))",
                "legend": "__auto"
              }
            ],
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": [
              {
                "color": "ok"
              },
              {
                "value": 0.7,
                "color": "warning"
              },
              {
                "value": 0.9,
                "color": "critical"
              }
            ]
          },
          {
            "id": "p4",
            "type": "timeseries",
            "title": "Requests and errors by route",
            "gridPos": {
              "x": 12,
              "y": 1,
              "w": 12,
              "h": 8
            },
            "datasource": "prom",
            "queries": [
              {
                "query": "sum by (route) (rate(http_requests_total{service=~\"$service\",route=~\"$route\"}[$__rate_interval]))",
                "legend": "{{route}}"
              },
              {
                "query": "sum by (route) (rate(http_requests_total{service=~\"$service\",route=~\"$route\",status=~\"5..\"}[$__rate_interval]))",
                "legend": "{{route}} errors"
              }
            ],
            "unit": "reqps",
            "fill": 10,
            "thresholdsStyle": "off",
            "overrides": [
              {
                "match": {
                  "query": "B"
                },
                "color": "#F2495C",
                "lineStyle": "dashed"
              }
            ],
            "display": {
              "legend": "right",
              "legendValues": [
                "mean",
                "max"
              ]
            }
          },
          {
            "id": "p5",
            "type": "bargauge",
            "title": "p95 latency by service",
            "gridPos": {
              "x": 0,
              "y": 5,
              "w": 12,
              "h": 4
            },
            "datasource": "prom",
            "queries": [
              {
                "query": "histogram_quantile(0.95, sum by (service, le) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
                "legend": "{{service}}"
              }
            ],
            "unit": "s",
            "thresholds": [
              {
                "color": "ok"
              },
              {
                "value": 80,
                "color": "critical"
              }
            ],
            "display": {
              "orientation": "horizontal"
            }
          },
          {
            "id": "p10",
            "type": "barchart",
            "title": "Requests by pod",
            "gridPos": {
              "x": 0,
              "y": 9,
              "w": 12,
              "h": 8
            },
            "datasource": "prom",
            "queries": [
              {
                "query": "sum by (pod) (increase(http_requests_total[$__range]))",
                "legend": "{{pod}}",
                "instant": true
              }
            ],
            "fill": 80
          },
          {
            "id": "p12",
            "type": "piechart",
            "title": "Traffic share by service",
            "description": "Requests served by each service over the selected time range.",
            "gridPos": {
              "x": 12,
              "y": 9,
              "w": 12,
              "h": 8
            },
            "datasource": "prom",
            "queries": [
              {
                "query": "sum by (service) (increase(http_requests_total{service=~\"$service\"}[$__range]))",
                "legend": "{{service}}",
                "instant": true
              }
            ],
            "unit": "short",
            "display": {
              "legendMode": "table",
              "legendSortBy": "value",
              "legendSortDesc": true,
              "tooltip": "all",
              "tooltipSort": "desc",
              "pieType": "donut",
              "sliceLabels": [
                "percent"
              ]
            }
          }
        ]
      },
      {
        "id": "p29",
        "type": "row",
        "title": "Distributions",
        "gridPos": {
          "x": 0,
          "y": 17,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p13",
            "type": "heatmap",
            "title": "Request latency distribution",
            "description": "Request rate in each latency bucket over time; darker cells mean more requests.",
            "gridPos": {
              "x": 0,
              "y": 18,
              "w": 12,
              "h": 8
            },
            "datasource": "prom",
            "queries": [
              {
                "query": "sum by (le) (rate(http_request_duration_seconds_bucket{service=~\"$service\",route=~\"$route\"}[$__rate_interval]))",
                "legend": "{{le}}",
                "format": "heatmap"
              }
            ],
            "unit": "s",
            "display": {
              "colorMode": "scheme",
              "colorScheme": "oranges",
              "colorSteps": 64,
              "cellGap": 1,
              "showValues": "auto"
            }
          },
          {
            "id": "p14",
            "type": "histogram",
            "title": "How often p95 latency lands in each band",
            "description": "Every sampled p95 latency in the time range, counted into 20 equal bands.",
            "gridPos": {
              "x": 12,
              "y": 18,
              "w": 12,
              "h": 8
            },
            "datasource": "prom",
            "queries": [
              {
                "query": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=~\"$service\",route=~\"$route\"}[$__rate_interval])))",
                "legend": "p95"
              }
            ],
            "unit": "s",
            "fill": 80,
            "display": {
              "bucketCount": 20
            }
          },
          {
            "id": "p15",
            "type": "trend",
            "title": "Latency by percentile and service",
            "description": "Server span latency at the 50th to 99th percentile for each service.",
            "gridPos": {
              "x": 0,
              "y": 26,
              "w": 12,
              "h": 8
            },
            "datasource": "ch",
            "queries": [
              {
                "query": "SELECT t.1 AS percentile, t.2 / 1e6 AS frontend, t.3 / 1e6 AS checkout, t.4 / 1e6 AS payments FROM ( SELECT arrayJoin(arrayZip([50, 75, 90, 95, 99], quantilesIf(0.5, 0.75, 0.9, 0.95, 0.99)(Duration, ServiceName = 'frontend'), quantilesIf(0.5, 0.75, 0.9, 0.95, 0.99)(Duration, ServiceName = 'checkout'), quantilesIf(0.5, 0.75, 0.9, 0.95, 0.99)(Duration, ServiceName = 'payments'))) AS t FROM otel_traces WHERE $__timeFilter(Timestamp) AND SpanKind = 'Server' ) ORDER BY percentile",
                "format": "table"
              }
            ],
            "unit": "ms",
            "fill": 10,
            "thresholdsStyle": "off",
            "display": {
              "tooltip": "all",
              "tooltipSort": "none",
              "xField": "percentile"
            }
          },
          {
            "id": "p16",
            "type": "xychart",
            "title": "Card authorization against checkout time",
            "description": "One point per trace: how long the payment took against how long the whole checkout took.",
            "gridPos": {
              "x": 12,
              "y": 26,
              "w": 12,
              "h": 8
            },
            "datasource": "ch",
            "queries": [
              {
                "query": "SELECT sumIf(Duration, SpanName = 'authorize_card') / 1e6 AS authorize_ms, sumIf(Duration, SpanName = 'POST /api/checkout') / 1e6 AS checkout_ms FROM otel_traces WHERE $__timeFilter(Timestamp) AND SpanName IN ('authorize_card', 'POST /api/checkout') GROUP BY TraceId HAVING authorize_ms > 0 AND checkout_ms > 0 LIMIT 500",
                "format": "table"
              }
            ],
            "unit": "ms",
            "fill": 50,
            "display": {
              "xField": "authorize_ms"
            }
          },
          {
            "id": "p17",
            "type": "candlestick",
            "title": "Checkout latency per 5 minutes",
            "description": "First, highest, lowest and last POST /checkout latency in each 5 minute window, with the request count as volume.",
            "gridPos": {
              "x": 0,
              "y": 34,
              "w": 24,
              "h": 8
            },
            "datasource": "ch",
            "queries": [
              {
                "query": "SELECT $__timeInterval(Timestamp) AS time, argMin(Duration, Timestamp) / 1e6 AS open, max(Duration) / 1e6 AS high, min(Duration) / 1e6 AS low, argMax(Duration, Timestamp) / 1e6 AS close, count() AS volume FROM otel_traces WHERE $__timeFilter(Timestamp) AND ServiceName = 'checkout' AND SpanName = 'POST /checkout' GROUP BY time ORDER BY time"
              }
            ],
            "unit": "ms",
            "fill": 10,
            "thresholdsStyle": "off",
            "overrides": [
              {
                "match": {
                  "series": "volume"
                },
                "unit": "short"
              }
            ],
            "interval": "5m",
            "display": {
              "tooltipSort": "none",
              "open": "open",
              "high": "high",
              "low": "low",
              "close": "close",
              "volume": "volume"
            }
          }
        ]
      },
      {
