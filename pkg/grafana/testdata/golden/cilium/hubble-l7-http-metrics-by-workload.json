                "query": "sum(\n    node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{cluster=~\"${cluster}\", namespace=~\"${destination_namespace}\"}\n  * on(namespace,pod)\n    group_left(workload, workload_type) namespace_workload_pod:kube_pod_owner:relabel{cluster=~\"${cluster}\", namespace=~\"${destination_namespace}\", workload=\"${destination_workload}\"}\n) by (namespace, workload)",
                "legend": "{{ cluster }} {{ namespace }}/{{ workload }}"
              }
            ],
            "unit": "none",
            "min": 0,
            "display": {
              "legendValues": [
                "min",
                "max",
                "mean",
                "lastNotNull"
              ]
            }
          }
        ]
      }
    ]
  }
}
