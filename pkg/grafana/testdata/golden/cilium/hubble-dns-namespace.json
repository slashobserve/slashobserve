    "panels": [
      {
        "id": "p2",
        "type": "row",
        "title": "DNS",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p37",
            "type": "timeseries",
            "title": "DNS queries",
            "gridPos": {
              "x": 0,
              "y": 1,
              "w": 12,
              "h": 9
            },
            "datasource": "prom",
            "queries": [
              {
                "query": "sum(rate(hubble_dns_queries_total{cluster=~\"$cluster\", source_namespace=~\"$source_namespace\", destination_namespace=~\"$destination_namespace\"}[$__rate_interval])) by (source) > 0",
                "legend": "{{source}}"
              }
            ],
            "unit": "reqps",
            "min": 0,
            "fill": 10,
            "stack": "normal",
            "display": {
              "legendValues": [
                "mean",
                "lastNotNull"
              ]
            }
          },
          {
            "id": "p41",
            "type": "bargauge",
            "title": "Top 10 DNS queries",
            "gridPos": {
              "x": 12,
              "y": 1,
              "w": 12,
              "h": 9
            },
            "datasource": "prom",
            "queries": [
              {
                "query": "topk(10, sum(rate(hubble_dns_queries_total{cluster=~\"$cluster\", source_namespace=~\"$source_namespace\", destination_namespace=~\"$destination_namespace\"}[$__rate_interval])*60) by (query))",
                "legend": "{{query}}"
              }
            ],
            "unit": "reqps",
            "min": 0,
            "thresholds": [
              {
                "color": "ok"
              }
            ],
            "display": {
              "orientation": "horizontal"
            }
          },
          {
            "id": "p39",
            "type": "timeseries",
            "title": "Missing DNS responses",
            "gridPos": {
              "x": 0,
              "y": 10,
              "w": 12,
              "h": 9
            },
            "datasource": "prom",
            "queries": [
              {
                "query": "round(sum(rate(hubble_dns_queries_total{cluster=~\"$cluster\", source_namespace=~\"$source_namespace\", destination_namespace=~\"$destination_namespace\"}[$__rate_interval])) by (source) - sum(label_replace(sum(rate(hubble_dns_responses_total{cluster=~\"$cluster\", source_namespace=~\"$destination_namespace\", destination_namespace=~\"$source_namespace\"}[$__rate_interval])) by (destination), \"source\", \"$1\", \"destination\", \"(.*)\")) without (destination), 0.001) > 0",
                "legend": "{{source}}"
              }
            ],
            "unit": "reqps",
            "min": 0,
            "fill": 10,
            "stack": "normal",
            "display": {
              "legendValues": [
                "mean",
                "lastNotNull"
              ]
            }
          },
          {
            "id": "p43",
            "type": "timeseries",
            "title": "DNS errors",
            "gridPos": {
              "x": 12,
              "y": 10,
              "w": 12,
              "h": 9
            },
            "datasource": "prom",
            "queries": [
              {
                "query": "sum(rate(hubble_dns_responses_total{cluster=~\"$cluster\", source_namespace=~\"$destination_namespace\", destination_namespace=~\"$source_namespace\", rcode!=\"No Error\"}[$__rate_interval])) by (destination, rcode) > 0",
                "legend": "{{destination}}: {{rcode}}"
              }
            ],
            "unit": "reqps",
            "min": 0,
            "fill": 10,
            "stack": "normal",
            "display": {
              "legendValues": [
                "mean",
                "lastNotNull"
              ]
            }
          }
        ]
      }
    ]
