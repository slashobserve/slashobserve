        "datasource": "ch",
        "queries": [
          {
            "query": "SELECT $__timeInterval(EventTime) as time, Name, sum(Value) \r\nFROM default.test_alerts \r\nWHERE $__timeFilter(EventTime) \r\nAND Name IN (${service_name})\r\nGROUP BY Name, time \r\nORDER BY time ASC"
