        "queries": [
          {
            "query": "SELECT $__timeInterval(EventTime) as \"time\", EventTime, sum(Value) FROM \"default\".\"test_alerts\" GROUP BY EventTime, time ORDER BY EventTime ASC LIMIT 1000"
