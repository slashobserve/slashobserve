  "spec": {
    "specVersion": "0",
    "title": "VictoriaMetrics Cluster Per Tenant Statistic",
    "description": "Overview for enterprise cluster VictoriaMetrics v1.56.0 or higher",
    "tags": [
      "victoriametrics"
    ],
    "time": {
      "from": "now-30m",
      "to": "now"
    },
    "cursorSync": "crosshair",
    "variables": [
      {
        "name": "ds",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "account",
        "type": "query",
        "datasource": "${ds}",
        "query": "label_values(vm_tenant_active_timeseries, accountID)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "adhoc",
        "type": "adhoc",
        "datasource": "prom"
      }
    ],
    "links": [
      {
        "title": "Docs",
        "url": "https://docs.victoriametrics.com/victoriametrics/pertenantstatistic/",
        "newTab": true
      },
      {
        "title": "Community support",
        "url": "https://victoriametrics.com/support/community-support/",
        "newTab": true
      },
      {
        "title": "Enterprise support",
        "url": "https://victoriametrics.com/support/enterprise-support/",
        "newTab": true
      }
    ],
    "panels": [
      {
        "id": "p12",
        "type": "row",
        "title": "Statistic",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p2",
            "type": "placeholder",
            "title": "Datapoints ingestion rate",
            "description": "How many datapoints are inserted into storage per second by accountID and projectID",
            "gridPos": {
              "x": 0,
              "y": 1,
              "w": 12,
              "h": 8
            },
            "reason": "It uses variable project, which could not be imported.",
            "sourceType": "timeseries"
          },
          {
            "id": "p4",
            "type": "placeholder",
            "title": "Read query rate",
            "description": "Request rate accepted by vmselect nodes per tenant",
            "gridPos": {
              "x": 12,
              "y": 1,
              "w": 12,
              "h": 8
            },
            "reason": "It uses variable project, which could not be imported.",
            "sourceType": "timeseries"
          },
          {
            "id": "p6",
            "type": "placeholder",
            "title": "Active time series",
            "description": "Shows the number of active time series with new data points inserted during the last hour. High value may result in ingestion slowdown. \n\nSee following link for details:",
            "gridPos": {
              "x": 0,
              "y": 9,
              "w": 12,
              "h": 8
            },
            "reason": "It uses variable project, which could not be imported.",
            "sourceType": "timeseries"
          },
          {
            "id": "p31",
            "type": "placeholder",
            "title": "Time spent on queries, seconds",
            "description": "Time spent on query execution per tenant per second",
            "gridPos": {
              "x": 12,
              "y": 9,
              "w": 12,
              "h": 8
            },
            "reason": "It uses variable project, which could not be imported.",
            "sourceType": "timeseries"
          },
          {
            "id": "p10",
            "type": "placeholder",
            "title": "Disk space usage (datapoints only)",
            "description": "Shows the amount of on-disk space occupied by data points only. The disk space is used for storing by datapoint and indexdb. There is no option to expose per tenant statistic for indexdb. Usually, indexed takes much less space compared to datapoints. But with a high churn rate, the size of the indexdb could grow significantly.",
            "gridPos": {
              "x": 0,
              "y": 17,
              "w": 12,
              "h": 8
            },
            "reason": "It uses variable project, which could not be imported.",
            "sourceType": "timeseries"
          },
          {
            "id": "p19",
            "type": "placeholder",
            "title": "New series over 24h",
            "description": "Number of new series created over last 24h.",
            "gridPos": {
              "x": 12,
              "y": 17,
              "w": 12,
              "h": 8
            },
            "reason": "It uses variable project, which could not be imported.",
            "sourceType": "timeseries"
          },
          {
            "id": "p34",
            "type": "placeholder",
            "title": "Instant Churn Rate",
            "description": "The higher churn rate is, the more resources required to handle it. Consider to keep the churn rate as low as possible.\n\nTo investigate stats about most expensive series use `api/v1/status/tsdb` handler. More details here https://docs.victoriametrics.com/victoriametrics/cluster-victoriametrics/#url-format\n\nGood references to read:\n* https://www.robustperception.io/cardinality-is-key\n* https://valyala.medium.com/high-cardinality-tsdb-benchmarks-victoriametrics-vs-timescaledb-vs-influxdb-13e6ee64dd6b",
            "gridPos": {
              "x": 12,
              "y": 25,
              "w": 12,
              "h": 8
            },
            "reason": "It uses variable project, which could not be imported.",
            "sourceType": "timeseries"
          }
        ]
      },
      {
        "id": "p14",
        "type": "row",
        "title": "Billing",
        "gridPos": {
          "x": 0,
          "y": 33,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p16",
            "type": "piechart",
            "title": "Ingestion Rate Top 5, by account id",
            "gridPos": {
              "x": 0,
              "y": 34,
              "w": 4,
              "h": 14
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "topk_last(5, sum(rate(vm_tenant_inserted_rows_total{accountID=~\"$account\"}[$__range])) by (accountID), \"accountID=other\") ",
                "legend": "{{accountID}}"
              }
            ],
            "unit": "short",
            "display": {
              "legend": "bottom"
            }
          },
          {
            "id": "p18",
            "type": "piechart",
            "title": "Read query rate, Top 5, by account id",
            "gridPos": {
              "x": 4,
              "y": 34,
              "w": 4,
              "h": 14
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "topk_last(5, sum(rate(vm_tenant_select_requests_total{accountID=~\"$account\"}[$__rate_interval])) by (accountID), \"accountID=other\") ",
                "legend": "__auto"
              }
            ],
            "unit": "none",
            "display": {
              "legend": "bottom"
            }
          },
          {
            "id": "p32",
            "type": "piechart",
            "title": "Time spent on queries, seconds, Top 5, by account id",
            "gridPos": {
              "x": 8,
              "y": 34,
              "w": 4,
              "h": 14
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "topk_last(5, sum(rate(vm_tenant_select_requests_duration_ms_total{accountID=~\"$account\"}[$__range])) by (accountID) /1000, \"accountID=other\") ",
                "legend": "__auto"
              }
            ],
            "unit": "none",
            "display": {
              "legend": "bottom"
            }
          },
          {
            "id": "p21",
            "type": "piechart",
            "title": "Active time series, Top 5, by account id",
            "gridPos": {
              "x": 12,
              "y": 34,
              "w": 4,
              "h": 14
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "topk_last(5, sum(vm_tenant_active_timeseries{accountID=~\"$account\"}) by(accountID), \"accountID=other\") ",
                "legend": "__auto"
              }
            ],
            "unit": "short",
            "display": {
              "legend": "bottom"
            }
          },
          {
            "id": "p22",
            "type": "piechart",
            "title": "Disk space usage, Top 5, by account id",
            "gridPos": {
              "x": 16,
              "y": 34,
              "w": 4,
              "h": 14
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "topk_last(5, sum(vm_tenant_used_tenant_bytes{accountID=~\"$account\"}) by(accountID), \"accountID=other\") ",
                "legend": "__auto"
              }
            ],
            "unit": "bytes",
            "display": {
              "legend": "bottom"
            }
          },
          {
            "id": "p24",
            "type": "piechart",
            "title": "New series over 24h, Top 5, by account id",
