  "spec": {
    "specVersion": "0",
    "title": "VictoriaMetrics - backupmanager",
    "description": "Overview for VictoriaMetrics backupmanager v1.85.3 or higher",
    "tags": [
      "victoriametrics"
    ],
    "time": {
      "from": "now-7d",
      "to": "now"
    },
    "refresh": "1m",
    "variables": [
      {
        "name": "ds",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": "${ds}",
        "query": "label_values(vm_app_version{version=~\"^vmbackupmanager.*\"}, job)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": "${ds}",
        "query": "label_values(vm_app_version{job=~\"$job\"}, instance)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "adhoc",
        "type": "adhoc",
        "datasource": "${ds}"
      }
    ],
    "links": [
      {
        "title": "Docs",
        "url": "https://docs.victoriametrics.com/victoriametrics/vmbackupmanager/",
        "newTab": true
      },
      {
        "title": "Community support",
        "url": "https://victoriametrics.com/support/community-support/",
        "newTab": true
      },
      {
        "title": "Enterprise support",
        "url": "https://victoriametrics.com/support/enterprise-support/",
        "newTab": true
      }
    ],
    "panels": [
      {
        "id": "p10",
        "type": "row",
        "title": "Stats",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p32",
            "type": "stat",
            "title": "Instances",
            "gridPos": {
              "x": 0,
              "y": 1,
              "w": 3,
              "h": 5
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "count(vm_app_version{job=~\"$job\", instance=~\"$instance\", version=~\"^vmbackupmanager.+\" })",
                "legend": "__auto",
                "instant": true
              }
            ],
            "thresholds": [
              {
                "color": "ok"
              }
            ]
          },
          {
            "id": "p2",
            "type": "stat",
            "title": "Last backup status",
            "description": "Status of last backup operation.",
            "gridPos": {
              "x": 3,
              "y": 1,
              "w": 4,
              "h": 5
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(vm_backup_last_run_failed)",
                "legend": "__auto"
              }
            ],
            "min": 0,
            "thresholds": [
              {
                "color": "ok"
              }
            ],
            "mappings": [
              {
                "value": "0",
                "text": "Success"
              }
            ]
          },
          {
            "id": "p6",
            "type": "stat",
            "title": "Total backups stored",
            "description": "Number of backups stored in remote storage.",
            "gridPos": {
              "x": 7,
              "y": 1,
              "w": 3,
              "h": 5
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(vm_backups_stored{job=~\"$job\", instance=~\"$instance\"})",
                "legend": "__auto"
              }
            ],
            "min": 0,
            "thresholds": [
              {
                "color": "ok"
              }
            ]
          },
          {
            "id": "p27",
            "type": "stat",
            "title": "Backups size",
            "description": "Space used in remote storage.",
            "gridPos": {
              "x": 10,
              "y": 1,
              "w": 3,
              "h": 5
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(vm_backups_size_bytes{job=~\"$job\", instance=~\"$instance\"})",
                "legend": "__auto"
              }
            ],
            "unit": "decbytes",
            "min": 0,
            "thresholds": [
              {
                "color": "ok"
              }
            ]
          },
          {
            "id": "p7",
            "type": "stat",
            "title": "Backups errors",
            "gridPos": {
              "x": 13,
              "y": 1,
              "w": 3,
              "h": 5
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(increase(vm_backup_errors_total{job=~\"$job\", instance=~\"$instance\"}[$__range]))",
                "legend": "__auto"
              }
            ],
            "min": 0,
            "thresholds": [
              {
                "color": "ok"
              },
              {
                "value": 1,
                "color": "critical"
              }
            ],
            "mappings": [
              {
                "value": "0",
                "text": "No errors"
              }
            ]
          },
          {
            "id": "p5",
            "type": "stat",
            "title": "Last retention status",
            "description": "Status of last retention run.\n\nRetention is a process of removing old backups from remote storage.",
            "gridPos": {
              "x": 16,
              "y": 1,
              "w": 4,
              "h": 5
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(vm_retention_last_run_failed)",
                "legend": "__auto"
              }
            ],
            "min": 0,
            "thresholds": [
              {
                "color": "ok"
              }
            ],
            "mappings": [
              {
                "value": "0",
                "text": "Success"
              }
            ]
          },
          {
            "id": "p8",
            "type": "stat",
            "title": "Retention errors",
            "gridPos": {
              "x": 20,
              "y": 1,
              "w": 4,
              "h": 5
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(increase(vm_retention_errors_total{job=~\"$job\", instance=~\"$instance\"}[$__range]))",
                "legend": "__auto"
              }
            ],
            "min": 0,
            "thresholds": [
              {
                "color": "ok"
              },
              {
                "value": 1,
                "color": "critical"
              }
            ],
            "mappings": [
              {
                "value": "0",
                "text": "No errors"
              }
            ]
          },
          {
            "id": "p22",
            "type": "table",
            "title": "Backups configuration",
            "gridPos": {
              "x": 0,
              "y": 6,
              "w": 12,
              "h": 6
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(flag{job=~\"$job\", instance=~\"$instance\",name=~\"disableDaily|disableHourly|disableWeekly|disableMonthly\"}) by (name, value, instance)",
                "instant": true,
                "format": "table"
              }
            ]
          },
          {
            "id": "p21",
            "type": "table",
            "title": "Retention configuration",
            "gridPos": {
              "x": 12,
              "y": 6,
              "w": 12,
              "h": 6
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(flag{job=~\"$job\", instance=~\"$instance\",name=~\"keep(.*)\", is_set=\"true\"}) by (name, value, instance)",
                "instant": true,
                "format": "table"
              }
            ]
          }
        ]
      },
      {
        "id": "p12",
        "type": "row",
        "title": "Backups",
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 24,
          "h": 1
        },
        "collapsed": true,
        "panels": [
          {
            "id": "p23",
            "type": "barchart",
            "title": "Max backup duration",
            "description": "Max duration of backup run. Lower better.\n\nEach backup starts with data upload during `latest` backup. Subsequent backups (`hourly`, `daily`, `weekly`, `monthly`)  are copying date by using server-side copy. ",
            "gridPos": {
              "x": 0,
              "y": 13,
              "w": 12,
              "h": 8
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "max(increase(vm_backup_duration_seconds_total{job=~\"$job\", instance=~\"$instance\"})) by (type) > 0",
                "legend": "__auto"
              }
            ],
            "unit": "s",
            "links": [
              {
                "title": "Drilldown",
                "url": "/d/gF-lxRdVz?viewPanel=36&var-ds=$ds&var-instance=$instance&var-job=$job&${__url_time_range}",
                "newTab": true
              }
            ],
            "fill": 80,
            "interval": "1h",
            "display": {
              "legend": "hidden"
            }
          },
          {
            "id": "p16",
            "type": "timeseries",
            "title": "Backup errors",
            "gridPos": {
              "x": 12,
              "y": 13,
              "w": 12,
              "h": 8
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(increase(vm_backup_errors_total{job=~\"$job\", instance=~\"$instance\"})[$__interval]) by (instance) > 0",
                "legend": "{{instance}}"
              }
            ]
          },
          {
            "id": "p29",
            "type": "timeseries",
            "title": "Backups size",
            "gridPos": {
              "x": 0,
              "y": 21,
              "w": 12,
              "h": 8
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "vm_backups_size_bytes{job=~\"$job\", instance=~\"$instance\"}",
                "legend": "__auto"
              }
            ],
            "unit": "decbytes",
            "display": {
              "legend": "hidden"
            }
          },
          {
            "id": "p28",
            "type": "table",
            "title": "Top 10 backups by size",
            "gridPos": {
              "x": 12,
              "y": 21,
              "w": 12,
              "h": 8
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "topk(10, sum(vm_backups_size_bytes{job=~\"$job\", instance=~\"$instance\"}) by (backup, job, type))",
                "legend": "__auto",
                "instant": true,
                "format": "table"
              }
            ],
            "unit": "decbytes"
          },
          {
            "id": "p30",
            "type": "barchart",
            "title": "Backup runs",
            "gridPos": {
              "x": 0,
              "y": 29,
              "w": 12,
              "h": 8
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(increase(vm_backups_total{job=~\"$job\", instance=~\"$instance\"}[24h])) by (type) > 0",
                "legend": "__auto"
              }
            ],
            "unit": "none",
            "fill": 80,
            "stack": "normal",
            "interval": "1d",
            "display": {
              "groupWidth": 0.85
            }
          },
          {
            "id": "p31",
            "type": "timeseries",
            "title": "Backups upload speed",
            "gridPos": {
              "x": 12,
              "y": 29,
              "w": 12,
              "h": 8
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(rollup_rate(vm_backups_uploaded_bytes_total[$__rate_interval])) by (rollup)",
                "legend": "__auto"
              }
            ],
            "unit": "binBps",
            "display": {
              "legend": "hidden",
              "legendValues": [
                "max",
                "mean"
              ],
              "legendMode": "list"
            }
          }
