  "spec": {
    "specVersion": "0",
    "title": "VictoriaMetrics - operator",
    "description": "Overview for operator VictoriaMetrics v0.25.0 or higher",
    "tags": [
      "victoriametrics"
    ],
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "variables": [
      {
        "name": "ds",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": "${ds}",
        "query": "label_values(operator_log_messages_total,job)",
        "refresh": "timeRange",
        "allowCustomValue": true
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": "${ds}",
        "query": "label_values(operator_log_messages_total{job=~\"$job\"},instance)",
        "refresh": "timeRange",
        "includeAll": true,
        "allowCustomValue": true
      },
      {
        "name": "version",
        "hide": "variable",
        "type": "query",
        "datasource": "${ds}",
        "query": "label_values(vm_app_version{job=\"$job\", instance=\"$instance\"},  version)",
        "sort": "alphaDesc",
        "allowCustomValue": true
      },
      {
        "name": "adhoc",
        "type": "adhoc",
        "datasource": "${ds}"
      }
    ],
    "links": [
      {
        "title": "Docs",
        "url": "https://docs.victoriametrics.com/operator/",
        "newTab": true
      },
      {
        "title": "Community support",
        "url": "https://victoriametrics.com/support/community-support/",
        "newTab": true
      },
      {
        "title": "Enterprise support",
        "url": "https://victoriametrics.com/support/enterprise-support/",
        "newTab": true
      },
      {
        "title": "Releases",
        "url": "https://github.com/VictoriaMetrics/operator/releases",
        "newTab": true
      }
    ],
    "panels": [
      {
        "id": "p8",
        "type": "row",
        "title": "Overview",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p24",
            "type": "stat",
            "title": "Version",
            "gridPos": {
              "x": 0,
              "y": 1,
              "w": 4,
              "h": 3
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum by(job, version) (label_replace(vm_app_version{job=~\"$job\", instance=~\"$instance\", short_version!=\"\"}, \"version\", \"$1\", \"short_version\", \"(.*)\") or vm_app_version{job=~\"$job\", instance=~\"$instance\", short_version=\"\"})",
                "instant": true,
                "format": "table"
              }
            ],
            "thresholds": [
              {
                "color": "ok"
              }
            ],
            "display": {
              "fields": "/^version$/",
              "graph": false,
              "textMode": "value",
              "wideLayout": true
            }
          },
          {
            "id": "p14",
            "type": "stat",
            "title": "CRD Objects count by controller",
            "description": "Number of objects at kubernetes cluster per each controller",
            "gridPos": {
              "x": 4,
              "y": 1,
              "w": 20,
              "h": 7
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "max(operator_controller_objects_count{job=~\"$job\",instance=~\"$instance\"}) by (controller)",
                "legend": "{{controller}}"
              }
            ],
            "min": 0,
            "thresholds": [
              {
                "color": "ok"
              },
              {
                "value": 80,
                "color": "critical"
              }
            ],
            "display": {
              "colorMode": "none",
              "wideLayout": true
            }
          },
          {
            "id": "p22",
            "type": "stat",
            "title": "Uptime",
            "gridPos": {
              "x": 0,
              "y": 4,
              "w": 4,
              "h": 4
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "vm_app_uptime_seconds{job=~\"$job\",instance=~\"$instance\"}",
                "legend": "{{instance}}",
                "instant": true,
                "format": "table"
              }
            ],
            "unit": "s",
            "thresholds": [
              {
                "color": "ok"
              },
              {
                "value": 80,
                "color": "critical"
              }
            ],
            "display": {
              "wideLayout": true
            }
          },
          {
            "id": "p39",
            "type": "stat",
            "title": "Prometheus Objects watchers",
            "description": " Shows per namespace watchers for Prometheus Operator objects (ServiceMonitors, PodMonitors, etc) ",
            "gridPos": {
              "x": 0,
              "y": 8,
              "w": 4,
              "h": 5
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(operator_prometheus_converter_active_watchers)",
                "legend": "__auto"
              }
            ],
            "min": 0,
            "thresholds": [
              {
                "color": "ok"
              },
              {
                "value": 80,
                "color": "critical"
              }
            ],
            "display": {
              "wideLayout": true
            }
          },
          {
            "id": "p40",
            "type": "stat",
            "title": "Elected Leaders",
            "description": " Number of operator instances with obtained leader status. \n Value above 1 indicates that instances with the same job may behave incorrectly.\n It's recommend to check Operator logs. ",
            "gridPos": {
              "x": 4,
              "y": 8,
              "w": 4,
              "h": 5
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(leader_election_master_status{job=~\"$job\"})",
                "legend": "__auto"
              }
            ],
            "min": 0,
            "thresholds": [
              {
                "color": "ok"
              },
              {
                "value": 80,
                "color": "critical"
              }
            ],
            "display": {
              "wideLayout": true
            }
          },
          {
            "id": "p41",
            "type": "stat",
            "title": "Active workers",
            "description": " Shows number of active reconcile workers",
            "gridPos": {
              "x": 8,
              "y": 8,
              "w": 4,
              "h": 5
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(controller_runtime_active_workers{job=~\"$job\"})",
                "legend": "__auto"
              }
            ],
            "thresholds": [
              {
                "color": "ok"
              },
              {
                "value": 80,
                "color": "critical"
              }
            ],
            "display": {
              "wideLayout": true
            }
          },
          {
            "id": "p38",
            "type": "timeseries",
            "title": "Prometheus Converter Watch events",
            "description": " Shows amount of Prometheus Operator objects processed by Operator.",
            "gridPos": {
              "x": 12,
              "y": 8,
              "w": 12,
              "h": 5
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(rate(operator_prometheus_converter_watch_events_total{job=~\"$job\"}[$__interval])) by (event_type,object_type_name)",
                "legend": "{{object_type_name}} {{event_type}}"
              }
            ],
            "thresholdsStyle": "off",
            "display": {
              "legendValues": [
                "max",
                "mean"
              ]
            }
          },
          {
            "id": "p43",
            "type": "table",
            "title": "Non-default flags",
            "gridPos": {
              "x": 0,
              "y": 13,
              "w": 12,
              "h": 5
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(flag{is_set=\"true\", job=~\"$job\", instance=~\"$instance\"}) by(job, instance, name, value)",
                "legend": "{{object_type_name}} {{event_type}}",
                "instant": true,
                "format": "table"
              }
            ],
            "transform": [
              {
                "type": "groupBy",
                "by": [
                  "job",
                  "name",
                  "value"
                ],
                "aggregate": [
                  {
                    "field": "instance",
                    "reducers": [
                      "uniqueValues"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "p45",
            "type": "table",
            "title": "Global settings",
            "gridPos": {
              "x": 12,
              "y": 13,
              "w": 12,
              "h": 5
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(config_parameter{job=~\"$job\", instance=~\"$instance\", value!=\"\"}) by(job, instance, name, value)",
                "legend": "{{object_type_name}} {{event_type}}",
                "instant": true,
                "format": "table"
              }
            ],
            "transform": [
              {
                "type": "groupBy",
                "by": [
                  "name",
                  "value"
                ],
                "aggregate": [
                  {
                    "field": "instance",
                    "reducers": [
                      "uniqueValues"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "p12",
            "type": "timeseries",
            "title": "Reconciliation rate by controller",
            "gridPos": {
              "x": 0,
              "y": 18,
              "w": 12,
              "h": 13
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(rate(controller_runtime_reconcile_total{job=~\"$job\",instance=~\"$instance\",result=~\"requeue_after|requeue|success\"}[$__rate_interval])) by(controller)",
                "legend": "{{controller}}"
              }
            ],
            "unit": "short",
            "fill": 10,
            "points": "never",
            "thresholdsStyle": "off",
            "display": {
              "legendValues": [
                "mean",
                "max"
              ],
              "tooltip": "all",
              "tooltipSort": "none"
            }
          },
          {
            "id": "p16",
            "type": "timeseries",
            "title": "Log message rate",
            "description": "Shows the rate of logging the messages by their level. Unexpected spike in rate is a good reason to check logs.",
            "gridPos": {
              "x": 12,
              "y": 18,
              "w": 12,
              "h": 13
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(rate(operator_log_messages_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])) by (level)",
                "legend": "{{label_name}}"
