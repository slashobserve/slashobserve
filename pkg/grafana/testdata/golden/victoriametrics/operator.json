              "tooltip": "all",
              "tooltipSort": "none"
            }
          },
          {
            "id": "p18",
            "type": "timeseries",
            "title": "Throttled reconciliation config events",
            "description": "Operator limits number of reconcile configuration events to 5 events per 2 seconds by default.",
            "gridPos": {
              "x": 12,
              "y": 32,
              "w": 12,
              "h": 8
            },
            "datasource": "${ds}",
            "queries": [
