          "x": 0,
          "y": 31,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p10",
            "type": "timeseries",
            "title": "Reconcile errors by controller",
            "description": "Non zero metrics indicates about error with CR object definition (typos or incorrect values) or errors with kubernetes API connection.",
            "gridPos": {
              "x": 0,
              "y": 32,
              "w": 12,
              "h": 8
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(rate(controller_runtime_reconcile_errors_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])) by(controller) > 0 ",
                "legend": "{{controller}}"
              },
              {
                "query": "sum(rate(controller_runtime_reconcile_total{job=~\"$job\",instance=~\"$instance\",result=\"error\"}[$__rate_interval])) by(controller) > 0",
                "legend": "result errors: {{controller}}"
              }
            ],
            "unit": "short",
            "fill": 10,
            "points": "never",
            "thresholdsStyle": "off",
            "display": {
              "legendValues": [
