              "x": 0,
              "y": 40,
              "w": 12,
              "h": 11
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "max(workqueue_depth{job=~\"$job\",instance=~\"$instance\"}) by (name)",
                "legend": "{{label_name}}"
              }
            ],
            "unit": "short",
            "fill": 10,
            "points": "never",
            "thresholdsStyle": "off",
            "display": {
              "legendValues": [
                "max",
                "mean"
              ],
              "tooltip": "all",
              "tooltipSort": "none"
            }
          },
          {
            "id": "p26",
            "type": "timeseries",
            "title": "Reconciliation latency by controller",
            "description": " For controllers with StatefulSet it's ok to see latency greater then 3 seconds. It could be vmalertmanager,vmcluster or vmagent in statefulMode.\n\n For other controllers, latency greater then 2 second may indicate issues with kubernetes cluster or operator's performance.\n ",
            "gridPos": {
              "x": 12,
              "y": 40,
              "w": 12,
              "h": 11
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "histogram_quantile(0.99, sum(rate(controller_runtime_reconcile_time_seconds_bucket{job=~\"$job\"}[$__rate_interval])) by (le, controller) )",
                "legend": "q.99 {{controller}}"
              }
            ],
            "unit": "s",
            "fill": 10,
            "points": "never",
            "thresholdsStyle": "off",
            "display": {
              "legendValues": [
                "mean",
                "max"
              ],
              "legendSortBy": "mean",
              "legendSortDesc": true,
              "tooltip": "all",
              "tooltipSort": "none"
            }
          },
          {
            "id": "p36",
            "type": "timeseries",
            "title": "REST client requests",
            "description": "Number of HTTP requests to the Kubernetes API server break down by code and method",
            "gridPos": {
              "x": 0,
              "y": 51,
              "w": 12,
              "h": 8
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "sum(rate(rest_client_requests_total{job=~\"$job\"}[$__interval])) by (method, code)",
                "legend": "{{method}} {{code}}"
              }
            ],
            "thresholdsStyle": "off",
            "display": {
              "legendValues": [
                "max",
                "mean"
              ]
            }
          },
          {
            "id": "p42",
            "type": "timeseries",
            "title": "Concurrent reconcile ($instance)",
            "description": "Shows how many ongoing reconcile events are taking place, where:\n* `max` - equal to the value of flag`-controller.maxConcurrentReconciles`;\n* `current` - current number of reconcile workers processing CRD objects.\n\nWhen `current` hits `max` constantly, it means operator cannot process events in time. It should be either increased value for flag `-controller.maxConcurrentReconciles` or allocated  additional CPU resources to the operator.",
            "gridPos": {
              "x": 12,
              "y": 51,
              "w": 12,
              "h": 8
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "max(max_over_time(controller_runtime_active_workers{job=~\"$job\"}[$__interval]))",
                "legend": "Current"
              },
              {
                "query": "min(controller_runtime_max_concurrent_reconciles{job=~\"$job\"})",
                "legend": "Max"
              }
            ],
            "thresholdsStyle": "off",
            "overrides": [
              {
                "match": {
                  "series": "Max"
                },
                "color": "#C4162A",
                "axisColor": "text"
              }
            ]
          },
          {
            "id": "p37",
            "type": "timeseries",
            "title": "Go scheduling latency",
            "description": "Shows the time goroutines have spent in runnable state before actually running.\n\n**Lower is better.**\n\nHigh values or values exceeding the threshold is usually a sign of insufficient CPU resources or CPU throttling. \n\nVerify that service has enough CPU resources. Otherwise, the service could work unreliably with delays in processing.",
            "gridPos": {
              "x": 0,
              "y": 59,
              "w": 12,
              "h": 8
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "max(histogram_quantile(0.99, sum(rate(go_sched_latencies_seconds_bucket{job=~\"$job\"}[$__rate_interval])) by (job, instance, le))) by (job)",
                "legend": "__auto"
              }
            ],
            "unit": "s",
            "thresholdsStyle": "off"
          },
          {
            "id": "p35",
            "type": "timeseries",
            "title": "REST client latency",
            "description": " Requests latency to the Kubernetes API server.",
            "gridPos": {
              "x": 12,
              "y": 59,
              "w": 12,
              "h": 8
            },
            "datasource": "${ds}",
            "queries": [
              {
                "query": "histogram_quantile(0.99, sum(rate(rest_client_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])) by (le, method, api))",
                "legend": "{{method}} {{api}}"
              }
            ],
            "unit": "s",
            "thresholdsStyle": "off",
            "display": {
              "legendValues": [
                "max",
                "mean"
              ]
            }
          }
        ]
      },
