  "spec": {
    "specVersion": "0",
    "title": "Apache Full",
    "tags": [
      "apache"
    ],
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "refresh": "1m",
    "cursorSync": "crosshair",
    "variables": [
      {
        "name": "DS_PROMETHEUS",
        "label": "datasource",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "job",
        "label": "job",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(apache_up, job)",
        "sort": "alpha",
        "refresh": "timeRange",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "allowCustomValue": true
      },
      {
        "name": "instance",
        "label": "instance",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(apache_up{job=\"$job\"}, instance)",
        "sort": "alpha",
        "refresh": "timeRange",
        "allowCustomValue": true
      }
    ],
    "links": [
      {
        "title": "GitHub",
        "url": "https://github.com/rfmoz/grafana-dashboards",
        "newTab": true
      }
    ],
    "panels": [
      {
        "id": "p1",
        "type": "stat",
        "title": "Uptime",
        "description": "Current uptime of the Apache server.",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 4,
          "h": 3
        },
        "datasource": "${DS_PROMETHEUS}",
        "queries": [
          {
            "query": "apache_uptime_seconds_total{job=\"$job\", instance=\"$instance\"}",
            "interval": "240s"
          }
        ],
        "unit": "s",
        "decimals": 1,
        "thresholds": [
          {
            "color": "ok"
          },
          {
            "value": 80,
            "color": "critical"
          }
        ],
        "mappings": [
          {
            "special": "null",
            "text": "N/A"
          }
        ],
        "maxDataPoints": 100,
        "display": {
          "colorMode": "none",
          "graph": false,
          "orientation": "horizontal"
        }
      },
      {
        "id": "p2",
        "type": "stat",
        "title": "Version",
        "description": "Apache server version and MPM module.",
        "gridPos": {
          "x": 4,
          "y": 0,
          "w": 4,
          "h": 3
        },
        "datasource": "${DS_PROMETHEUS}",
        "queries": [
          {
            "query": "apache_info{job=\"$job\", instance=\"$instance\"}",
            "legend": "{{ version }}",
            "instant": true,
            "interval": "240s"
          }
        ],
        "unit": "none",
        "decimals": 1,
        "thresholds": [
          {
            "color": "ok"
          },
          {
            "value": 80,
            "color": "critical"
          }
        ],
        "mappings": [
          {
            "special": "null",
            "text": "N/A"
          }
        ],
        "maxDataPoints": 100,
        "display": {
          "colorMode": "none",
          "graph": false,
          "textMode": "name",
          "orientation": "horizontal"
        }
      },
      {
        "id": "p19",
        "type": "stat",
        "title": "CPU Load",
        "description": "Current percentage of CPU used by Apache workers.",
        "gridPos": {
          "x": 8,
          "y": 0,
          "w": 4,
          "h": 3
        },
        "datasource": "${DS_PROMETHEUS}",
        "queries": [
          {
            "query": "apache_cpuload{job=\"$job\", instance=\"$instance\"}",
            "instant": true
          }
        ],
        "unit": "percent",
        "thresholds": [
          {
            "color": "ok"
          },
          {
            "value": 75,
            "color": "warning"
          },
          {
            "value": 90,
            "color": "critical"
          }
        ],
        "mappings": [
          {
            "special": "null",
            "text": "N/A"
          }
        ],
        "maxDataPoints": 100,
        "display": {
          "graph": false,
          "wideLayout": true
        }
      },
      {
        "id": "p3",
        "type": "state-timeline",
        "title": "Up / Down",
        "description": "Whether the Apache server is reachable.",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 3
        },
        "datasource": "${DS_PROMETHEUS}",
        "queries": [
          {
            "query": "apache_up{job=\"$job\", instance=\"$instance\"}",
            "legend": "Apache up",
            "interval": "240s"
          }
        ],
        "thresholds": [
          {
            "color": "ok"
          }
        ],
        "mappings": [
          {
            "value": "1",
            "text": "Up",
            "color": "ok"
          },
          {
            "value": "0",
            "text": "Down",
            "color": "critical"
          }
        ],
        "fill": 70,
        "lineWidth": 0,
        "display": {
          "legend": "right",
          "mergeValues": false,
          "showValues": "never",
          "rowHeight": 0.9
        }
      },
      {
        "id": "p4",
        "type": "timeseries",
        "title": "Requests / Traffic",
        "description": "Request rate and bytes sent per second.",
        "gridPos": {
          "x": 0,
          "y": 3,
          "w": 12,
          "h": 7
        },
        "datasource": "${DS_PROMETHEUS}",
        "queries": [
          {
            "query": "rate(apache_accesses_total{job=\"$job\", instance=\"$instance\"}[$__rate_interval])",
            "legend": "Calls",
            "interval": "240s"
          },
          {
            "query": "rate(apache_sent_kilobytes_total{job=\"$job\", instance=\"$instance\"}[$__rate_interval]) * 1000",
            "legend": "Bytes sent"
          }
        ],
        "unit": "reqps",
        "fill": 10,
        "spanNulls": true,
        "overrides": [
          {
            "match": {
              "series": "Bytes sent"
            },
            "unit": "Bps",
            "style": "bars",
            "axis": "right"
          }
        ],
        "display": {
          "legendValues": [
            "mean",
            "lastNotNull",
            "max",
            "min"
          ],
          "tooltip": "all"
        }
      },
      {
        "id": "p5",
        "type": "timeseries",
        "title": "Average Response Time",
        "description": "Average response time per request.",
        "gridPos": {
          "x": 12,
          "y": 3,
          "w": 12,
          "h": 7
        },
        "datasource": "${DS_PROMETHEUS}",
        "queries": [
          {
            "query": "increase(apache_duration_ms_total{job=\"$job\", instance=\"$instance\"}[$__rate_interval])/increase(apache_accesses_total{job=\"$job\", instance=\"$instance\"}[$__rate_interval])",
            "legend": "Average response time",
            "interval": "240s"
          }
        ],
        "unit": "ms",
        "fill": 10,
        "spanNulls": true,
        "display": {
          "legendValues": [
            "mean",
            "lastNotNull",
            "max",
            "min"
          ],
          "tooltip": "all"
        }
      },
      {
        "id": "p7",
        "type": "timeseries",
        "title": "Workers",
        "description": "Number of busy and idle Apache workers.",
        "gridPos": {
          "x": 0,
          "y": 10,
          "w": 12,
          "h": 7
        },
        "datasource": "${DS_PROMETHEUS}",
        "queries": [
          {
            "query": "apache_workers{job=\"$job\", instance=\"$instance\"}\n",
            "legend": "{{ state }}",
            "interval": "240s"
          }
        ],
        "unit": "short",
        "fill": 10,
        "lineInterpolation": "stepAfter",
        "spanNulls": true,
        "stack": "normal",
        "display": {
          "legendValues": [
            "mean",
            "lastNotNull",
            "max",
            "min"
          ],
          "tooltip": "all"
        }
      },
      {
        "id": "p9",
        "type": "timeseries",
        "title": "Connections",
        "description": "Current Apache connections by state.",
        "gridPos": {
          "x": 12,
          "y": 10,
          "w": 12,
          "h": 7
        },
        "datasource": "${DS_PROMETHEUS}",
        "queries": [
          {
            "query": "apache_connections{job=\"$job\", instance=\"$instance\", state=\"total\"}",
            "legend": "Total"
          },
          {
            "query": "apache_connections{job=\"$job\", instance=\"$instance\", state=\"writing\"}",
            "legend": "Writing"
          },
          {
            "query": "apache_connections{job=\"$job\", instance=\"$instance\", state=\"keepalive\"}",
            "legend": "Keepalive"
          },
          {
            "query": "apache_connections{job=\"$job\", instance=\"$instance\", state=\"closing\"}",
            "legend": "Closing"
          }
        ],
        "unit": "short",
        "fill": 10,
        "spanNulls": true,
        "display": {
          "legendValues": [
            "mean",
            "lastNotNull",
            "max",
            "min"
          ],
          "tooltip": "all"
        }
      },
      {
        "id": "p6",
        "type": "timeseries",
        "title": "Scoreboard",
        "description": "Current state of each Apache slot (idle, read, reply, keepalive, etc.).",
        "gridPos": {
          "x": 0,
          "y": 17,
          "w": 24,
          "h": 7
        },
        "datasource": "${DS_PROMETHEUS}",
        "queries": [
          {
            "query": "apache_scoreboard{job=\"$job\", instance=\"$instance\"}",
            "legend": "{{ state }}",
            "interval": "240s"
          }
        ],
        "unit": "short",
        "fill": 10,
        "lineInterpolation": "stepAfter",
        "spanNulls": true,
        "stack": "normal",
        "display": {
          "legendValues": [
            "mean",
            "lastNotNull",
            "max",
            "min"
          ],
          "tooltip": "all"
        }
      },
      {
        "id": "p14",
        "type": "row",
        "title": "Proxy Balancer",
        "gridPos": {
          "x": 0,
          "y": 24,
          "w": 24,
          "h": 1
        },
        "collapsed": true,
        "panels": [
          {
            "id": "p15",
            "type": "timeseries",
            "title": "Proxy Balancer Requests",
            "description": "Request rate per proxy balancer worker.",
            "gridPos": {
              "x": 0,
              "y": 25,
              "w": 12,
              "h": 11
            },
            "datasource": "${DS_PROMETHEUS}",
            "queries": [
              {
                "query": "rate(apache_proxy_balancer_accesses_total{job=\"$job\", instance=\"$instance\"}[$__rate_interval])",
                "legend": "{{balancer}} / {{worker}}"
              }
            ],
            "unit": "reqps",
            "fill": 10,
            "spanNulls": true,
            "display": {
              "legendValues": [
                "mean",
                "lastNotNull",
                "max",
                "min"
              ],
              "tooltip": "all"
            }
          },
          {
            "id": "p16",
            "type": "timeseries",
            "title": "Proxy Balancer Active Requests",
            "description": "Number of active requests per proxy balancer worker.",
            "gridPos": {
              "x": 12,
              "y": 25,
              "w": 12,
              "h": 11
