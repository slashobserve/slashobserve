  "spec": {
    "specVersion": "0",
    "title": "OpenTelemetry Traces Explorer",
    "description": "Explore OpenTelemetry traces with service topology, per-service drill-downs, and trace search. Click services, operations, or TraceIds to navigate.",
    "tags": [
      "clickhouse",
      "otel",
      "traces"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "cursorSync": "tooltip",
    "variables": [
      {
        "name": "datasource",
        "label": "Data Source",
        "type": "datasource",
        "datasourceType": "clickhouse",
        "default": "ch"
      },
      {
        "name": "interval",
        "label": "Min interval",
        "type": "interval",
        "options": [
          "10s",
          "30s",
          "1m",
          "5m",
          "10m",
          "30m",
          "1h",
          "6h",
          "12h",
          "1d"
        ],
        "auto": true,
        "autoSteps": 30,
        "autoMin": "10s"
      },
      {
        "name": "database",
        "label": "Database",
        "type": "query",
        "datasource": "${datasource}",
        "query": "SELECT database FROM system.tables WHERE name IN ('otel_logs', 'otel_traces') GROUP BY database HAVING count(DISTINCT name) = 2 ORDER BY database",
        "sort": "alpha",
        "allowCustomValue": true
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": "${datasource}",
        "query": "SELECT ServiceName FROM ${database}.otel_traces WHERE $__timeFilter(Timestamp) GROUP BY ServiceName ORDER BY count() DESC LIMIT 10",
        "refresh": "timeRange",
        "multi": true,
        "includeAll": true,
        "allowCustomValue": true
      },
      {
        "name": "operation",
        "label": "Operation",
        "type": "query",
        "datasource": "${datasource}",
        "query": "SELECT DISTINCT SpanName FROM ${database}.otel_traces WHERE $__timeFilter(Timestamp) AND $__conditionalAll(ServiceName IN (${service:singlequote}), $service) ORDER BY SpanName LIMIT 200",
        "refresh": "timeRange",
        "multi": true,
        "includeAll": true,
        "allowCustomValue": true
      },
      {
        "name": "status",
        "label": "Status",
        "type": "query",
        "datasource": "${datasource}",
        "query": "SELECT DISTINCT StatusCode FROM ${database}.otel_traces WHERE $__timeFilter(Timestamp) ORDER BY StatusCode",
        "refresh": "timeRange",
        "multi": true,
        "includeAll": true,
        "allowCustomValue": true
      },
      {
        "name": "min_duration",
        "label": "Min Duration (ms)",
        "description": "Filter to traces lasting at least this many milliseconds. Leave blank for no minimum.",
        "type": "textbox"
      },
      {
        "name": "search",
        "label": "Search",
        "description": "Free-text search applied to SpanName (operation) on every trace panel. Use the Traces Explorer's Status filter for error-only views. Leave blank to disable.",
        "type": "textbox"
      }
    ],
    "panels": [
      {
        "id": "p50",
        "type": "row",
        "title": "System Topology",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p55",
            "type": "nodeGraph",
            "title": "Service Map",
            "description": "Cross-service call graph from parent-child span joins. Edge counts are calls between services; node arcs show success vs error fraction. Limited to top 30 services and top 50 edges.",
            "gridPos": {
              "x": 0,
              "y": 1,
              "w": 24,
              "h": 10
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "ref": "nodes",
                "query": "SELECT\n  ServiceName AS id,\n  ServiceName AS title,\n  concat(toString(count()), ' spans') AS mainstat,\n  concat(toString(round(avg(Duration) / 1000000, 1)), ' ms avg') AS secondarystat,\n  (count() - countIf(StatusCode IN ('Error', 'STATUS_CODE_ERROR'))) / count() AS arc__success,\n  countIf(StatusCode IN ('Error', 'STATUS_CODE_ERROR')) / count() AS arc__errors\nFROM ${database}.otel_traces\nWHERE $__timeFilter(Timestamp)\nGROUP BY ServiceName\nORDER BY count() DESC\nLIMIT 30",
                "format": "table"
              },
              {
                "ref": "edges",
                "query": "SELECT\n  concat(parent.ServiceName, '-', child.ServiceName) AS id,\n  parent.ServiceName AS source,\n  child.ServiceName AS target,\n  concat(toString(count()), ' calls') AS mainstat\nFROM ${database}.otel_traces AS child\nINNER JOIN ${database}.otel_traces AS parent\n  ON child.ParentSpanId = parent.SpanId\n  AND child.TraceId = parent.TraceId\nWHERE $__timeFilter(child.Timestamp)\n  AND $__timeFilter(parent.Timestamp)\n  AND parent.ServiceName != child.ServiceName\nGROUP BY source, target\nORDER BY count() DESC\nLIMIT 50",
                "format": "table"
              }
            ],
            "overrides": [
              {
                "match": {
                  "field": "arc__success"
                },
                "color": "#73BF69"
              },
              {
                "match": {
                  "field": "arc__errors"
                },
                "color": "#F2495C"
              }
            ]
          }
        ]
      },
      {
        "id": "p60",
        "type": "row",
        "title": "Trace Search",
        "gridPos": {
          "x": 0,
          "y": 11,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p20",
            "type": "table",
            "title": "Trace Search Results",
            "description": "Recent traces matching the variable filters. Click a TraceId to view the trace.",
            "gridPos": {
              "x": 0,
              "y": 12,
              "w": 24,
              "h": 12
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "SELECT\n  TraceId,\n  any(ServiceName) AS Service,\n  any(SpanName) AS RootOperation,\n  min(Timestamp) AS Time,\n  max(Duration) AS Duration,\n  count() AS Spans,\n  anyIf(StatusCode, StatusCode IN ('Error', 'STATUS_CODE_ERROR')) AS Status\nFROM ${database}.otel_traces\nWHERE $__timeFilter(Timestamp)\n  AND $__conditionalAll(ServiceName IN (${service:singlequote}), $service)\n  AND $__conditionalAll(SpanName IN (${operation:singlequote}), $operation)\n  AND $__conditionalAll(StatusCode IN (${status:singlequote}), $status)\n  AND $__conditionalAll(positionCaseInsensitive(SpanName, '$search') > 0, $search)\nGROUP BY TraceId\nHAVING $__conditionalAll(max(Duration) >= toUInt64($min_duration) * 1000000, $min_duration)\nORDER BY Time DESC\nLIMIT 200",
                "format": "table"
              }
            ],
            "inspect": true,
            "overrides": [
              {
                "match": {
                  "field": "Duration"
                },
                "unit": "ns",
                "width": 130
              },
              {
                "match": {
                  "field": "Spans"
                },
                "width": 70
              },
              {
                "match": {
                  "field": "Status"
                },
                "mappings": [
                  {
                    "value": "Error",
                    "text": "Error",
                    "color": "critical"
                  },
                  {
                    "value": "Ok",
                    "text": "Ok",
                    "color": "ok"
                  },
                  {
                    "value": "Unset",
                    "text": "-"
                  }
                ],
                "cell": {
                  "type": "text"
                },
                "width": 90
              },
              {
                "match": {
                  "field": "TraceId"
                },
                "width": 290
              },
              {
                "match": {
                  "field": "Service"
                },
                "width": 170
              }
            ],
            "display": {
              "footer": [
                "count"
              ],
              "footerCountRows": true,
              "sortBy": "Time",
              "sortDesc": true
            }
          }
        ]
      },
      {
        "id": "p200",
        "type": "row",
        "title": "$service",
        "gridPos": {
          "x": 0,
          "y": 24,
          "w": 24,
          "h": 1
        },
        "repeat": "service",
        "panels": [
          {
            "id": "p301",
            "type": "heatmap",
            "title": "Duration Distribution",
            "description": "Span duration distribution over time for $service, log-scale. Sampled at 1-in-500 spans for performance.",
            "gridPos": {
              "x": 0,
              "y": 25,
              "w": 16,
              "h": 8
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "SELECT\n  toStartOfInterval(Timestamp, INTERVAL $__interval_s second) AS time,\n  Duration / 1000000 AS duration_ms\nFROM ${database}.otel_traces\nWHERE $__timeFilter(Timestamp)\n  AND ServiceName IN (${service:singlequote}) AND $__conditionalAll(positionCaseInsensitive(SpanName, '$search') > 0, $search)\n  AND cityHash64(SpanId) % 500 = 0\nORDER BY time"
              }
            ],
            "unit": "ms",
            "interval": "${interval}",
            "display": {
              "calculate": true,
              "yScale": "log"
            }
          },
          {
            "id": "p302",
            "type": "stat",
            "title": "Panel 302",
            "description": "Total span count for $service.",
            "gridPos": {
              "x": 16,
              "y": 25,
              "w": 8,
              "h": 2
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "SELECT toStartOfInterval(Timestamp, INTERVAL $__interval_s second) AS time, count() AS Spans FROM ${database}.otel_traces WHERE $__timeFilter(Timestamp) AND ServiceName IN (${service:singlequote}) AND $__conditionalAll(positionCaseInsensitive(SpanName, '$search') > 0, $search) GROUP BY time ORDER BY time",
                "format": "table"
              }
            ],
            "interval": "${interval}",
            "transparent": true,
            "titleHidden": true,
            "display": {
              "reduce": "sum",
              "colorMode": "none",
              "textMode": "valueAndName",
              "orientation": "horizontal"
            }
          },
          {
            "id": "p303",
            "type": "stat",
            "title": "Panel 303",
            "description": "Error span count for $service.",
            "gridPos": {
              "x": 16,
              "y": 27,
              "w": 8,
              "h": 2
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "SELECT toStartOfInterval(Timestamp, INTERVAL $__interval_s second) AS time, countIf(StatusCode IN ('Error', 'STATUS_CODE_ERROR')) AS Errors FROM ${database}.otel_traces WHERE $__timeFilter(Timestamp) AND ServiceName IN (${service:singlequote}) AND $__conditionalAll(positionCaseInsensitive(SpanName, '$search') > 0, $search) GROUP BY time ORDER BY time",
                "format": "table"
              }
            ],
            "color": "#F2495C",
            "interval": "${interval}",
            "transparent": true,
            "titleHidden": true,
            "display": {
              "reduce": "sum",
              "colorMode": "none",
              "textMode": "valueAndName",
              "orientation": "horizontal"
            }
          },
          {
            "id": "p304",
            "type": "stat",
            "title": "Panel 304",
            "description": "P99 span duration for $service.",
            "gridPos": {
              "x": 16,
              "y": 29,
              "w": 8,
              "h": 2
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "SELECT\n  toStartOfInterval(Timestamp, INTERVAL $__interval_s second) AS time,\n  quantile(0.99)(Duration) / 1000000 AS p99_ms\nFROM ${database}.otel_traces\nWHERE $__timeFilter(Timestamp)\n  AND ServiceName IN (${service:singlequote}) AND $__conditionalAll(positionCaseInsensitive(SpanName, '$search') > 0, $search)\nGROUP BY time\nORDER BY time"
              }
            ],
            "unit": "ms",
            "color": "#FF9830",
            "interval": "${interval}",
            "transparent": true,
            "titleHidden": true,
            "display": {
              "colorMode": "none",
              "textMode": "valueAndName",
              "orientation": "horizontal"
            }
          },
          {
            "id": "p305",
            "type": "stat",
            "title": "Panel 305",
            "description": "Mean span duration for $service.",
            "gridPos": {
              "x": 16,
              "y": 31,
              "w": 8,
              "h": 2
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "SELECT toStartOfInterval(Timestamp, INTERVAL $__interval_s second) AS time, avg(Duration) / 1000000 AS \"Avg Duration\" FROM ${database}.otel_traces WHERE $__timeFilter(Timestamp) AND ServiceName IN (${service:singlequote}) AND $__conditionalAll(positionCaseInsensitive(SpanName, '$search') > 0, $search) GROUP BY time ORDER BY time",
                "format": "table"
              }
            ],
            "unit": "ms",
            "color": "#5794F2",
            "interval": "${interval}",
            "transparent": true,
            "titleHidden": true,
            "display": {
              "colorMode": "none",
              "textMode": "valueAndName",
              "orientation": "horizontal"
            }
          },
          {
            "id": "p306",
            "type": "table",
            "title": "Top Operations",
            "description": "Operations for $service ranked by call count. Errors and Error % are colour-coded.",
            "gridPos": {
              "x": 0,
              "y": 33,
              "w": 24,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "SELECT\n  SpanName AS Operation,\n  count() AS Count,\n  countIf(StatusCode IN ('Error', 'STATUS_CODE_ERROR')) AS Errors,\n  round(countIf(StatusCode IN ('Error', 'STATUS_CODE_ERROR')) / count() * 100, 2) AS \"Error %\",\n  quantile(0.5)(Duration) AS P50,\n  quantile(0.99)(Duration) AS P99,\n  anyIf(if(StatusMessage != '', StatusMessage, SpanAttributes['http.status_code']), StatusCode IN ('Error', 'STATUS_CODE_ERROR')) AS \"Top Error\"\nFROM ${database}.otel_traces\nWHERE $__timeFilter(Timestamp)\n  AND ServiceName IN (${service:singlequote}) AND $__conditionalAll(positionCaseInsensitive(SpanName, '$search') > 0, $search)\nGROUP BY Operation\nORDER BY Count DESC\nLIMIT 15",
                "format": "table"
              }
            ],
            "inspect": true,
            "overrides": [
              {
                "match": {
                  "field": "Count"
                },
                "width": 90
              },
              {
                "match": {
                  "field": "Errors"
                },
                "thresholds": [
                  {
                    "value": 1,
                    "color": "critical"
                  }
                ],
                "cell": {
                  "type": "background"
                },
                "width": 80
              },
              {
                "match": {
                  "field": "Error %"
                },
                "unit": "percent",
                "thresholds": [
                  {
                    "value": 1,
                    "color": "warning"
                  },
                  {
                    "value": 10,
                    "color": "critical"
                  }
                ],
                "cell": {
                  "type": "background"
                },
                "width": 80
              },
              {
                "match": {
                  "field": "P50"
                },
                "unit": "ns",
                "width": 110
              },
              {
                "match": {
                  "field": "P99"
                },
                "unit": "ns",
                "width": 110
              },
              {
                "match": {
                  "field": "Top Error"
                },
                "color": "#F2495C",
                "cell": {
                  "type": "text"
                }
              }
            ],
            "display": {
              "sortBy": "Count",
              "sortDesc": true
            }
          }
        ]
      }
    ]
  }
}
