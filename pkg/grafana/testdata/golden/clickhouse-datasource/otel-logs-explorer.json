  "spec": {
    "specVersion": "0",
    "title": "OpenTelemetry Logs Explorer",
    "description": "Explore OpenTelemetry logs in ClickHouse. Top services with per-service log volume and samples.",
    "tags": [
      "clickhouse",
      "otel",
      "logs"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "cursorSync": "tooltip",
    "variables": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "datasourceType": "clickhouse",
        "default": "ch"
      },
      {
        "name": "database",
        "label": "Database",
        "type": "query",
        "datasource": "${datasource}",
        "query": "SELECT database FROM system.tables WHERE name IN ('otel_logs', 'otel_traces') GROUP BY database HAVING count(DISTINCT name) = 2 ORDER BY database",
        "sort": "alpha",
        "allowCustomValue": true
      },
      {
        "name": "interval",
        "label": "Min interval",
        "type": "interval",
        "options": [
          "10s",
          "30s",
          "1m",
          "5m",
          "10m",
          "30m",
          "1h",
          "6h",
          "12h",
          "1d"
        ],
        "auto": true,
        "autoSteps": 30,
        "autoMin": "10s"
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": "${datasource}",
        "query": "SELECT ServiceName FROM ${database}.otel_logs WHERE $__timeFilter(Timestamp) GROUP BY ServiceName ORDER BY count() DESC LIMIT 10",
        "refresh": "timeRange",
        "multi": true,
        "includeAll": true,
        "allowCustomValue": true
      },
      {
        "name": "level_filter",
        "label": "Level",
        "type": "query",
        "datasource": "${datasource}",
        "query": "SELECT DISTINCT SeverityText FROM ${database}.otel_logs WHERE $__timeFilter(Timestamp) ORDER BY SeverityText",
        "refresh": "timeRange",
        "multi": true,
        "includeAll": true,
        "allowCustomValue": true
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox"
      }
    ],
    "links": [
      {
        "type": "dashboards",
        "title": "OpenTelemetry Dashboards",
        "tags": [
          "clickhouse",
          "otel"
        ],
        "asDropdown": true,
        "keepTime": true,
        "includeVars": true
      }
    ],
    "panels": [
      {
        "id": "p100",
        "type": "row",
        "title": "Overview",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p1",
            "type": "timeseries",
            "title": "Log Volume by Level",
            "description": "Stacked log volume by SeverityText across the services and levels selected above.",
            "gridPos": {
              "x": 0,
              "y": 1,
              "w": 24,
              "h": 5
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "SELECT\n  toStartOfInterval(Timestamp, INTERVAL $__interval_s second) AS time,\n  SeverityText AS metric,\n  count() AS count\nFROM ${database}.otel_logs\nWHERE $__timeFilter(Timestamp)\n  AND $__conditionalAll(ServiceName IN (${service:singlequote}), $service)\n  AND $__conditionalAll(SeverityText IN (${level_filter:singlequote}), $level_filter)\n  AND $__conditionalAll(positionCaseInsensitive(Body, '$search') > 0, $search)\nGROUP BY time, metric\nORDER BY time"
              }
            ],
            "style": "bars",
            "fill": 80,
            "lineWidth": 0,
            "points": "never",
            "stack": "normal",
            "overrides": [
              {
                "match": {
                  "seriesRegex": "/fatal|FATAL/i"
                },
                "color": "#C4162A",
                "displayName": "fatal"
              },
              {
                "match": {
                  "seriesRegex": "/error|Error/i"
                },
                "color": "#F2495C",
                "displayName": "error"
              },
              {
                "match": {
                  "seriesRegex": "/warn|Warning/i"
                },
                "color": "#FF9830",
                "displayName": "warning"
              },
              {
                "match": {
                  "seriesRegex": "/info|Information/i"
                },
                "color": "#73BF69",
                "displayName": "info"
              },
              {
                "match": {
                  "seriesRegex": "/debug|Debug/i"
                },
                "color": "#5794F2",
                "displayName": "debug"
              },
              {
                "match": {
                  "seriesRegex": "/(?:^count )?TRACE$|(?:^count )?Trace$/i"
                },
                "color": "#B877D9",
                "displayName": "trace"
              }
            ],
            "interval": "${interval}",
            "display": {
              "legendValues": [
                "sum"
              ],
              "legendMode": "list",
              "tooltip": "all",
              "tooltipSort": "none"
            }
          },
          {
            "id": "p2",
            "type": "bargauge",
            "title": "Services",
            "description": "Log volume per service in the current time range, honoring the Service, Level, and Search filters. Highest-volume first, up to 15.",
            "gridPos": {
              "x": 0,
              "y": 6,
              "w": 7,
              "h": 5
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "SELECT\n  ServiceName AS Service,\n  count() AS Count\nFROM ${database}.otel_logs\nWHERE $__timeFilter(Timestamp)\n  AND $__conditionalAll(ServiceName IN (${service:singlequote}), $service)\n  AND $__conditionalAll(SeverityText IN (${level_filter:singlequote}), $level_filter)\n  AND $__conditionalAll(positionCaseInsensitive(Body, '$search') > 0, $search)\nGROUP BY Service\nORDER BY Count DESC\nLIMIT 15"
              }
            ],
            "thresholds": [
              {
                "color": "ok"
              },
              {
                "value": 1000,
                "color": "warning"
              },
              {
                "value": 10000,
                "color": "critical"
              }
            ],
            "display": {
              "reduce": "sum",
              "allValues": true,
              "fields": "/Count/",
              "orientation": "horizontal"
            }
          },
          {
            "id": "p4",
            "type": "piechart",
            "title": "Level Distribution",
            "description": "Share of log lines by SeverityText. Useful for spotting unusual error spikes at a glance.",
            "gridPos": {
              "x": 7,
              "y": 6,
              "w": 5,
              "h": 5
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "SELECT\n  SeverityText AS Level,\n  count() AS Count\nFROM ${database}.otel_logs\nWHERE $__timeFilter(Timestamp)\n  AND $__conditionalAll(ServiceName IN (${service:singlequote}), $service)\n  AND $__conditionalAll(positionCaseInsensitive(Body, '$search') > 0, $search)\nGROUP BY Level\nORDER BY Count DESC"
              }
            ],
            "overrides": [
              {
                "match": {
                  "seriesRegex": "/fatal|FATAL/"
                },
                "color": "#C4162A"
              },
              {
                "match": {
                  "seriesRegex": "/error|Error/"
                },
                "color": "#F2495C"
              },
              {
                "match": {
                  "seriesRegex": "/warn|Warning/"
                },
                "color": "#FF9830"
              },
              {
                "match": {
                  "seriesRegex": "/info|Information/"
                },
                "color": "#73BF69"
              },
              {
                "match": {
                  "seriesRegex": "/debug|Debug/"
                },
                "color": "#5794F2"
              },
              {
                "match": {
                  "seriesRegex": "/TRACE|Trace/"
                },
                "color": "#B877D9"
              }
            ],
            "display": {
              "reduce": "sum",
              "allValues": true,
              "fields": "/Count/",
              "pieType": "donut",
              "legendShow": [
                "value"
              ]
            }
          },
          {
            "id": "p3",
            "type": "table",
            "title": "Top Error Messages",
            "description": "Most frequent ERROR / WARN / FATAL bodies across the selected services. Common id-style tokens (userId, traceId, etc.) are stripped before grouping so similar messages cluster.",
            "gridPos": {
              "x": 12,
              "y": 6,
              "w": 12,
              "h": 5
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "SELECT\n  SeverityText AS Level,\n  ServiceName AS Service,\n  replaceRegexpAll(Body, '(userId|orderId|cartId|requestId|traceId|spanId|ctId)=[a-zA-Z0-9-]+', '\\1=…') AS Message,\n  count() AS Count\nFROM ${database}.otel_logs\nWHERE $__timeFilter(Timestamp)\n  AND SeverityText IN ('ERROR', 'WARN', 'FATAL', 'Error', 'Warning', 'error', 'warning', 'fatal', 'CRITICAL')\n  AND $__conditionalAll(ServiceName IN (${service:singlequote}), $service)\n  AND $__conditionalAll(positionCaseInsensitive(Body, '$search') > 0, $search)\nGROUP BY Level, Service, Message\nORDER BY Count DESC\nLIMIT 20"
              }
            ]
          }
        ]
      },
      {
        "id": "p200",
        "type": "row",
        "title": "$service",
        "gridPos": {
          "x": 0,
          "y": 11,
          "w": 24,
          "h": 1
        },
        "repeat": "service",
        "panels": [
          {
            "id": "p201",
            "type": "timeseries",
            "title": "Log Volume: $service",
            "description": "Log volume by SeverityText for $service.",
            "gridPos": {
              "x": 0,
              "y": 12,
              "w": 24,
              "h": 5
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "SELECT\n  toStartOfInterval(Timestamp, INTERVAL $__interval_s second) AS time,\n  SeverityText AS metric,\n  count() AS count\nFROM ${database}.otel_logs\nWHERE $__timeFilter(Timestamp)\n  AND ServiceName = ${service:singlequote}\n  AND $__conditionalAll(SeverityText IN (${level_filter:singlequote}), $level_filter)\n  AND $__conditionalAll(positionCaseInsensitive(Body, '$search') > 0, $search)\nGROUP BY time, metric\nORDER BY time"
              }
            ],
            "style": "bars",
            "fill": 80,
            "lineWidth": 0,
            "points": "never",
            "stack": "normal",
            "overrides": [
              {
                "match": {
                  "seriesRegex": "/fatal|FATAL/i"
                },
                "color": "#C4162A",
                "displayName": "fatal"
              },
              {
                "match": {
                  "seriesRegex": "/error|Error/i"
                },
                "color": "#F2495C",
                "displayName": "error"
              },
              {
                "match": {
                  "seriesRegex": "/warn|Warning/i"
                },
                "color": "#FF9830",
                "displayName": "warning"
              },
              {
                "match": {
                  "seriesRegex": "/info|Information/i"
                },
                "color": "#73BF69",
                "displayName": "info"
              },
              {
                "match": {
                  "seriesRegex": "/debug|Debug/i"
                },
                "color": "#5794F2",
                "displayName": "debug"
              },
              {
                "match": {
                  "seriesRegex": "/(?:^count )?TRACE$|(?:^count )?Trace$/i"
                },
                "color": "#B877D9",
                "displayName": "trace"
              }
            ],
            "interval": "${interval}",
            "display": {
              "legendValues": [
                "sum"
              ],
              "legendMode": "list",
              "tooltip": "all",
              "tooltipSort": "none"
            }
          },
          {
            "id": "p202",
            "type": "logs",
            "title": "Log Samples: $service",
            "description": "Recent log lines for $service. Click a row to expand attributes. JSON-shaped bodies are pretty-printed.",
            "gridPos": {
              "x": 0,
              "y": 17,
              "w": 24,
              "h": 14
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "SELECT\n  Timestamp AS timestamp,\n  Body AS body,\n  SeverityText AS level,\n  ServiceName,\n  TraceId,\n  SpanId,\n  ResourceAttributes['service.namespace'] AS namespace,\n  ResourceAttributes['k8s.pod.name'] AS k8s_pod\nFROM ${database}.otel_logs\nWHERE $__timeFilter(Timestamp)\n  AND ServiceName = ${service:singlequote}\n  AND $__conditionalAll(SeverityText IN (${level_filter:singlequote}), $level_filter)\n  AND $__conditionalAll(positionCaseInsensitive(Body, '$search') > 0, $search)\nORDER BY Timestamp DESC\nLIMIT 200",
                "format": "logs"
              }
            ],
            "display": {
              "wrap": true,
              "showTime": true,
              "showLabels": true,
              "prettify": true
            }
          }
        ]
      }
    ]
  }
}
