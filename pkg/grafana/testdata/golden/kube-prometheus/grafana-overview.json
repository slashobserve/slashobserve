  "spec": {
    "specVersion": "0",
    "title": "Grafana Overview",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timezone": "utc",
    "variables": [
      {
        "name": "datasource",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(grafana_build_info, job)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(grafana_build_info, instance)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ],
    "panels": [
      {
        "id": "p6",
        "type": "stat",
        "title": "Firing Alerts",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 5
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "grafana_alerting_result_total{job=~\"$job\", instance=~\"$instance\", state=\"alerting\"}",
            "instant": true,
            "interval": "1m"
          }
        ],
        "thresholds": [
          {
            "color": "ok"
          },
          {
            "value": 80,
            "color": "critical"
          }
        ],
        "noValue": "0",
        "display": {
          "reduce": "mean"
        }
      },
      {
        "id": "p8",
        "type": "stat",
        "title": "Dashboards",
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 5
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(grafana_stat_totals_dashboard{job=~\"$job\", instance=~\"$instance\"})",
            "interval": "1m"
          }
        ],
        "thresholds": [
          {
            "color": "ok"
          },
          {
            "value": 80,
            "color": "critical"
          }
        ],
        "display": {
          "reduce": "mean"
        }
      },
      {
        "id": "p10",
        "type": "table",
        "title": "Build Info",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 5
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "grafana_build_info{job=~\"$job\", instance=~\"$instance\"}",
            "instant": true,
            "interval": "1m"
          }
        ],
        "transform": [
          {
            "type": "merge"
          },
          {
            "type": "organize",
            "exclude": [
              "Time",
              "Value",
              "branch",
              "container",
              "goversion",
              "namespace",
              "pod",
              "revision"
            ],
            "order": [
              "job",
              "instance",
              "edition",
              "version",
              "branch",
              "revision",
              "goversion",
              "Time",
              "container",
              "namespace",
              "pod",
              "Value"
            ]
          }
        ]
      },
      {
        "id": "p2",
        "type": "timeseries",
        "title": "RPS",
        "gridPos": {
          "x": 0,
          "y": 5,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum by (status_code) (irate(grafana_http_request_duration_seconds_count{job=~\"$job\", instance=~\"$instance\"}[1m])) ",
            "legend": "{{status_code}}",
            "interval": "1m"
          }
        ],
        "unit": "reqps",
        "fill": 10,
        "stack": "normal",
        "display": {
          "tooltip": "all"
        }
      },
      {
        "id": "p4",
        "type": "timeseries",
        "title": "Request Latency",
        "gridPos": {
          "x": 12,
          "y": 5,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "histogram_quantile(0.99, sum(irate(grafana_http_request_duration_seconds_bucket{instance=~\"$instance\", job=~\"$job\"}[$__rate_interval])) by (le)) * 1",
            "legend": "99th Percentile",
            "interval": "1m"
          },
          {
            "query": "histogram_quantile(0.50, sum(irate(grafana_http_request_duration_seconds_bucket{instance=~\"$instance\", job=~\"$job\"}[$__rate_interval])) by (le)) * 1",
            "legend": "50th Percentile",
            "interval": "1m"
          },
          {
            "query": "sum(irate(grafana_http_request_duration_seconds_sum{instance=~\"$instance\", job=~\"$job\"}[$__rate_interval])) * 1 / sum(irate(grafana_http_request_duration_seconds_count{instance=~\"$instance\", job=~\"$job\"}[$__rate_interval]))",
            "legend": "Average",
            "interval": "1m"
          }
        ],
        "unit": "ms",
        "fill": 10,
        "display": {
          "tooltip": "all"
        }
      }
    ]
  }
