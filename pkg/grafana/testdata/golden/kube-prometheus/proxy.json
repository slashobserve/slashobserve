      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(up{job=\"kube-proxy\"}, cluster)",
        "sort": "alpha",
        "refresh": "timeRange"
      },
      {
        "name": "instance",
        "label": "instance",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(up{job=\"kube-proxy\", cluster=\"$cluster\", job=\"kube-proxy\"}, instance)",
        "refresh": "timeRange",
        "includeAll": true,
        "allValue": ".+"
      }
    ],
    "panels": [
      {
        "id": "p1",
        "type": "stat",
        "title": "Up",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 4,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(up{cluster=\"$cluster\", job=\"kube-proxy\"})",
            "instant": true
