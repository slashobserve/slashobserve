  "spec": {
    "specVersion": "0",
    "title": "Kubernetes / API server",
    "tags": [
      "kubernetes-mixin"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "10s",
    "timezone": "utc",
    "variables": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(up{job=\"apiserver\"}, cluster)",
        "sort": "alpha",
        "refresh": "timeRange"
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(up{job=\"apiserver\", cluster=\"$cluster\"}, instance)",
        "sort": "alpha",
        "refresh": "timeRange",
        "includeAll": true
      }
    ],
    "panels": [
      {
        "id": "p1",
        "type": "text",
        "title": "Notice",
        "description": "The SLO (service level objective) and other metrics displayed on this dashboard are for informational purposes only.",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 2
        },
        "content": "The SLO (service level objective) and other metrics displayed on this dashboard are for informational purposes only."
      },
      {
        "id": "p2",
        "type": "stat",
        "title": "Availability (30d) > 99.000%",
        "description": "How many percent of requests (both read and write) in 30 days have been answered successfully and fast enough?",
        "gridPos": {
          "x": 0,
          "y": 2,
          "w": 8,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "apiserver_request:availability30d{verb=\"all\", cluster=\"$cluster\"}"
          }
        ],
        "unit": "percentunit",
        "decimals": 3,
        "interval": "1m"
      },
      {
        "id": "p3",
        "type": "timeseries",
        "title": "Error Budget (30d) > 99.000%",
        "description": "How much error budget is left looking at our 99.000% availability guarantee?",
        "gridPos": {
          "x": 8,
          "y": 2,
          "w": 16,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "100 * (apiserver_request:availability30d{verb=\"all\", cluster=\"$cluster\"} - 0.990000)",
            "legend": "error budget"
          }
        ],
        "unit": "percentunit",
        "decimals": 3,
        "fill": 100,
        "interval": "1m",
        "display": {
          "legend": "right"
        }
      },
      {
        "id": "p4",
        "type": "stat",
        "title": "Read Availability (30d)",
        "description": "How many percent of read requests (LIST,GET) in 30 days have been answered successfully and fast enough?",
        "gridPos": {
          "x": 0,
          "y": 9,
          "w": 6,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "apiserver_request:availability30d{verb=\"read\", cluster=\"$cluster\"}"
          }
        ],
        "unit": "percentunit",
        "decimals": 3,
        "interval": "1m"
      },
      {
        "id": "p5",
        "type": "timeseries",
        "title": "Read SLI - Requests",
        "description": "How many read requests (LIST,GET) per second do the apiservers get by code?",
        "gridPos": {
          "x": 6,
          "y": 9,
          "w": 6,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum by (code) (code_resource:apiserver_request_total:rate5m{verb=\"read\", cluster=\"$cluster\"})",
            "legend": "{{ code }}"
          }
        ],
        "unit": "reqps",
        "fill": 100,
        "stack": "normal",
        "interval": "1m",
        "display": {
          "legend": "right"
        }
      },
      {
        "id": "p6",
        "type": "timeseries",
        "title": "Read SLI - Errors",
        "description": "How many percent of read requests (LIST,GET) per second are returned with errors (5xx)?",
        "gridPos": {
          "x": 12,
          "y": 9,
          "w": 6,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum by (resource) (code_resource:apiserver_request_total:rate5m{verb=\"read\",code=~\"5..\", cluster=\"$cluster\"}) / sum by (resource) (code_resource:apiserver_request_total:rate5m{verb=\"read\", cluster=\"$cluster\"})",
            "legend": "{{ resource }}"
          }
        ],
        "unit": "percentunit",
        "min": 0,
        "interval": "1m",
        "display": {
          "legend": "right"
        }
      },
      {
        "id": "p7",
        "type": "timeseries",
        "title": "Read SLI - Duration",
        "description": "How many seconds is the 99th percentile for reading (LIST|GET) a given resource?",
        "gridPos": {
          "x": 18,
          "y": 9,
          "w": 6,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "cluster_quantile:apiserver_request_sli_duration_seconds:histogram_quantile{verb=\"read\", cluster=\"$cluster\"}",
            "legend": "{{ resource }}"
          }
        ],
        "unit": "s",
        "interval": "1m",
        "display": {
          "legend": "right"
        }
      },
      {
        "id": "p8",
        "type": "stat",
        "title": "Write Availability (30d)",
        "description": "How many percent of write requests (POST|PUT|PATCH|DELETE) in 30 days have been answered successfully and fast enough?",
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 6,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "apiserver_request:availability30d{verb=\"write\", cluster=\"$cluster\"}"
          }
        ],
        "unit": "percentunit",
        "decimals": 3,
        "interval": "1m"
      },
      {
        "id": "p9",
        "type": "timeseries",
        "title": "Write SLI - Requests",
        "description": "How many write requests (POST|PUT|PATCH|DELETE) per second do the apiservers get by code?",
        "gridPos": {
          "x": 6,
          "y": 16,
          "w": 6,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum by (code) (code_resource:apiserver_request_total:rate5m{verb=\"write\", cluster=\"$cluster\"})",
            "legend": "{{ code }}"
          }
        ],
        "unit": "reqps",
        "fill": 100,
        "stack": "normal",
        "interval": "1m",
        "display": {
          "legend": "right"
        }
      },
      {
        "id": "p10",
        "type": "timeseries",
        "title": "Write SLI - Errors",
        "description": "How many percent of write requests (POST|PUT|PATCH|DELETE) per second are returned with errors (5xx)?",
        "gridPos": {
          "x": 12,
          "y": 16,
          "w": 6,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum by (resource) (code_resource:apiserver_request_total:rate5m{verb=\"write\",code=~\"5..\", cluster=\"$cluster\"}) / sum by (resource) (code_resource:apiserver_request_total:rate5m{verb=\"write\", cluster=\"$cluster\"})",
            "legend": "{{ resource }}"
          }
        ],
        "unit": "percentunit",
        "min": 0,
        "interval": "1m",
        "display": {
          "legend": "right"
        }
      },
      {
        "id": "p11",
        "type": "timeseries",
        "title": "Write SLI - Duration",
        "description": "How many seconds is the 99th percentile for writing (POST|PUT|PATCH|DELETE) a given resource?",
        "gridPos": {
          "x": 18,
          "y": 16,
          "w": 6,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "cluster_quantile:apiserver_request_sli_duration_seconds:histogram_quantile{verb=\"write\", cluster=\"$cluster\"}",
            "legend": "{{ resource }}"
          }
        ],
        "unit": "s",
        "interval": "1m",
        "display": {
          "legend": "right"
        }
      },
      {
        "id": "p12",
        "type": "timeseries",
        "title": "Work Queue Add Rate",
        "gridPos": {
          "x": 0,
          "y": 23,
          "w": 12,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(rate(workqueue_adds_total{job=\"apiserver\", instance=~\"$instance\", cluster=\"$cluster\"}[$__rate_interval])) by (instance, name)",
            "legend": "{{instance}} {{name}}"
          }
        ],
        "unit": "ops",
        "min": 0,
        "interval": "1m",
        "display": {
          "legend": "hidden"
        }
      },
      {
        "id": "p13",
        "type": "timeseries",
        "title": "Work Queue Depth",
        "gridPos": {
          "x": 12,
          "y": 23,
          "w": 12,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(rate(workqueue_depth{job=\"apiserver\", instance=~\"$instance\", cluster=\"$cluster\"}[$__rate_interval])) by (instance, name)",
            "legend": "{{instance}} {{name}}"
          }
        ],
        "unit": "short",
        "min": 0,
        "interval": "1m",
        "display": {
          "legend": "hidden"
        }
      },
      {
        "id": "p14",
        "type": "timeseries",
        "title": "Work Queue Latency",
        "gridPos": {
          "x": 0,
          "y": 30,
          "w": 24,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "histogram_quantile(0.99, sum(rate(workqueue_queue_duration_seconds_bucket{job=\"apiserver\", instance=~\"$instance\", cluster=\"$cluster\"}[$__rate_interval])) by (instance, name, le))",
            "legend": "{{instance}} {{name}}"
          }
        ],
        "unit": "s",
        "min": 0,
        "interval": "1m",
        "display": {
          "legend": "right",
          "legendValues": [
            "lastNotNull"
          ]
        }
      },
      {
        "id": "p15",
        "type": "timeseries",
        "title": "Memory",
        "gridPos": {
          "x": 0,
          "y": 37,
          "w": 8,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "process_resident_memory_bytes{job=\"apiserver\",instance=~\"$instance\", cluster=\"$cluster\"}",
            "legend": "{{instance}}"
          }
        ],
        "unit": "bytes",
        "interval": "1m",
        "display": {
          "legend": "right"
        }
      },
      {
        "id": "p16",
        "type": "timeseries",
        "title": "CPU usage",
        "gridPos": {
          "x": 8,
          "y": 37,
          "w": 8,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "rate(process_cpu_seconds_total{job=\"apiserver\",instance=~\"$instance\", cluster=\"$cluster\"}[$__rate_interval])",
            "legend": "{{instance}}"
          }
        ],
        "unit": "short",
        "min": 0,
        "interval": "1m",
        "display": {
          "legend": "right"
        }
      },
      {
        "id": "p17",
        "type": "timeseries",
        "title": "Goroutines",
        "gridPos": {
          "x": 16,
          "y": 37,
          "w": 8,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "go_goroutines{job=\"apiserver\",instance=~\"$instance\", cluster=\"$cluster\"}",
            "legend": "{{instance}}"
          }
        ],
        "unit": "short",
        "interval": "1m",
        "display": {
          "legend": "right"
        }
      }
    ]
  }
}
