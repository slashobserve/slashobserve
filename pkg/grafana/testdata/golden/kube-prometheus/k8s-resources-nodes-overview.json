  "spec": {
    "specVersion": "0",
    "title": "Kubernetes / Compute Resources / Nodes Overview",
    "tags": [
      "kubernetes-mixin"
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "refresh": "10s",
    "timezone": "utc",
    "variables": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(up{job=\"kube-state-metrics\"}, cluster)",
        "sort": "alpha",
        "refresh": "timeRange",
        "allowCustomValue": true
      }
    ],
    "links": [
      {
        "type": "dashboards",
        "title": "Kubernetes",
        "tags": [
          "kubernetes-mixin"
        ],
        "asDropdown": true,
        "keepTime": true,
        "includeVars": true
      }
    ],
    "panels": [
      {
        "id": "p1",
        "type": "timeseries",
        "title": "Node & Pod Count",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "count(kube_node_info{cluster=\"$cluster\", job=\"kube-state-metrics\"})",
            "legend": "nodes"
          },
          {
            "query": "sum(kubelet_running_pods{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\"})",
            "legend": "pods"
          }
        ],
        "unit": "short",
        "decimals": 0,
        "points": "never",
        "spanNulls": true,
        "overrides": [
          {
            "match": {
              "series": "pods"
            },
            "axis": "right",
            "axisSoftMin": 0
          }
        ],
        "interval": "1m",
        "display": {
          "legend": "right",
          "legendValues": [
            "lastNotNull"
          ]
        }
      },
      {
        "id": "p2",
        "type": "timeseries",
        "title": "CPU Usage",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 24,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(kube_node_status_allocatable{cluster=\"$cluster\", job=\"kube-state-metrics\", resource=\"cpu\"})",
            "legend": "allocatable"
          },
          {
            "query": "sum(cluster:namespace:pod_cpu:active:kube_pod_container_resource_requests{cluster=\"$cluster\"})",
            "legend": "requests"
          },
          {
            "query": "sum(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_rate5m{cluster=\"$cluster\"})",
            "legend": "usage"
          }
        ],
        "unit": "short",
        "fill": 10,
        "points": "never",
        "spanNulls": true,
        "interval": "1m",
        "display": {
          "legend": "right",
          "legendValues": [
            "lastNotNull"
          ]
        }
      },
      {
        "id": "p3",
        "type": "timeseries",
        "title": "Memory Usage",
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 24,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(kube_node_status_allocatable{cluster=\"$cluster\", job=\"kube-state-metrics\", resource=\"memory\"})",
            "legend": "allocatable"
          },
          {
            "query": "sum(cluster:namespace:pod_memory:active:kube_pod_container_resource_requests{cluster=\"$cluster\"})",
            "legend": "requests"
          },
          {
            "query": "sum(node_namespace_pod_container:container_memory_working_set_bytes{cluster=\"$cluster\", container!=\"\"})",
            "legend": "usage"
          }
        ],
        "unit": "bytes",
        "fill": 10,
        "points": "never",
        "spanNulls": true,
        "interval": "1m",
        "display": {
          "legend": "right",
          "legendValues": [
            "lastNotNull"
          ]
        }
      },
      {
        "id": "p4",
        "type": "timeseries",
        "title": "CPU Utilization per Node",
        "gridPos": {
          "x": 0,
          "y": 24,
          "w": 24,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum by (node) (node_namespace_pod_container:container_cpu_usage_seconds_total:sum_rate5m{cluster=\"$cluster\"})\n/\nsum by (node) (kube_node_status_allocatable{cluster=\"$cluster\", job=\"kube-state-metrics\", resource=\"cpu\"})\n",
            "legend": "{{node}}"
          }
        ],
        "unit": "percentunit",
        "fill": 10,
        "points": "never",
        "spanNulls": true,
        "interval": "1m",
        "display": {
          "legend": "right",
          "legendValues": [
            "lastNotNull"
          ]
        }
      },
      {
        "id": "p5",
        "type": "timeseries",
        "title": "Memory Utilization per Node",
        "gridPos": {
          "x": 0,
          "y": 32,
          "w": 24,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum by (node) (node_namespace_pod_container:container_memory_working_set_bytes{cluster=\"$cluster\", container!=\"\"})\n/\nsum by (node) (kube_node_status_allocatable{cluster=\"$cluster\", job=\"kube-state-metrics\", resource=\"memory\"})\n",
            "legend": "{{node}}"
          }
        ],
        "unit": "percentunit",
        "fill": 10,
        "points": "never",
        "spanNulls": true,
        "interval": "1m",
        "display": {
          "legend": "right",
          "legendValues": [
            "lastNotNull"
          ]
        }
      }
    ]
