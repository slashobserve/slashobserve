  "spec": {
    "specVersion": "0",
    "title": "Kubernetes / Kubelet",
    "tags": [
      "kubernetes-mixin"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "10s",
    "timezone": "utc",
    "variables": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(up{job=\"kubelet\", metrics_path=\"/metrics\"}, cluster)",
        "sort": "alpha",
        "refresh": "timeRange"
      },
      {
        "name": "instance",
        "label": "instance",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(up{job=\"kubelet\", metrics_path=\"/metrics\",cluster=\"$cluster\"}, instance)",
        "refresh": "timeRange",
        "includeAll": true
      }
    ],
    "panels": [
      {
        "id": "p1",
        "type": "stat",
        "title": "Running Kubelets",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 4,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(kubelet_node_name{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\"})",
            "instant": true
          }
        ],
        "unit": "none",
        "interval": "1m",
        "display": {
          "colorMode": "none"
        }
      },
      {
        "id": "p2",
        "type": "stat",
        "title": "Running Pods",
        "gridPos": {
          "x": 4,
          "y": 0,
          "w": 4,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(kubelet_running_pods{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\", instance=~\"$instance\"})",
            "instant": true
          }
        ],
        "unit": "none",
        "interval": "1m",
        "display": {
          "colorMode": "none"
        }
      },
      {
        "id": "p3",
        "type": "stat",
        "title": "Running Containers",
        "gridPos": {
          "x": 8,
          "y": 0,
          "w": 4,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(kubelet_running_containers{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\", container_state=\"running\", instance=~\"$instance\"})",
            "instant": true
          }
        ],
        "unit": "none",
        "interval": "1m",
        "display": {
          "colorMode": "none"
        }
      },
      {
        "id": "p4",
        "type": "stat",
        "title": "Actual Volume Count",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 4,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(volume_manager_total_volumes{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\", instance=~\"$instance\", state=\"actual_state_of_world\"})",
            "instant": true
          }
        ],
        "unit": "none",
        "interval": "1m",
        "display": {
          "colorMode": "none"
        }
      },
      {
        "id": "p5",
        "type": "stat",
        "title": "Desired Volume Count",
        "gridPos": {
          "x": 16,
          "y": 0,
          "w": 4,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(volume_manager_total_volumes{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\", instance=~\"$instance\",state=\"desired_state_of_world\"})",
            "instant": true
          }
        ],
        "unit": "none",
        "interval": "1m",
        "display": {
          "colorMode": "none"
        }
      },
      {
        "id": "p6",
        "type": "stat",
        "title": "Config Error Count",
        "gridPos": {
          "x": 20,
          "y": 0,
          "w": 4,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(rate(kubelet_node_config_error{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\", instance=~\"$instance\"}[$__rate_interval]))",
            "instant": true
          }
        ],
        "unit": "none",
        "interval": "1m",
        "display": {
          "colorMode": "none"
        }
      },
      {
        "id": "p7",
        "type": "timeseries",
        "title": "Operation Rate",
        "gridPos": {
          "x": 0,
          "y": 7,
          "w": 12,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(rate(kubelet_runtime_operations_total{cluster=\"$cluster\",job=\"kubelet\", metrics_path=\"/metrics\",instance=~\"$instance\"}[$__rate_interval])) by (operation_type, instance)",
            "legend": "{{instance}} {{operation_type}}"
          }
        ],
        "unit": "ops",
        "fill": 10,
        "points": "never",
        "spanNulls": true,
        "interval": "1m",
        "display": {
          "legend": "right",
          "legendValues": [
            "lastNotNull"
          ]
        }
      },
      {
        "id": "p8",
        "type": "timeseries",
        "title": "Operation Error Rate",
        "gridPos": {
          "x": 12,
          "y": 7,
          "w": 12,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(rate(kubelet_runtime_operations_errors_total{cluster=\"$cluster\",job=\"kubelet\", metrics_path=\"/metrics\",instance=~\"$instance\"}[$__rate_interval])) by (instance, operation_type)",
            "legend": "{{instance}} {{operation_type}}"
          }
        ],
        "unit": "ops",
        "fill": 10,
        "points": "never",
        "spanNulls": true,
        "interval": "1m",
        "display": {
          "legend": "right",
          "legendValues": [
            "lastNotNull"
          ]
        }
      },
      {
        "id": "p9",
        "type": "timeseries",
        "title": "Operation Duration 99th quantile",
        "gridPos": {
          "x": 0,
          "y": 14,
          "w": 24,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "histogram_quantile(0.99, sum(rate(kubelet_runtime_operations_duration_seconds_bucket{cluster=\"$cluster\",job=\"kubelet\", metrics_path=\"/metrics\",instance=~\"$instance\"}[$__rate_interval])) by (instance, operation_type, le))",
            "legend": "{{instance}} {{operation_type}}"
          }
        ],
        "unit": "s",
        "fill": 10,
        "points": "never",
        "spanNulls": true,
        "interval": "1m",
        "display": {
          "legend": "right",
          "legendValues": [
            "lastNotNull"
          ]
        }
      },
      {
        "id": "p10",
        "type": "timeseries",
        "title": "Pod Start Rate",
        "gridPos": {
          "x": 0,
          "y": 21,
          "w": 12,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(rate(kubelet_pod_start_duration_seconds_count{cluster=\"$cluster\",job=\"kubelet\", metrics_path=\"/metrics\",instance=~\"$instance\"}[$__rate_interval])) by (instance)",
            "legend": "{{instance}} pod"
          },
          {
            "query": "sum(rate(kubelet_pod_worker_duration_seconds_count{cluster=\"$cluster\",job=\"kubelet\", metrics_path=\"/metrics\",instance=~\"$instance\"}[$__rate_interval])) by (instance)",
            "legend": "{{instance}} worker"
          }
        ],
        "unit": "ops",
        "fill": 10,
        "points": "never",
        "spanNulls": true,
        "interval": "1m",
        "display": {
          "legend": "right",
          "legendValues": [
            "lastNotNull"
          ]
        }
      },
      {
        "id": "p11",
        "type": "timeseries",
        "title": "Pod Start Duration",
        "gridPos": {
          "x": 12,
          "y": 21,
          "w": 12,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "histogram_quantile(0.99, sum(rate(kubelet_pod_start_duration_seconds_bucket{cluster=\"$cluster\",job=\"kubelet\", metrics_path=\"/metrics\",instance=~\"$instance\"}[$__rate_interval])) by (instance, le))",
            "legend": "{{instance}} pod"
          },
          {
            "query": "histogram_quantile(0.99, sum(rate(kubelet_pod_worker_duration_seconds_bucket{cluster=\"$cluster\",job=\"kubelet\", metrics_path=\"/metrics\",instance=~\"$instance\"}[$__rate_interval])) by (instance, le))",
            "legend": "{{instance}} worker"
          }
        ],
        "unit": "s",
        "fill": 10,
        "points": "never",
        "spanNulls": true,
        "interval": "1m",
        "display": {
          "legend": "right",
          "legendValues": [
            "lastNotNull"
          ]
        }
