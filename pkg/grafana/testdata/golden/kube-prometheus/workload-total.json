  "spec": {
    "specVersion": "0",
    "title": "Kubernetes / Networking / Workload",
    "tags": [
      "kubernetes-mixin"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "10s",
    "timezone": "utc",
    "variables": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": "prom",
        "query": "label_values(kube_pod_info{job=\"kube-state-metrics\"}, cluster)",
        "sort": "alpha",
        "refresh": "timeRange"
      },
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": "prom",
        "query": "label_values(container_network_receive_packets_total{cluster=\"$cluster\"}, namespace)",
        "sort": "alpha",
        "refresh": "timeRange",
        "includeAll": true,
        "allValue": ".+",
        "default": "kube-system"
      },
      {
        "name": "workload",
        "label": "workload",
        "type": "query",
        "datasource": "prom",
        "query": "label_values(namespace_workload_pod:kube_pod_owner:relabel{cluster=\"$cluster\", namespace=~\"$namespace\", workload=~\".+\"}, workload)",
        "sort": "alpha",
        "refresh": "timeRange"
      },
      {
        "name": "type",
        "label": "workload_type",
        "type": "query",
        "datasource": "prom",
        "query": "label_values(namespace_workload_pod:kube_pod_owner:relabel{cluster=\"$cluster\", namespace=~\"$namespace\", workload=~\"$workload\"}, workload_type)",
        "sort": "alpha",
        "refresh": "timeRange",
        "includeAll": true,
        "allValue": ".+"
      }
    ],
    "panels": [
      {
        "id": "p1",
