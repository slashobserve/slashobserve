  "spec": {
    "specVersion": "0",
    "title": "Prometheus / Remote Write",
    "tags": [
      "prometheus-mixin"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timezone": "utc",
    "variables": [
      {
        "name": "datasource",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(prometheus_build_info, cluster)",
        "refresh": "timeRange",
        "includeAll": true
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(prometheus_build_info{cluster=~\"$cluster\"}, instance)",
        "refresh": "timeRange",
        "includeAll": true
      },
      {
        "name": "url",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(prometheus_remote_storage_shards{cluster=~\"$cluster\", instance=~\"$instance\"}, url)",
        "refresh": "timeRange",
        "includeAll": true
      }
    ],
    "panels": [
      {
        "id": "p1",
        "type": "row",
        "title": "Timestamps",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p2",
            "type": "timeseries",
            "title": "Highest Enqueued Timestamp vs. Highest Timestamp Sent",
            "gridPos": {
              "x": 0,
              "y": 1,
              "w": 12,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "(\n  prometheus_remote_storage_queue_highest_timestamp_seconds{cluster=~\"$cluster\", instance=~\"$instance\", url=~\"$url\"}\n-\n  prometheus_remote_storage_queue_highest_sent_timestamp_seconds{cluster=~\"$cluster\", instance=~\"$instance\", url=~\"$url\"}\n)\n",
                "legend": "{{cluster}}::{{instance}} {{remote_name}}:{{url}}"
              }
            ],
            "unit": "short",
            "fill": 10,
            "display": {
              "tooltip": "all"
            }
          },
          {
            "id": "p3",
            "type": "timeseries",
            "title": "Rate[5m]",
            "gridPos": {
              "x": 12,
              "y": 1,
              "w": 12,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "clamp_min(\n  rate(prometheus_remote_storage_queue_highest_timestamp_seconds{cluster=~\"$cluster\", instance=~\"$instance\", url=~\"$url\"}[5m])\n-\n  rate(prometheus_remote_storage_queue_highest_sent_timestamp_seconds{cluster=~\"$cluster\", instance=~\"$instance\", url=~\"$url\"}[5m])\n, 0)\n",
                "legend": "{{cluster}}:{{instance}} {{remote_name}}:{{url}}"
              }
            ],
            "unit": "short",
            "fill": 10,
            "display": {
              "tooltip": "all"
            }
          }
        ]
      },
      {
        "id": "p4",
        "type": "row",
        "title": "Samples",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 24,
