  "spec": {
    "specVersion": "0",
    "title": "Kubernetes / Persistent Volumes",
    "tags": [
      "kubernetes-mixin"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "10s",
    "timezone": "utc",
    "variables": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(kubelet_volume_stats_capacity_bytes{job=\"kubelet\", metrics_path=\"/metrics\"}, cluster)",
        "sort": "alpha",
        "refresh": "timeRange"
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(kubelet_volume_stats_capacity_bytes{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\"}, namespace)",
        "sort": "alpha",
        "refresh": "timeRange"
      },
      {
        "name": "volume",
        "label": "PersistentVolumeClaim",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(kubelet_volume_stats_capacity_bytes{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\", namespace=\"$namespace\"}, persistentvolumeclaim)",
        "sort": "alpha",
        "refresh": "timeRange"
      }
    ],
    "panels": [
      {
        "id": "p1",
        "type": "timeseries",
        "title": "Volume Space Usage",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 18,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "(\n  sum without(instance, node) (topk(1, (kubelet_volume_stats_capacity_bytes{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\", namespace=\"$namespace\", persistentvolumeclaim=\"$volume\"})))\n  -\n  sum without(instance, node) (topk(1, (kubelet_volume_stats_available_bytes{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\", namespace=\"$namespace\", persistentvolumeclaim=\"$volume\"})))\n)\n",
            "legend": "Used Space"
          },
          {
            "query": "sum without(instance, node) (topk(1, (kubelet_volume_stats_available_bytes{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\", namespace=\"$namespace\", persistentvolumeclaim=\"$volume\"})))\n",
            "legend": "Free Space"
          }
        ],
        "unit": "bytes",
        "fill": 10,
        "interval": "1m",
        "display": {
          "legend": "right",
          "legendValues": [
            "lastNotNull"
          ]
        }
      },
      {
        "id": "p2",
        "type": "gauge",
        "title": "Volume Space Usage",
        "gridPos": {
          "x": 18,
          "y": 0,
          "w": 6,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "max without(instance,node) (\n(\n  topk(1, kubelet_volume_stats_capacity_bytes{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\", namespace=\"$namespace\", persistentvolumeclaim=\"$volume\"})\n  -\n  topk(1, kubelet_volume_stats_available_bytes{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\", namespace=\"$namespace\", persistentvolumeclaim=\"$volume\"})\n)\n/\ntopk(1, kubelet_volume_stats_capacity_bytes{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\", namespace=\"$namespace\", persistentvolumeclaim=\"$volume\"})\n* 100)\n",
            "instant": true
          }
        ],
        "unit": "percent",
        "min": 0,
        "max": 100,
        "thresholds": [
          {
            "color": "ok"
          },
          {
            "value": 80,
            "color": "warning"
          },
          {
            "value": 90,
            "color": "critical"
          }
        ],
        "interval": "1m"
      },
      {
        "id": "p3",
        "type": "timeseries",
        "title": "Volume inodes Usage",
        "gridPos": {
          "x": 0,
          "y": 7,
          "w": 18,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum without(instance, node) (topk(1, (kubelet_volume_stats_inodes_used{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\", namespace=\"$namespace\", persistentvolumeclaim=\"$volume\"})))",
            "legend": "Used inodes"
          },
          {
            "query": "(\n  sum without(instance, node) (topk(1, (kubelet_volume_stats_inodes{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\", namespace=\"$namespace\", persistentvolumeclaim=\"$volume\"})))\n  -\n  sum without(instance, node) (topk(1, (kubelet_volume_stats_inodes_used{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\", namespace=\"$namespace\", persistentvolumeclaim=\"$volume\"})))\n)\n",
            "legend": "Free inodes"
          }
        ],
        "unit": "none",
        "fill": 10,
        "interval": "1m",
        "display": {
          "legend": "right",
          "legendValues": [
            "lastNotNull"
          ]
        }
      },
      {
        "id": "p4",
        "type": "gauge",
        "title": "Volume inodes Usage",
        "gridPos": {
          "x": 18,
          "y": 7,
          "w": 6,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "max without(instance,node) (\ntopk(1, kubelet_volume_stats_inodes_used{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\", namespace=\"$namespace\", persistentvolumeclaim=\"$volume\"})\n/\ntopk(1, kubelet_volume_stats_inodes{cluster=\"$cluster\", job=\"kubelet\", metrics_path=\"/metrics\", namespace=\"$namespace\", persistentvolumeclaim=\"$volume\"})\n* 100)\n",
            "instant": true
          }
        ],
        "unit": "percent",
        "min": 0,
        "max": 100,
        "thresholds": [
          {
            "color": "ok"
          },
          {
            "value": 80,
            "color": "warning"
          },
          {
            "value": 90,
            "color": "critical"
          }
        ],
        "interval": "1m"
      }
    ]
  }
