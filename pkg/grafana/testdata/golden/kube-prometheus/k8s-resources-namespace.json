  "spec": {
    "specVersion": "0",
    "title": "Kubernetes / Compute Resources / Namespace (Pods)",
    "tags": [
      "kubernetes-mixin"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "10s",
    "timezone": "utc",
    "variables": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(up{job=\"kube-state-metrics\"}, cluster)",
        "sort": "alpha",
        "refresh": "timeRange"
      },
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(kube_namespace_status_phase{job=\"kube-state-metrics\", cluster=\"$cluster\"}, namespace)",
        "sort": "alpha",
        "refresh": "timeRange"
      }
    ],
    "panels": [
      {
        "id": "p1",
        "type": "stat",
        "title": "CPU Utilisation (from requests)",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 3
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(max by (cluster, namespace, pod, container)(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_rate5m{cluster=\"$cluster\", namespace=\"$namespace\"})) / sum(kube_pod_container_resource_requests{job=\"kube-state-metrics\", cluster=\"$cluster\", namespace=\"$namespace\", resource=\"cpu\"})",
            "instant": true
          }
        ],
        "unit": "percentunit",
        "interval": "1m",
        "display": {
          "colorMode": "none"
        }
      },
      {
        "id": "p2",
        "type": "stat",
        "title": "CPU Utilisation (from limits)",
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 3
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(max by (cluster, namespace, pod, container)(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_rate5m{cluster=\"$cluster\", namespace=\"$namespace\"})) / sum(kube_pod_container_resource_limits{job=\"kube-state-metrics\", cluster=\"$cluster\", namespace=\"$namespace\", resource=\"cpu\"})",
            "instant": true
          }
        ],
        "unit": "percentunit",
        "interval": "1m",
        "display": {
          "colorMode": "none"
        }
      },
      {
        "id": "p3",
        "type": "stat",
        "title": "Memory Utilisation (from requests)",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 6,
          "h": 3
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(max by (cluster, namespace, pod, container)(container_memory_working_set_bytes{job=\"kubelet\", metrics_path=\"/metrics/cadvisor\", cluster=\"$cluster\", namespace=\"$namespace\",container!=\"\", image!=\"\"})) / sum(kube_pod_container_resource_requests{job=\"kube-state-metrics\", cluster=\"$cluster\", namespace=\"$namespace\", resource=\"memory\"})",
            "instant": true
          }
        ],
        "unit": "percentunit",
        "interval": "1m",
        "display": {
          "colorMode": "none"
        }
      },
      {
        "id": "p4",
        "type": "stat",
        "title": "Memory Utilisation (from limits)",
        "gridPos": {
          "x": 18,
          "y": 0,
          "w": 6,
          "h": 3
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(max by (cluster, namespace, pod, container)(container_memory_working_set_bytes{job=\"kubelet\", metrics_path=\"/metrics/cadvisor\", cluster=\"$cluster\", namespace=\"$namespace\",container!=\"\", image!=\"\"})) / sum(kube_pod_container_resource_limits{job=\"kube-state-metrics\", cluster=\"$cluster\", namespace=\"$namespace\", resource=\"memory\"})",
            "instant": true
          }
        ],
        "unit": "percentunit",
        "interval": "1m",
        "display": {
          "colorMode": "none"
        }
      },
      {
        "id": "p5",
        "type": "timeseries",
        "title": "CPU Usage",
        "gridPos": {
          "x": 0,
          "y": 3,
          "w": 24,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(max by (cluster, namespace, pod, container)(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_rate5m{cluster=\"$cluster\", namespace=\"$namespace\"})) by (pod)",
            "legend": "__auto"
          },
          {
            "query": "scalar(max(kube_resourcequota{cluster=\"$cluster\", namespace=\"$namespace\", type=\"hard\",resource=\"requests.cpu\"}))",
            "legend": "quota - requests"
          },
          {
            "query": "scalar(max(kube_resourcequota{cluster=\"$cluster\", namespace=\"$namespace\", type=\"hard\",resource=\"limits.cpu\"}))",
            "legend": "quota - limits"
          }
        ],
        "fill": 10,
        "interval": "1m",
        "display": {
          "legend": "right",
          "legendValues": [
            "lastNotNull"
          ]
        }
      },
      {
        "id": "p6",
        "type": "table",
        "title": "CPU Quota",
        "gridPos": {
          "x": 0,
          "y": 10,
          "w": 24,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(max by (cluster, namespace, pod, container)(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_rate5m{cluster=\"$cluster\", namespace=\"$namespace\"})) by (pod)",
            "instant": true,
            "format": "table"
          },
          {
            "query": "sum(max by (cluster, namespace, pod, container)(cluster:namespace:pod_cpu:active:kube_pod_container_resource_requests{cluster=\"$cluster\", namespace=\"$namespace\"})) by (pod)",
            "instant": true,
            "format": "table"
          },
          {
            "query": "sum(max by (cluster, namespace, pod, container)(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_rate5m{cluster=\"$cluster\", namespace=\"$namespace\"})) by (pod) / sum(max by (cluster, namespace, pod, container)(cluster:namespace:pod_cpu:active:kube_pod_container_resource_requests{cluster=\"$cluster\", namespace=\"$namespace\"})) by (pod)",
            "instant": true,
            "format": "table"
          },
          {
            "query": "sum(max by (cluster, namespace, pod, container)(cluster:namespace:pod_cpu:active:kube_pod_container_resource_limits{cluster=\"$cluster\", namespace=\"$namespace\"})) by (pod)",
            "instant": true,
            "format": "table"
          },
          {
            "query": "sum(max by (cluster, namespace, pod, container)(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_rate5m{cluster=\"$cluster\", namespace=\"$namespace\"})) by (pod) / sum(max by (cluster, namespace, pod, container)(cluster:namespace:pod_cpu:active:kube_pod_container_resource_limits{cluster=\"$cluster\", namespace=\"$namespace\"})) by (pod)",
            "instant": true,
            "format": "table"
          }
        ],
        "overrides": [
          {
            "match": {
              "seriesRegex": "/%/"
            },
            "unit": "percentunit"
          },
          {
            "match": {
              "field": "Pod"
            },
            "links": [
              {
                "title": "Drill down to pods",
                "url": "/d/6581e46e4e5c7ba40a07646395ef7b23?${datasource:queryparam}&var-cluster=$cluster&var-namespace=$namespace&var-pod=${__data.fields.Pod}"
              }
            ]
          }
        ],
        "transform": [
          {
            "type": "joinByField",
            "mode": "outer",
            "field": "pod"
          },
          {
            "type": "organize",
            "exclude": [
              "Time",
              "Time 1",
              "Time 2",
              "Time 3",
              "Time 4",
              "Time 5"
            ],
            "rename": {
