    "variables": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(up{job=\"kube-state-metrics\"}, cluster)",
        "sort": "alpha",
        "refresh": "timeRange"
      },
      {
        "name": "node",
        "label": "node",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(kube_node_info{cluster=\"$cluster\"}, node)",
        "refresh": "timeRange",
        "multi": true
      }
    ],
    "panels": [
      {
        "id": "p1",
        "type": "timeseries",
        "title": "CPU Usage",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 6
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(kube_node_status_capacity{cluster=\"$cluster\", job=\"kube-state-metrics\", node=~\"$node\", resource=\"cpu\"})",
            "legend": "max capacity"
          },
          {
            "query": "sum(kube_node_status_allocatable{cluster=\"$cluster\", job=\"kube-state-metrics\", node=~\"$node\", resource=\"cpu\"})",
            "legend": "max allocatable"
          },
          {
            "query": "sum(max by (cluster, namespace, pod, container)(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_rate5m{cluster=\"$cluster\", node=~\"$node\"})) by (pod)",
            "legend": "{{pod}}"
          }
        ],
        "fill": 10,
        "stack": "normal",
        "overrides": [
          {
            "match": {
              "series": "max capacity"
            },
            "color": "#F2495C",
            "lineStyle": "dashed",
            "stack": "none"
          },
          {
            "match": {
              "series": "max allocatable"
            },
            "color": "#FFA6B0",
            "fill": 0,
            "lineStyle": "dashed",
            "stack": "none"
          }
        ],
        "interval": "1m",
        "display": {
          "legend": "right",
          "legendValues": [
            "lastNotNull"
          ]
        }
      },
