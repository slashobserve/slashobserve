  "spec": {
    "specVersion": "0",
    "title": "Kubernetes / Compute Resources / Pod",
    "tags": [
      "kubernetes-mixin"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "10s",
    "timezone": "utc",
    "variables": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(up{job=\"kube-state-metrics\"}, cluster)",
        "sort": "alpha",
        "refresh": "timeRange"
      },
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(kube_namespace_status_phase{job=\"kube-state-metrics\", cluster=\"$cluster\"}, namespace)",
        "sort": "alpha",
        "refresh": "timeRange"
      },
      {
        "name": "pod",
        "label": "pod",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(kube_pod_info{job=\"kube-state-metrics\", cluster=\"$cluster\", namespace=\"$namespace\"}, pod)",
        "sort": "alpha",
        "refresh": "timeRange"
      }
    ],
    "panels": [
      {
        "id": "p1",
        "type": "timeseries",
        "title": "CPU Usage",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(max by (cluster, namespace, pod, container)(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_rate5m{namespace=\"$namespace\", pod=\"$pod\", cluster=\"$cluster\", container!=\"\"})) by (container)",
            "legend": "__auto"
          },
          {
            "query": "sum(\n    kube_pod_container_resource_requests{job=\"kube-state-metrics\", cluster=\"$cluster\", namespace=\"$namespace\", pod=\"$pod\", resource=\"cpu\"}\n)\n",
            "legend": "requests"
          },
          {
            "query": "sum(\n    kube_pod_container_resource_limits{job=\"kube-state-metrics\", cluster=\"$cluster\", namespace=\"$namespace\", pod=\"$pod\", resource=\"cpu\"}\n)\n",
            "legend": "limits"
          }
        ],
        "fill": 10,
        "points": "never",
        "spanNulls": true,
        "interval": "1m",
        "display": {
          "legend": "right",
          "legendValues": [
            "lastNotNull"
          ]
        }
      },
      {
        "id": "p2",
        "type": "timeseries",
        "title": "CPU Throttling",
        "gridPos": {
          "x": 0,
          "y": 7,
          "w": 24,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(increase(container_cpu_cfs_throttled_periods_total{job=\"kubelet\", metrics_path=\"/metrics/cadvisor\", namespace=\"$namespace\", pod=\"$pod\", container!=\"\", cluster=\"$cluster\"}[$__rate_interval])) by (container) /sum(increase(container_cpu_cfs_periods_total{job=\"kubelet\", metrics_path=\"/metrics/cadvisor\", namespace=\"$namespace\", pod=\"$pod\", container!=\"\", cluster=\"$cluster\"}[$__rate_interval])) by (container)",
            "legend": "__auto"
          }
        ],
        "unit": "percentunit",
        "fill": 10,
        "points": "never",
        "spanNulls": true,
        "axisSoftMin": 0,
        "axisSoftMax": 1,
        "interval": "1m",
        "display": {
          "legend": "right",
          "legendValues": [
            "lastNotNull"
          ]
        }
      },
      {
        "id": "p3",
        "type": "table",
        "title": "CPU Quota",
        "gridPos": {
          "x": 0,
          "y": 14,
          "w": 24,
          "h": 7
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(max by (cluster, namespace, pod, container)(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_rate5m{namespace=\"$namespace\", pod=\"$pod\", cluster=\"$cluster\", container!=\"\"})) by (container)",
            "instant": true,
            "format": "table"
          },
          {
            "query": "sum(max by (cluster, namespace, pod, container)(cluster:namespace:pod_cpu:active:kube_pod_container_resource_requests{cluster=\"$cluster\", namespace=\"$namespace\", pod=\"$pod\", container!=\"\"})) by (container)",
            "instant": true,
            "format": "table"
          },
          {
            "query": "sum(max by (cluster, namespace, pod, container)(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_rate5m{cluster=\"$cluster\", namespace=\"$namespace\", pod=\"$pod\", container!=\"\"})) by (container) / sum(max by (cluster, namespace, pod, container)(cluster:namespace:pod_cpu:active:kube_pod_container_resource_requests{cluster=\"$cluster\", namespace=\"$namespace\", pod=\"$pod\", container!=\"\"})) by (container)",
            "instant": true,
            "format": "table"
          },
          {
            "query": "sum(max by (cluster, namespace, pod, container)(cluster:namespace:pod_cpu:active:kube_pod_container_resource_limits{cluster=\"$cluster\", namespace=\"$namespace\", pod=\"$pod\", container!=\"\"})) by (container)",
            "instant": true,
            "format": "table"
          },
          {
            "query": "sum(max by (cluster, namespace, pod, container)(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_rate5m{cluster=\"$cluster\", namespace=\"$namespace\", pod=\"$pod\", container!=\"\"})) by (container) / sum(max by (cluster, namespace, pod, container)(cluster:namespace:pod_cpu:active:kube_pod_container_resource_limits{cluster=\"$cluster\", namespace=\"$namespace\", pod=\"$pod\", container!=\"\"})) by (container)",
            "instant": true,
            "format": "table"
          }
        ],
        "overrides": [
          {
            "match": {
              "seriesRegex": "/%/"
            },
            "unit": "percentunit"
          }
        ],
        "transform": [
          {
            "type": "joinByField",
            "mode": "outer",
            "field": "container"
          },
          {
            "type": "organize",
            "exclude": [
              "Time",
              "Time 1",
              "Time 2",
              "Time 3",
              "Time 4",
              "Time 5"
            ],
            "rename": {
              "Value #A": "CPU Usage",
              "Value #B": "CPU Requests",
              "Value #C": "CPU Requests %",
              "Value #D": "CPU Limits",
              "Value #E": "CPU Limits %",
              "container": "Container"
            },
            "order": [
              "Time 1",
              "Time 2",
              "Time 3",
              "Time 4",
              "Time 5",
              "container",
              "Value #A",
              "Value #B",
              "Value #C",
              "Value #D",
              "Value #E"
            ]
          }
        ]
      },
