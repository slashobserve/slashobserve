  "spec": {
    "specVersion": "0",
    "title": "Kubernetes / Networking / Pod",
    "tags": [
      "kubernetes-mixin"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "10s",
    "timezone": "utc",
    "variables": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(up{job=\"kubelet\", metrics_path=\"/metrics/cadvisor\"}, cluster)",
        "sort": "alpha",
        "refresh": "timeRange"
      },
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(container_network_receive_packets_total{cluster=\"$cluster\"}, namespace)",
        "sort": "alpha",
        "refresh": "timeRange",
        "includeAll": true,
        "allValue": ".+",
        "default": "kube-system"
      },
      {
        "name": "pod",
        "label": "pod",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(container_network_receive_packets_total{cluster=\"$cluster\",namespace=~\"$namespace\"}, pod)",
        "sort": "alpha",
        "refresh": "timeRange",
        "default": "kube-system"
      }
    ],
    "panels": [
      {
        "id": "p1",
        "type": "gauge",
        "title": "Current Rate of Bits Received",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 9
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum((8 * rate(container_network_receive_bytes_total{cluster=\"$cluster\",namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval])))",
            "legend": "__auto"
          }
        ],
        "unit": "bps",
        "min": 0,
        "max": 10000000000,
        "thresholds": [
          {
            "color": "ok"
          },
          {
            "value": 5000000000,
            "color": "warning"
          },
          {
            "value": 7000000000,
            "color": "critical"
          }
        ],
        "displayName": "$pod",
        "interval": "1m"
