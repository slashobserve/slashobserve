  "spec": {
    "specVersion": "0",
    "title": "Node Exporter / Nodes",
    "tags": [
      "node-exporter-mixin"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "timezone": "utc",
    "cursorSync": "crosshair",
    "variables": [
      {
        "name": "datasource",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "hide": "variable",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(node_uname_info{job=\"node-exporter\", sysname!=\"Darwin\"}, cluster)",
        "refresh": "timeRange",
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(node_uname_info{job=\"node-exporter\", cluster=~\"$cluster\", sysname!=\"Darwin\"}, instance)",
        "refresh": "timeRange"
      }
    ],
    "panels": [
      {
        "id": "p1",
        "type": "row",
        "title": "CPU",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p2",
            "type": "timeseries",
            "title": "CPU Usage",
            "gridPos": {
              "x": 0,
              "y": 1,
              "w": 12,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "(\n  (1 - sum without (mode) (rate(node_cpu_seconds_total{job=\"node-exporter\", mode=~\"idle|iowait|steal\", instance=\"$instance\", cluster=~\"$cluster\"}[$__rate_interval])))\n/ ignoring(cpu) group_left\n  count without (cpu, mode) (node_cpu_seconds_total{job=\"node-exporter\", mode=\"idle\", instance=\"$instance\", cluster=~\"$cluster\"})\n)\n",
                "legend": "{{cpu}}",
                "intervalFactor": 5
              }
            ],
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "fill": 10,
            "points": "never",
            "stack": "normal",
            "display": {
              "tooltip": "all"
            }
          },
          {
            "id": "p3",
            "type": "timeseries",
            "title": "Load Average",
            "gridPos": {
              "x": 12,
              "y": 1,
              "w": 12,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "node_load1{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\"}",
                "legend": "1m load average"
              },
              {
                "query": "node_load5{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\"}",
                "legend": "5m load average"
              },
              {
                "query": "node_load15{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\"}",
                "legend": "15m load average"
              },
              {
                "query": "count(node_cpu_seconds_total{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\", mode=\"idle\"})",
                "legend": "logical cores"
              }
            ],
            "unit": "short",
            "min": 0,
            "points": "never",
            "display": {
              "tooltip": "all"
            }
          }
        ]
      },
      {
        "id": "p4",
        "type": "row",
        "title": "Memory",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p5",
            "type": "timeseries",
            "title": "Memory Usage",
            "gridPos": {
              "x": 0,
              "y": 9,
              "w": 18,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "(\n  node_memory_MemTotal_bytes{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\"}\n-\n  node_memory_MemFree_bytes{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\"}\n-\n  node_memory_Buffers_bytes{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\"}\n-\n  node_memory_Cached_bytes{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\"}\n)\n",
                "legend": "memory used"
              },
              {
                "query": "node_memory_Buffers_bytes{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\"}",
                "legend": "memory buffers"
              },
              {
                "query": "node_memory_Cached_bytes{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\"}",
                "legend": "memory cached"
              },
              {
                "query": "node_memory_MemFree_bytes{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\"}",
                "legend": "memory free"
              }
            ],
            "unit": "bytes",
            "min": 0,
            "fill": 10,
            "points": "never",
            "stack": "normal",
            "display": {
              "tooltip": "all"
            }
          },
          {
            "id": "p6",
            "type": "gauge",
            "title": "Memory Usage",
            "gridPos": {
              "x": 18,
              "y": 9,
              "w": 6,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "100 -\n(\n  avg(node_memory_MemAvailable_bytes{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\"}) /\n  avg(node_memory_MemTotal_bytes{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\"})\n* 100\n)\n"
              }
            ],
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": [
              {
                "color": "#32ac2d"
              },
              {
                "value": 80,
                "color": "warning"
              },
              {
                "value": 90,
                "color": "#f53636"
              }
            ]
          }
        ]
      },
      {
        "id": "p7",
        "type": "row",
        "title": "Disk",
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p8",
            "type": "timeseries",
            "title": "Disk I/O",
            "gridPos": {
              "x": 0,
              "y": 17,
              "w": 12,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "rate(node_disk_read_bytes_total{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\", device=~\"(/dev/)?(mmcblk.p.+|nvme.+|rbd.+|sd.+|vd.+|xvd.+|dm-.+|md.+|dasd.+)\"}[$__rate_interval])",
                "legend": "{{device}} read"
              },
              {
                "query": "rate(node_disk_written_bytes_total{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\", device=~\"(/dev/)?(mmcblk.p.+|nvme.+|rbd.+|sd.+|vd.+|xvd.+|dm-.+|md.+|dasd.+)\"}[$__rate_interval])",
                "legend": "{{device}} written"
              },
              {
                "query": "rate(node_disk_io_time_seconds_total{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\", device=~\"(/dev/)?(mmcblk.p.+|nvme.+|rbd.+|sd.+|vd.+|xvd.+|dm-.+|md.+|dasd.+)\"}[$__rate_interval])",
                "legend": "{{device}} io time"
              }
            ],
            "min": 0,
            "points": "never",
            "overrides": [
              {
                "match": {
                  "seriesRegex": "/ read| written/"
                },
                "unit": "Bps"
              },
              {
                "match": {
                  "seriesRegex": "/ io time/"
                },
                "unit": "percentunit"
              }
            ],
            "display": {
              "tooltip": "all"
            }
          },
          {
            "id": "p9",
            "type": "table",
            "title": "Disk Space Usage",
            "gridPos": {
              "x": 12,
              "y": 17,
              "w": 12,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "max by (mountpoint) (node_filesystem_size_bytes{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\", fstype!=\"\", mountpoint!=\"\"})\n",
                "instant": true,
                "format": "table"
              },
              {
                "query": "max by (mountpoint) (node_filesystem_avail_bytes{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\", fstype!=\"\", mountpoint!=\"\"})\n",
                "instant": true,
                "format": "table"
              }
            ],
            "unit": "decbytes",
            "overrides": [
              {
                "match": {
                  "field": "Used, %"
                },
                "unit": "percentunit",
                "min": 0,
                "max": 1
              }
            ],
            "transform": [
              {
                "type": "merge"
              },
              {
                "type": "organize",
                "rename": {
                  "Value #A (lastNotNull)": "Size",
                  "Value #B (lastNotNull)": "Available",
                  "mountpoint": "Mounted on"
                }
              },
              {
                "type": "sortBy",
                "field": "Mounted on"
              }
            ]
          }
        ]
      },
      {
        "id": "p10",
        "type": "row",
        "title": "Network",
        "gridPos": {
          "x": 0,
          "y": 24,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p11",
            "type": "timeseries",
            "title": "Network Received",
            "description": "Network received (bits/s)",
            "gridPos": {
              "x": 0,
              "y": 25,
              "w": 12,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "rate(node_network_receive_bytes_total{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\", device!=\"lo\"}[$__rate_interval]) * 8",
                "legend": "{{device}}"
              }
            ],
            "unit": "bps",
            "min": 0,
            "points": "never",
            "display": {
              "tooltip": "all"
            }
          },
          {
            "id": "p12",
            "type": "timeseries",
            "title": "Network Transmitted",
            "description": "Network transmitted (bits/s)",
            "gridPos": {
              "x": 12,
              "y": 25,
              "w": 12,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "rate(node_network_transmit_bytes_total{job=\"node-exporter\", instance=\"$instance\", cluster=~\"$cluster\", device!=\"lo\"}[$__rate_interval]) * 8",
                "legend": "{{device}}"
              }
            ],
            "unit": "bps",
            "min": 0,
            "display": {
              "tooltip": "all"
            }
          }
        ]
      }
    ]
  }
}
