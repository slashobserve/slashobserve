            "datasource": "prom",
            "queries": [
              {
                "query": "rate(prometheus_tsdb_head_samples_appended_total{cluster=~\"$cluster\", job=~\"$job\",instance=~\"$instance\"}[5m])",
                "legend": "{{cluster}} {{job}} {{instance}}"
              }
            ],
            "unit": "short",
