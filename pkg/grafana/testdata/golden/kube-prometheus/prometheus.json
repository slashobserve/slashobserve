  "spec": {
    "specVersion": "0",
    "title": "Prometheus / Overview",
    "tags": [
      "prometheus-mixin"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timezone": "utc",
    "variables": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": "prom",
        "query": "label_values(prometheus_build_info{job=\"prometheus-k8s\",namespace=\"monitoring\"}, cluster)",
        "sort": "alphaDesc",
        "refresh": "timeRange",
        "multi": true,
        "includeAll": true,
        "allValue": ".+"
      },
      {
        "name": "job",
        "label": "job",
        "type": "query",
        "datasource": "prom",
        "query": "label_values(prometheus_build_info{cluster=~\"$cluster\"}, job)",
        "sort": "alphaDesc",
        "refresh": "timeRange",
        "multi": true,
        "includeAll": true,
        "allValue": ".+"
      },
      {
        "name": "instance",
        "label": "instance",
        "type": "query",
        "datasource": "prom",
        "query": "label_values(prometheus_build_info{cluster=~\"$cluster\", job=~\"$job\"}, instance)",
        "sort": "alphaDesc",
        "refresh": "timeRange",
        "multi": true,
        "includeAll": true,
        "allValue": ".+"
      }
    ],
    "panels": [
      {
        "id": "p1",
        "type": "row",
        "title": "Prometheus Stats",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p2",
            "type": "table",
            "title": "Prometheus Stats",
            "gridPos": {
              "x": 0,
              "y": 1,
              "w": 24,
              "h": 7
            },
            "datasource": "prom",
            "queries": [
              {
                "query": "count by (cluster, job, instance, version) (prometheus_build_info{cluster=~\"$cluster\", job=~\"$job\", instance=~\"$instance\"})",
                "instant": true,
                "format": "table"
              },
              {
                "query": "max by (cluster, job, instance) (time() - process_start_time_seconds{cluster=~\"$cluster\", job=~\"$job\", instance=~\"$instance\"})",
                "instant": true,
                "format": "table"
              }
            ],
            "unit": "short",
            "decimals": 2,
            "overrides": [
              {
                "match": {
                  "field": "Time"
                },
                "displayName": "Time"
              },
              {
                "match": {
                  "field": "cluster"
                },
                "unit": "short",
                "decimals": 2,
                "displayName": "Cluster"
              },
              {
                "match": {
                  "field": "job"
                },
                "unit": "short",
                "decimals": 2,
                "displayName": "Job"
              },
              {
                "match": {
                  "field": "instance"
                },
                "unit": "short",
                "decimals": 2,
                "displayName": "Instance"
              },
              {
                "match": {
                  "field": "version"
                },
                "unit": "short",
                "decimals": 2,
                "displayName": "Version"
              },
              {
                "match": {
                  "field": "Value #A"
                },
                "unit": "short",
                "decimals": 2,
                "displayName": "Count"
              },
              {
                "match": {
                  "field": "Value #B"
                },
                "unit": "s",
                "displayName": "Uptime"
              }
            ]
          }
        ]
      },
      {
        "id": "p3",
        "type": "row",
        "title": "Discovery",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p4",
            "type": "timeseries",
            "title": "Target Sync",
            "gridPos": {
              "x": 0,
              "y": 9,
              "w": 12,
              "h": 7
            },
            "datasource": "prom",
            "queries": [
              {
                "query": "sum(rate(prometheus_target_sync_length_seconds_sum{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}[5m])) by (cluster, job, scrape_job, instance) * 1e3",
                "legend": "{{cluster}}:{{job}}:{{instance}}:{{scrape_job}}"
              }
            ],
            "unit": "ms",
            "min": 0,
            "fill": 10,
            "display": {
              "tooltip": "all"
            }
          },
          {
            "id": "p5",
            "type": "timeseries",
            "title": "Targets",
            "gridPos": {
              "x": 12,
              "y": 9,
              "w": 12,
              "h": 7
            },
            "datasource": "prom",
            "queries": [
              {
                "query": "sum by (cluster, job, instance) (prometheus_sd_discovered_targets{cluster=~\"$cluster\", job=~\"$job\",instance=~\"$instance\"})",
                "legend": "{{cluster}}:{{job}}:{{instance}}"
              }
            ],
            "unit": "short",
            "min": 0,
            "fill": 100,
            "stack": "normal",
            "display": {
              "tooltip": "all"
            }
          }
        ]
      },
      {
        "id": "p6",
        "type": "row",
        "title": "Retrieval",
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p7",
            "type": "timeseries",
            "title": "Average Scrape Interval Duration",
            "gridPos": {
              "x": 0,
              "y": 17,
              "w": 8,
              "h": 7
            },
            "datasource": "prom",
            "queries": [
              {
                "query": "rate(prometheus_target_interval_length_seconds_sum{cluster=~\"$cluster\", job=~\"$job\",instance=~\"$instance\"}[5m]) / rate(prometheus_target_interval_length_seconds_count{cluster=~\"$cluster\", job=~\"$job\",instance=~\"$instance\"}[5m]) * 1e3",
                "legend": "{{cluster}}:{{job}}:{{instance}} {{interval}} configured"
              }
            ],
            "unit": "ms",
            "min": 0,
            "fill": 10,
            "display": {
              "tooltip": "all"
            }
          },
          {
            "id": "p8",
            "type": "timeseries",
            "title": "Scrape failures",
            "gridPos": {
              "x": 8,
              "y": 17,
              "w": 8,
              "h": 7
            },
            "datasource": "prom",
            "queries": [
              {
                "query": "sum by (cluster, job, instance) (rate(prometheus_target_scrapes_exceeded_body_size_limit_total{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}[1m]))",
                "legend": "exceeded body size limit: {{cluster}} {{job}} {{instance}}"
              },
              {
                "query": "sum by (cluster, job, instance) (rate(prometheus_target_scrapes_exceeded_sample_limit_total{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}[1m]))",
                "legend": "exceeded sample limit: {{cluster}} {{job}} {{instance}}"
              },
              {
                "query": "sum by (cluster, job, instance) (rate(prometheus_target_scrapes_sample_duplicate_timestamp_total{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}[1m]))",
                "legend": "duplicate timestamp: {{cluster}} {{job}} {{instance}}"
              },
              {
                "query": "sum by (cluster, job, instance) (rate(prometheus_target_scrapes_sample_out_of_bounds_total{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}[1m]))",
                "legend": "out of bounds: {{cluster}} {{job}} {{instance}}"
              },
              {
                "query": "sum by (cluster, job, instance) (rate(prometheus_target_scrapes_sample_out_of_order_total{cluster=~\"$cluster\",job=~\"$job\",instance=~\"$instance\"}[1m]))",
                "legend": "out of order: {{cluster}} {{job}} {{instance}}"
              }
            ],
            "unit": "short",
            "min": 0,
            "fill": 100,
            "stack": "normal",
            "display": {
              "tooltip": "all"
            }
          },
          {
            "id": "p9",
            "type": "timeseries",
            "title": "Appended Samples",
            "gridPos": {
              "x": 16,
