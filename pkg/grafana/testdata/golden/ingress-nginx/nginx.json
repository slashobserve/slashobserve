          }
        ],
        "color": "#1f78c1",
        "mappings": [
          {
            "special": "null",
            "text": "N/A"
          }
        ],
        "maxDataPoints": 100,
        "display": {
          "reduce": "mean",
          "colorMode": "none",
          "orientation": "horizontal",
          "wideLayout": true
        }
      },
      {
        "id": "p81",
        "type": "stat",
        "title": "Config Reloads",
