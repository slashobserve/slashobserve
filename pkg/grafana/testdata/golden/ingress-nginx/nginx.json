  "spec": {
    "specVersion": "0",
    "title": "NGINX Ingress controller",
    "tags": [
      "nginx"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "5s",
    "timePicker": {
      "refreshIntervals": [
        "5s",
        "10s",
        "30s",
        "2m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ]
    },
    "variables": [
      {
        "name": "DS_PROMETHEUS",
        "label": "datasource",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": "prom",
        "query": "label_values(nginx_ingress_controller_config_hash, controller_namespace)",
        "includeAll": true,
        "allValue": ".*",
        "allowCustomValue": true
      },
      {
        "name": "controller_class",
        "label": "Controller Class",
        "type": "query",
        "datasource": "prom",
        "query": "label_values(nginx_ingress_controller_config_hash{namespace=~\"$namespace\"}, controller_class) ",
        "includeAll": true,
        "allValue": ".*",
        "allowCustomValue": true
      },
      {
        "name": "controller",
        "label": "Controller",
        "type": "query",
        "datasource": "prom",
        "query": "label_values(nginx_ingress_controller_config_hash{namespace=~\"$namespace\",controller_class=~\"$controller_class\"}, controller_pod) ",
        "sort": "alpha",
        "includeAll": true,
        "allValue": ".*",
        "allowCustomValue": true
      },
      {
        "name": "exported_namespace",
        "label": "Ingress Namespace",
        "type": "query",
        "datasource": "prom",
        "query": "label_values(nginx_ingress_controller_requests{namespace=~\"$namespace\",controller_class=~\"$controller_class\",controller_pod=~\"$controller\"}, exported_namespace) ",
        "sort": "alpha",
        "includeAll": true,
        "allValue": ".*",
        "allowCustomValue": true
      },
      {
        "name": "ingress",
        "label": "Ingress",
        "type": "query",
        "datasource": "prom",
        "query": "label_values(nginx_ingress_controller_requests{namespace=~\"$namespace\",controller_class=~\"$controller_class\",controller_pod=~\"$controller\",exported_namespace=~\"$exported_namespace\"}, ingress) ",
        "sort": "alpha",
        "includeAll": true,
        "allValue": ".*",
        "allowCustomValue": true
      }
    ],
    "panels": [
      {
        "id": "p20",
        "type": "stat",
        "title": "Controller Request Volume",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 3
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "round(sum(irate(nginx_ingress_controller_requests{controller_pod=~\"$controller\",controller_class=~\"$controller_class\",namespace=~\"$namespace\"}[2m])), 0.001)",
            "interval": "4s"
          }
        ],
        "unit": "ops",
        "thresholds": [
          {
            "color": "ok"
          },
          {
            "value": 80,
            "color": "critical"
          }
        ],
        "color": "#1f78c1",
        "mappings": [
          {
            "special": "null",
            "text": "N/A"
          }
        ],
        "maxDataPoints": 100,
        "display": {
          "reduce": "mean",
          "colorMode": "none",
          "orientation": "horizontal",
          "wideLayout": true
        }
      },
      {
        "id": "p82",
        "type": "stat",
        "title": "Controller Connections",
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 3
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "sum(avg_over_time(nginx_ingress_controller_nginx_process_connections{controller_pod=~\"$controller\",controller_class=~\"$controller_class\",controller_namespace=~\"$namespace\",state=\"active\"}[2m]))",
            "interval": "4s"
          }
        ],
        "unit": "none",
        "thresholds": [
          {
            "color": "ok"
          },
          {
            "value": 80,
            "color": "critical"
          }
        ],
        "color": "#1f78c1",
        "mappings": [
          {
            "special": "null",
            "text": "N/A"
          }
        ],
        "maxDataPoints": 100,
        "display": {
          "reduce": "mean",
          "colorMode": "none",
          "orientation": "horizontal",
          "wideLayout": true
        }
      },
      {
        "id": "p21",
        "type": "stat",
        "title": "Controller Success Rate (non-4|5xx responses)",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 6,
          "h": 3
        },
        "datasource": "prom",
        "queries": [
          {
            "query": "sum(rate(nginx_ingress_controller_requests{controller_pod=~\"$controller\",controller_class=~\"$controller_class\",namespace=~\"$namespace\",status!~\"[4-5].*\"}[2m])) / sum(rate(nginx_ingress_controller_requests{controller_pod=~\"$controller\",controller_class=~\"$controller_class\",namespace=~\"$namespace\"}[2m]))",
            "interval": "4s"
          }
        ],
        "unit": "percentunit",
        "thresholds": [
          {
            "color": "#f53636"
          },
          {
            "value": 95,
