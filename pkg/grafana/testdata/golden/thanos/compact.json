  "spec": {
    "specVersion": "0",
    "title": "Thanos / Compact",
    "tags": [
      "thanos-mixin"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "10s",
    "timezone": "utc",
    "variables": [
      {
        "name": "datasource",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "interval",
        "label": "interval",
        "type": "interval",
        "options": [
          "5m",
          "10m",
          "30m",
          "1h",
          "6h",
          "12h"
        ],
        "auto": true,
        "autoSteps": 300,
        "autoMin": "10s",
        "default": "5m"
      },
      {
        "name": "job",
        "label": "job",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(up{job=~\".*thanos-compact.*\"}, job)",
        "sort": "alphaDesc",
        "includeAll": true,
        "allowCustomValue": true
      }
    ],
    "panels": [
      {
        "id": "p20",
        "type": "row",
        "title": "Group Compaction",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p1",
            "type": "timeseries",
            "title": "Rate",
            "description": "Shows rate of execution for compactions against blocks that are stored in the bucket by compaction resolution.",
            "gridPos": {
              "x": 0,
              "y": 1,
              "w": 12,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job, resolution) (rate(thanos_compact_group_compactions_total{job=~\"$job\"}[$__rate_interval]))",
                "legend": "compaction {{job}} {{resolution}}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "short",
            "min": 0,
            "fill": 100,
            "lineWidth": 0,
            "stack": "normal"
          },
          {
            "id": "p2",
            "type": "timeseries",
            "title": "Errors",
            "description": "Shows ratio of errors compared to the total number of executed compactions against blocks that are stored in the bucket.",
            "gridPos": {
              "x": 12,
              "y": 1,
              "w": 12,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job) (rate(thanos_compact_group_compactions_failures_total{job=~\"$job\"}[$interval])) / sum by (job) (rate(thanos_compact_group_compactions_total{job=~\"$job\"}[$interval]))",
                "legend": "error",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "percentunit",
            "min": 0,
            "fill": 100,
            "lineWidth": 0,
            "stack": "normal",
            "overrides": [
              {
                "match": {
                  "series": "error"
                },
                "color": "#E24D42"
              }
            ]
          }
        ]
      },
      {
        "id": "p21",
        "type": "row",
        "title": "Downsample",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p3",
            "type": "timeseries",
            "title": "Rate",
            "description": "Shows rate of execution for downsampling against blocks that are stored in the bucket by compaction resolution.",
            "gridPos": {
              "x": 0,
              "y": 9,
              "w": 12,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job, resolution) (rate(thanos_compact_downsample_total{job=~\"$job\"}[$__rate_interval]))",
                "legend": "downsample {{job}} {{resolution}}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "short",
            "min": 0,
            "fill": 100,
            "lineWidth": 0,
            "stack": "normal"
          },
          {
            "id": "p4",
            "type": "timeseries",
            "title": "Errors",
            "description": "Shows ratio of errors compared to the total number of executed downsampling against blocks that are stored in the bucket.",
            "gridPos": {
              "x": 12,
              "y": 9,
              "w": 12,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job) (rate(thanos_compact_downsample_failed_total{job=~\"$job\"}[$interval])) / sum by (job) (rate(thanos_compact_downsample_total{job=~\"$job\"}[$interval]))",
                "legend": "error",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "percentunit",
            "min": 0,
            "fill": 100,
            "lineWidth": 0,
            "stack": "normal",
            "overrides": [
              {
                "match": {
                  "series": "error"
                },
                "color": "#E24D42"
              }
            ]
          }
        ]
      },
      {
        "id": "p22",
        "type": "row",
        "title": "Garbage Collection",
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p5",
            "type": "timeseries",
            "title": "Rate",
            "description": "Shows rate of execution for removals of blocks if their data is available as part of a block with a higher compaction level.",
            "gridPos": {
              "x": 0,
              "y": 17,
              "w": 8,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job) (rate(thanos_compact_garbage_collection_total{job=~\"$job\"}[$__rate_interval]))",
                "legend": "garbage collection {{job}}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "short",
            "min": 0,
            "fill": 100,
            "lineWidth": 0,
            "stack": "normal"
          },
          {
            "id": "p6",
            "type": "timeseries",
            "title": "Errors",
            "description": "Shows ratio of errors compared to the total number of executed garbage collections.",
            "gridPos": {
              "x": 8,
              "y": 17,
              "w": 8,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job) (rate(thanos_compact_garbage_collection_failures_total{job=~\"$job\"}[$interval])) / sum by (job) (rate(thanos_compact_garbage_collection_total{job=~\"$job\"}[$interval]))",
                "legend": "error",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "percentunit",
            "min": 0,
            "fill": 100,
            "lineWidth": 0,
            "stack": "normal",
            "overrides": [
              {
                "match": {
                  "series": "error"
                },
                "color": "#E24D42"
              }
            ]
          },
          {
            "id": "p7",
            "type": "timeseries",
            "title": "Duration",
            "description": "Shows how long has it taken to execute garbage collection in quantiles.",
            "gridPos": {
              "x": 16,
              "y": 17,
              "w": 8,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "histogram_quantile(0.50, sum by (job, le) (rate(thanos_compact_garbage_collection_duration_seconds_bucket{job=~\"$job\"}[$interval]))) * 1",
                "legend": "p50 {{job}}",
                "interval": "10s",
                "intervalFactor": 2
              },
              {
                "query": "histogram_quantile(0.90, sum by (job, le) (rate(thanos_compact_garbage_collection_duration_seconds_bucket{job=~\"$job\"}[$interval]))) * 1",
                "legend": "p90 {{job}}",
                "interval": "10s",
                "intervalFactor": 2
              },
              {
                "query": "histogram_quantile(0.99, sum by (job, le) (rate(thanos_compact_garbage_collection_duration_seconds_bucket{job=~\"$job\"}[$interval]))) * 1",
                "legend": "p99 {{job}}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "s",
            "min": 0,
            "fill": 10,
            "overrides": [
              {
                "match": {
                  "series": "p99"
                },
                "color": "#FA6400",
                "fill": 10
              },
              {
                "match": {
                  "series": "p90"
                },
                "color": "#E0B400",
                "fill": 10
              },
              {
                "match": {
                  "series": "p50"
                },
                "color": "#37872D",
                "fill": 100
              }
            ]
          }
        ]
      },
      {
        "id": "p23",
        "type": "row",
