  "spec": {
    "specVersion": "0",
    "title": "Thanos / Query",
    "tags": [
      "thanos-mixin"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "10s",
    "timezone": "utc",
    "variables": [
      {
        "name": "datasource",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "interval",
        "label": "interval",
        "type": "interval",
        "options": [
          "5m",
          "10m",
          "30m",
          "1h",
          "6h",
          "12h"
        ],
        "auto": true,
        "autoSteps": 300,
        "autoMin": "10s",
        "default": "5m"
      },
      {
        "name": "job",
        "label": "job",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(up{job=~\".*thanos-query.*\"}, job)",
        "sort": "alphaDesc",
        "includeAll": true,
        "allowCustomValue": true
      }
    ],
    "panels": [
      {
        "id": "p19",
        "type": "row",
        "title": "Instant Query API",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p1",
            "type": "timeseries",
            "title": "Rate",
            "description": "Shows rate of requests against /query for the given time.",
            "gridPos": {
              "x": 0,
              "y": 1,
              "w": 8,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job, handler, code) (rate(http_requests_total{job=~\"$job\", handler=\"query\"}[$interval]))",
                "legend": "{{job}} {{handler}} {{code}}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "short",
            "min": 0,
            "fill": 100,
            "lineWidth": 0,
            "stack": "normal",
            "overrides": [
              {
                "match": {
                  "seriesRegex": "/1../"
                },
                "color": "#EAB839"
              },
              {
                "match": {
                  "seriesRegex": "/2../"
                },
                "color": "#37872D"
              },
              {
                "match": {
                  "seriesRegex": "/3../"
                },
                "color": "#E0B400"
              },
              {
                "match": {
                  "seriesRegex": "/4../"
                },
                "color": "#1F60C4"
              },
              {
                "match": {
                  "seriesRegex": "/5../"
                },
                "color": "#C4162A"
              }
            ]
          },
          {
            "id": "p2",
            "type": "timeseries",
            "title": "Errors",
            "description": "Shows ratio of errors compared to the total number of handled requests against /query.",
            "gridPos": {
              "x": 8,
              "y": 1,
              "w": 8,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job, code) (rate(http_requests_total{job=~\"$job\", handler=\"query\",code=~\"5..\"}[$interval])) / ignoring (code) group_left() sum by (job) (rate(http_requests_total{job=~\"$job\", handler=\"query\"}[$interval]))",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "percentunit",
            "min": 0,
            "fill": 100,
            "lineWidth": 0,
            "stack": "normal",
            "overrides": [
              {
                "match": {
                  "series": "error"
                },
                "color": "#E24D42"
              }
            ]
          },
          {
            "id": "p3",
            "type": "timeseries",
            "title": "Duration",
            "description": "Shows how long has it taken to handle requests in quantiles.",
            "gridPos": {
              "x": 16,
              "y": 1,
              "w": 8,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "histogram_quantile(0.50, sum by (job, le) (rate(http_request_duration_seconds_bucket{job=~\"$job\", handler=\"query\"}[$interval]))) * 1",
                "legend": "p50 {{job}}",
                "interval": "10s",
                "intervalFactor": 2
              },
              {
                "query": "histogram_quantile(0.90, sum by (job, le) (rate(http_request_duration_seconds_bucket{job=~\"$job\", handler=\"query\"}[$interval]))) * 1",
                "legend": "p90 {{job}}",
                "interval": "10s",
                "intervalFactor": 2
              },
              {
                "query": "histogram_quantile(0.99, sum by (job, le) (rate(http_request_duration_seconds_bucket{job=~\"$job\", handler=\"query\"}[$interval]))) * 1",
                "legend": "p99 {{job}}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "s",
            "min": 0,
            "fill": 10,
            "overrides": [
              {
                "match": {
                  "series": "p99"
                },
                "color": "#FA6400",
                "fill": 10
              },
              {
