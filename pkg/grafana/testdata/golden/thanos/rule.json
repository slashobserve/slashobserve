  "spec": {
    "specVersion": "0",
    "title": "Thanos / Rule",
    "tags": [
      "thanos-mixin"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "10s",
    "timezone": "utc",
    "variables": [
      {
        "name": "datasource",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "interval",
        "label": "interval",
        "type": "interval",
        "options": [
          "5m",
          "10m",
          "30m",
          "1h",
          "6h",
          "12h"
        ],
        "auto": true,
        "autoSteps": 300,
        "autoMin": "10s",
        "default": "5m"
      },
      {
        "name": "job",
        "label": "job",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(up{job=~\".*thanos-rule.*\"}, job)",
        "sort": "alphaDesc",
        "includeAll": true
      }
    ],
    "panels": [
      {
        "id": "p20",
        "type": "row",
        "title": "Rule Group Evaluations",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p1",
            "type": "timeseries",
            "title": "Rule Group Evaluations",
            "gridPos": {
              "x": 0,
              "y": 1,
              "w": 6,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job, rule_group, strategy) (rate(prometheus_rule_evaluations_total{job=~\"$job\"}[$__rate_interval]))",
                "legend": "{{ rule_group }} {{ strategy }}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "short",
            "min": 0,
            "fill": 10
          },
          {
            "id": "p2",
            "type": "timeseries",
            "title": "Rule Group Evaluations Failed",
            "gridPos": {
              "x": 6,
              "y": 1,
              "w": 6,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job, rule_group, strategy) (rate(prometheus_rule_evaluation_failures_total{job=~\"$job\"}[$__rate_interval]))",
                "legend": "{{ rule_group }} {{ strategy }}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "short",
            "min": 0,
            "fill": 10
          },
          {
            "id": "p3",
            "type": "timeseries",
            "title": "Rule Group Evaluations Missed",
            "gridPos": {
              "x": 12,
              "y": 1,
              "w": 6,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job, rule_group, strategy) (increase(prometheus_rule_group_iterations_missed_total{job=~\"$job\"}[$__rate_interval]))",
                "legend": "{{ rule_group }} {{ strategy }}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "short",
            "min": 0,
            "fill": 10
          },
          {
            "id": "p4",
            "type": "timeseries",
            "title": "Rule Group Evaluations Too Slow",
            "gridPos": {
              "x": 18,
              "y": 1,
              "w": 6,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "(\n  sum by(job, rule_group) (prometheus_rule_group_last_duration_seconds{job=~\"$job\"})\n  >\n  sum by(job, rule_group) (prometheus_rule_group_interval_seconds{job=~\"$job\"})\n)\n",
                "legend": "{{ rule_group }}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "short",
            "min": 0,
            "fill": 10
          }
        ]
      },
      {
        "id": "p21",
        "type": "row",
        "title": "Alert Sent",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p5",
            "type": "timeseries",
            "title": "Dropped Rate",
            "description": "Shows rate of dropped alerts.",
            "gridPos": {
              "x": 0,
              "y": 9,
              "w": 6,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job, alertmanager) (rate(thanos_alert_sender_alerts_dropped_total{job=~\"$job\"}[$__rate_interval]))",
                "legend": "{{alertmanager}}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "short",
            "min": 0,
            "fill": 10
          },
          {
            "id": "p6",
            "type": "timeseries",
            "title": "Sent Rate",
            "description": "Shows rate of alerts that successfully sent to alert manager.",
            "gridPos": {
              "x": 6,
              "y": 9,
              "w": 6,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job, alertmanager) (rate(thanos_alert_sender_alerts_sent_total{job=~\"$job\"}[$__rate_interval]))",
                "legend": "{{alertmanager}}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "short",
            "min": 0,
            "fill": 100,
            "stack": "normal"
          },
          {
            "id": "p7",
            "type": "timeseries",
            "title": "Sent Errors",
            "description": "Shows ratio of errors compared to the total number of sent alerts.",
            "gridPos": {
              "x": 12,
              "y": 9,
              "w": 6,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job) (rate(thanos_alert_sender_errors_total{job=~\"$job\"}[$interval])) / sum by (job) (rate(thanos_alert_sender_alerts_sent_total{job=~\"$job\"}[$interval]))",
                "legend": "error",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "percentunit",
            "min": 0,
            "fill": 100,
            "stack": "normal",
            "overrides": [
              {
                "match": {
                  "series": "error"
                },
                "color": "#E24D42"
              }
            ]
          },
          {
            "id": "p8",
            "type": "timeseries",
            "title": "Sent Duration",
            "description": "Shows how long has it taken to send alerts to alert manager.",
            "gridPos": {
              "x": 18,
              "y": 9,
              "w": 6,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "histogram_quantile(0.50, sum by (job, le) (rate(thanos_alert_sender_latency_seconds_bucket{job=~\"$job\"}[$interval]))) * 1",
                "legend": "p50 {{job}}",
                "interval": "10s",
                "intervalFactor": 2
              },
              {
                "query": "histogram_quantile(0.90, sum by (job, le) (rate(thanos_alert_sender_latency_seconds_bucket{job=~\"$job\"}[$interval]))) * 1",
                "legend": "p90 {{job}}",
                "interval": "10s",
                "intervalFactor": 2
              },
              {
                "query": "histogram_quantile(0.99, sum by (job, le) (rate(thanos_alert_sender_latency_seconds_bucket{job=~\"$job\"}[$interval]))) * 1",
                "legend": "p99 {{job}}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "s",
            "min": 0,
            "fill": 10,
            "overrides": [
              {
                "match": {
                  "series": "p99"
                },
                "color": "#FA6400",
                "fill": 10
              },
              {
                "match": {
                  "series": "p90"
                },
