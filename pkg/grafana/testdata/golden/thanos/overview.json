    "panels": [
      {
        "id": "p21",
        "type": "row",
        "title": "Instant Query",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p1",
            "type": "timeseries",
            "title": "Requests Rate",
            "description": "Shows rate of requests against /query for the given time.",
            "gridPos": {
              "x": 0,
              "y": 1,
              "w": 8,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job, handler, code) (rate(http_requests_total{handler=\"query\"}[$interval]))",
                "legend": "{{job}} {{handler}} {{code}}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "short",
            "min": 0,
            "fill": 100,
            "stack": "normal",
            "overrides": [
              {
                "match": {
                  "seriesRegex": "/1../"
                },
                "color": "#EAB839"
              },
              {
                "match": {
                  "seriesRegex": "/2../"
                },
                "color": "#37872D"
              },
              {
                "match": {
                  "seriesRegex": "/3../"
                },
                "color": "#E0B400"
              },
              {
                "match": {
                  "seriesRegex": "/4../"
                },
                "color": "#1F60C4"
              },
              {
                "match": {
                  "seriesRegex": "/5../"
                },
                "color": "#C4162A"
              }
            ]
          },
          {
            "id": "p2",
            "type": "timeseries",
            "title": "Requests Errors",
            "description": "Shows ratio of errors compared to the total number of handled requests against /query.",
            "gridPos": {
              "x": 8,
              "y": 1,
              "w": 8,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job, code) (rate(http_requests_total{handler=\"query\",code=~\"5..\"}[$interval])) / ignoring (code) group_left() sum by (job) (rate(http_requests_total{handler=\"query\"}[$interval]))",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "percentunit",
            "min": 0,
            "fill": 100,
            "stack": "normal",
            "overrides": [
              {
                "match": {
                  "series": "error"
                },
                "color": "#E24D42"
              }
            ]
          },
          {
            "id": "p3",
            "type": "timeseries",
            "title": "Latency 99th Percentile",
            "description": "Shows how long has it taken to handle requests.",
            "gridPos": {
              "x": 16,
              "y": 1,
              "w": 8,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "histogram_quantile(0.99, sum by (job, le) (rate(http_request_duration_seconds_bucket{handler=\"query\"}[$interval])))",
                "legend": "{{job}} P99",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "s",
            "min": 0,
            "thresholds": [
              {
                "value": 0.5,
                "color": "warning"
              },
              {
                "value": 1,
                "color": "critical"
              }
            ],
            "fill": 10
          }
        ]
