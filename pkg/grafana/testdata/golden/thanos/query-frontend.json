  "spec": {
    "specVersion": "0",
    "title": "Thanos / Query Frontend",
    "tags": [
      "thanos-mixin"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "10s",
    "timezone": "utc",
    "variables": [
      {
        "name": "datasource",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "interval",
        "label": "interval",
        "type": "interval",
        "options": [
          "5m",
          "10m",
          "30m",
          "1h",
          "6h",
          "12h"
        ],
        "auto": true,
        "autoSteps": 300,
        "autoMin": "10s",
        "default": "5m"
      },
      {
        "name": "job",
        "label": "job",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(up{job=~\".*thanos-query-frontend.*\"}, job)",
        "sort": "alphaDesc",
        "includeAll": true
      }
    ],
    "panels": [
      {
        "id": "p12",
        "type": "row",
        "title": "Query Frontend API",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p1",
            "type": "timeseries",
            "title": "Rate of requests",
            "description": "Shows rate of requests against Query Frontend for the given time.",
            "gridPos": {
              "x": 0,
              "y": 1,
              "w": 6,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job, handler, code) (rate(http_requests_total{job=~\"$job\", handler=\"query-frontend\"}[$interval]))",
                "legend": "{{job}} {{handler}} {{code}}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "short",
            "min": 0,
            "fill": 100,
            "stack": "normal",
            "overrides": [
              {
                "match": {
                  "seriesRegex": "/1../"
                },
                "color": "#EAB839"
              },
              {
                "match": {
                  "seriesRegex": "/2../"
                },
                "color": "#37872D"
              },
              {
                "match": {
                  "seriesRegex": "/3../"
                },
                "color": "#E0B400"
              },
              {
                "match": {
                  "seriesRegex": "/4../"
                },
                "color": "#1F60C4"
              },
              {
                "match": {
                  "seriesRegex": "/5../"
                },
                "color": "#C4162A"
              }
            ]
          },
          {
            "id": "p2",
            "type": "timeseries",
            "title": "Rate of queries",
            "description": "Shows rate of queries passing through Query Frontend",
            "gridPos": {
              "x": 6,
              "y": 1,
              "w": 6,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job, handler, code) (rate(thanos_query_frontend_queries_total{job=~\"$job\", op=\"query_range\"}[$interval]))",
                "legend": "{{job}} {{handler}} {{code}}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "short",
            "min": 0,
            "fill": 100,
            "stack": "normal",
            "overrides": [
              {
                "match": {
                  "seriesRegex": "/1../"
                },
                "color": "#EAB839"
              },
              {
                "match": {
                  "seriesRegex": "/2../"
                },
                "color": "#37872D"
              },
              {
                "match": {
                  "seriesRegex": "/3../"
                },
                "color": "#E0B400"
              },
              {
                "match": {
                  "seriesRegex": "/4../"
                },
                "color": "#1F60C4"
              },
              {
                "match": {
                  "seriesRegex": "/5../"
                },
                "color": "#C4162A"
              }
            ]
          },
          {
            "id": "p3",
            "type": "timeseries",
            "title": "Errors",
            "description": "Shows ratio of errors compared to the total number of handled requests against Query Frontend.",
            "gridPos": {
              "x": 12,
              "y": 1,
              "w": 6,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job, code) (rate(http_requests_total{job=~\"$job\", handler=\"query-frontend\",code=~\"5..\"}[$interval])) / ignoring (code) group_left() sum by (job) (rate(http_requests_total{job=~\"$job\", handler=\"query-frontend\"}[$interval]))",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "percentunit",
            "min": 0,
            "fill": 100,
            "stack": "normal",
            "overrides": [
              {
                "match": {
                  "series": "error"
                },
                "color": "#E24D42"
              }
            ]
          },
          {
            "id": "p4",
            "type": "timeseries",
            "title": "Duration",
            "description": "Shows how long has it taken to handle requests in quantiles.",
            "gridPos": {
              "x": 18,
              "y": 1,
              "w": 6,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "histogram_quantile(0.50, sum by (job, le) (rate(http_request_duration_seconds_bucket{job=~\"$job\", handler=\"query-frontend\"}[$interval]))) * 1",
                "legend": "p50 {{job}}",
                "interval": "10s",
                "intervalFactor": 2
              },
              {
                "query": "histogram_quantile(0.90, sum by (job, le) (rate(http_request_duration_seconds_bucket{job=~\"$job\", handler=\"query-frontend\"}[$interval]))) * 1",
                "legend": "p90 {{job}}",
                "interval": "10s",
                "intervalFactor": 2
              },
              {
                "query": "histogram_quantile(0.99, sum by (job, le) (rate(http_request_duration_seconds_bucket{job=~\"$job\", handler=\"query-frontend\"}[$interval]))) * 1",
                "legend": "p99 {{job}}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "s",
            "min": 0,
            "fill": 10,
            "overrides": [
              {
                "match": {
                  "series": "p99"
                },
                "color": "#FA6400",
                "fill": 10
              },
              {
                "match": {
                  "series": "p90"
                },
                "color": "#E0B400",
                "fill": 10
              },
              {
                "match": {
                  "series": "p50"
                },
                "color": "#37872D",
                "fill": 100
              }
            ]
          }
        ]
      },
      {
        "id": "p13",
        "type": "row",
        "title": "Cache Operations",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p5",
            "type": "timeseries",
            "title": "Requests",
            "description": "Show rate of cache requests.",
            "gridPos": {
              "x": 0,
              "y": 9,
              "w": 6,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job, tripperware) (rate(cortex_cache_request_duration_seconds_count{job=~\"$job\"}[$__rate_interval]))",
                "legend": "{{job}} {{tripperware}}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "short",
            "min": 0,
            "fill": 100,
            "stack": "normal"
          },
          {
            "id": "p6",
            "type": "timeseries",
            "title": "Querier cache gets vs misses",
            "description": "Show rate of Querier cache gets vs misses.",
            "gridPos": {
              "x": 6,
              "y": 9,
              "w": 6,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job, tripperware) (rate(querier_cache_gets_total{job=~\"$job\"}[$__rate_interval]))",
                "legend": "Cache gets - {{job}} {{tripperware}}",
                "interval": "10s",
                "intervalFactor": 2
              },
              {
                "query": "sum by (job, tripperware) (rate(querier_cache_misses_total{job=~\"$job\"}[$__rate_interval]))",
                "legend": "Cache misses - {{job}} {{tripperware}}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "short",
            "min": 0,
            "fill": 100,
            "stack": "normal"
          },
          {
            "id": "p7",
            "type": "timeseries",
            "title": "Cortex fetched keys",
            "description": "Shows rate of cortex fetched keys.",
            "gridPos": {
              "x": 12,
              "y": 9,
              "w": 6,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job, tripperware) (rate(cortex_cache_fetched_keys_total{job=~\"$job\"}[$__rate_interval]))",
                "legend": "{{job}} {{tripperware}}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "short",
            "min": 0,
            "fill": 100,
            "stack": "normal"
          },
          {
            "id": "p8",
            "type": "timeseries",
            "title": "Cortex cache hits",
            "description": "Shows rate of cortex cache hits.",
            "gridPos": {
              "x": 18,
              "y": 9,
              "w": 6,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "sum by (job, tripperware) (rate(cortex_cache_hits_total{job=~\"$job\"}[$__rate_interval]))",
                "legend": "{{job}} {{tripperware}}",
                "interval": "10s",
                "intervalFactor": 2
              }
            ],
            "unit": "short",
            "min": 0,
            "fill": 100,
            "stack": "normal"
          }
        ]
      },
      {
        "id": "p14",
        "type": "row",
        "title": "Resources",
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 24,
          "h": 1
        },
        "collapsed": true,
        "panels": [
          {
            "id": "p9",
            "type": "timeseries",
            "title": "Memory Used",
            "gridPos": {
              "x": 0,
              "y": 17,
              "w": 8,
              "h": 7
            },
            "datasource": "${datasource}",
            "queries": [
              {
                "query": "go_memstats_alloc_bytes{job=~\"$job\"}",
                "legend": "alloc all {{instance}}",
                "interval": "10s",
                "intervalFactor": 2
              },
              {
                "query": "go_memstats_heap_alloc_bytes{job=~\"$job\"}",
                "legend": "alloc heap {{instance}}",
                "interval": "10s",
                "intervalFactor": 2
              },
              {
                "query": "rate(go_memstats_alloc_bytes_total{job=~\"$job\"}[30s])",
                "legend": "alloc rate all {{instance}}",
                "interval": "10s",
                "intervalFactor": 2
              },
              {
                "query": "rate(go_memstats_heap_alloc_bytes{job=~\"$job\"}[30s])",
                "legend": "alloc rate heap {{instance}}",
                "interval": "10s",
                "intervalFactor": 2
              },
              {
                "query": "go_memstats_stack_inuse_bytes{job=~\"$job\"}",
