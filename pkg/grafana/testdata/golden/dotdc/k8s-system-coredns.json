  "spec": {
    "specVersion": "0",
    "title": "Kubernetes / System / CoreDNS",
    "description": "This is a modern CoreDNS dashboard for your Kubernetes cluster(s). Made for kube-prometheus-stack and take advantage of the latest Grafana features. GitHub repository: https://github.com/dotdc/grafana-dashboards-kubernetes",
    "tags": [
      "kubernetes",
      "prometheus"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "cursorSync": "crosshair",
    "variables": [
      {
        "name": "datasource",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(kube_node_info,cluster)",
        "sort": "alpha"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(coredns_build_info{cluster=\"$cluster\"},job)",
        "sort": "alpha",
        "multi": true,
        "default": [
          "coredns"
        ]
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(up{job=\"$job\", cluster=\"$cluster\"},instance)",
        "sort": "alpha",
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "protocol",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(coredns_dns_requests_total{cluster=\"$cluster\"}, proto)",
        "sort": "alpha",
        "allValue": "udp,tcp",
        "default": "udp"
      },
      {
        "name": "resolution",
        "type": "custom",
        "options": [
          "1s",
          "15s",
          "30s",
          "1m",
          "3m",
          "5m"
        ],
        "default": "30s"
      }
    ],
    "panels": [
      {
        "id": "p25",
        "type": "stat",
        "title": "CoreDNS - Health Status",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 3
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "up{job=~\"$job\", instance=~\"$instance\", cluster=~\"$cluster\"}",
            "legend": "{{ instance }}"
          }
        ],
        "thresholds": [
          {
            "color": "critical"
          },
          {
            "value": 1,
            "color": "ok"
          }
        ],
        "mappings": [
          {
            "value": "0",
            "text": "DOWN"
          },
          {
            "value": "1",
            "text": "UP"
          }
        ],
        "display": {
          "colorMode": "background",
          "graph": false,
          "textMode": "valueAndName",
          "orientation": "vertical"
        }
      },
      {
        "id": "p19",
        "type": "timeseries",
        "title": "CoreDNS - CPU Usage by instance",
        "gridPos": {
          "x": 0,
          "y": 3,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "rate(process_cpu_seconds_total{job=~\"$job\", instance=~\"$instance\", cluster=~\"$cluster\"}[$__rate_interval])",
            "legend": "{{ instance }}"
          }
        ],
        "unit": "percentunit",
        "decimals": 2,
        "fill": 25
      },
      {
        "id": "p21",
        "type": "timeseries",
        "title": "CoreDNS - Memory Usage by instance",
        "gridPos": {
          "x": 12,
          "y": 3,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "process_resident_memory_bytes{job=~\"$job\", instance=~\"$instance\", cluster=~\"$cluster\"}",
            "legend": "{{ instance }}"
          }
        ],
        "unit": "bytes",
        "fill": 25
      },
      {
        "id": "p9",
        "type": "timeseries",
        "title": "CoreDNS - Total DNS Requests ($protocol)",
        "gridPos": {
          "x": 0,
          "y": 11,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(rate(coredns_dns_requests_total{instance=~\"$instance\",proto=\"$protocol\", cluster=~\"$cluster\", job=~\"$job\"}[$__rate_interval]))",
            "legend": "total $protocol requests"
          }
        ],
        "unit": "short",
        "fill": 25,
        "display": {
          "legend": "hidden",
          "tooltip": "all"
        }
      },
      {
        "id": "p7",
        "type": "timeseries",
        "title": "CoreDNS - Average Packet Size  ($protocol)",
        "gridPos": {
          "x": 12,
          "y": 11,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(rate(coredns_dns_request_size_bytes_sum{instance=~\"$instance\",proto=\"$protocol\", cluster=~\"$cluster\", job=~\"$job\"}[$__rate_interval])) by (proto) / sum(rate(coredns_dns_request_size_bytes_count{instance=~\"$instance\",proto=\"$protocol\", cluster=~\"$cluster\", job=~\"$job\"}[$__rate_interval])) by (proto)",
            "legend": "average $protocol packet size"
          }
        ],
        "unit": "bytes",
        "fill": 25,
        "display": {
          "legend": "hidden",
          "tooltip": "all"
        }
      },
      {
        "id": "p2",
        "type": "timeseries",
        "title": "CoreDNS - Requests by type",
        "gridPos": {
          "x": 0,
          "y": 19,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(rate(coredns_dns_requests_total{instance=~\"$instance\", cluster=~\"$cluster\", job=~\"$job\"}[$__rate_interval])) by (type)",
            "legend": "{{ type }}"
          }
        ],
        "unit": "short",
        "fill": 25,
        "display": {
          "tooltip": "all"
        }
      },
      {
        "id": "p4",
        "type": "timeseries",
        "title": "CoreDNS - Requests by return code",
        "gridPos": {
          "x": 12,
          "y": 19,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(rate(coredns_dns_responses_total{instance=~\"$instance\", cluster=~\"$cluster\", job=~\"$job\"}[$__rate_interval])) by (rcode)",
            "legend": "{{ rcode }}"
          }
        ],
        "unit": "short",
        "fill": 25,
        "display": {
          "tooltip": "all"
        }
      },
      {
        "id": "p23",
        "type": "timeseries",
        "title": "CoreDNS - Total Forward Requests",
        "gridPos": {
          "x": 0,
          "y": 27,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(rate(coredns_proxy_request_duration_seconds_count{proxy_name=\"forward\", cluster=~\"$cluster\", job=~\"$job\"}[$__rate_interval]))",
            "legend": "total forward requests"
          }
        ],
        "unit": "short",
        "fill": 25,
        "display": {
          "legend": "hidden",
          "tooltip": "all"
        }
      },
      {
        "id": "p13",
        "type": "timeseries",
        "title": "CoreDNS - DNS Errors",
        "gridPos": {
          "x": 12,
          "y": 27,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(rate(coredns_proxy_request_duration_seconds_count{proxy_name=\"forward\", rcode=~\"SERVFAIL|REFUSED\", cluster=~\"$cluster\", job=~\"$job\"}[$__rate_interval])) by (rcode)",
            "legend": "{{ rcode }}"
          }
        ],
        "unit": "short",
        "fill": 25,
        "display": {
          "tooltip": "all"
        }
      },
      {
        "id": "p17",
        "type": "timeseries",
        "title": "CoreDNS - Cache Hits / Misses",
        "gridPos": {
          "x": 0,
          "y": 35,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(rate(coredns_cache_hits_total{instance=~\"$instance\", cluster=~\"$cluster\", job=~\"$job\"}[$__rate_interval])) by (type)",
            "legend": "{{ type }}"
          },
          {
            "query": "sum(rate(coredns_cache_misses_total{instance=~\"$instance\", cluster=~\"$cluster\", job=~\"$job\"}[$__rate_interval])) by (type)",
            "legend": "misses"
          }
        ],
        "unit": "short",
        "fill": 25,
        "display": {
          "tooltip": "all"
        }
      },
      {
        "id": "p15",
        "type": "timeseries",
        "title": "CoreDNS - Cache Size",
        "gridPos": {
          "x": 12,
