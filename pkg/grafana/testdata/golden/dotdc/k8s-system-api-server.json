  "spec": {
    "specVersion": "0",
    "title": "Kubernetes / System / API Server",
    "description": "This is a modern API Server dashboard for your Kubernetes cluster(s). Made for kube-prometheus-stack and take advantage of the latest Grafana features. GitHub repository: https://github.com/dotdc/grafana-dashboards-kubernetes",
    "tags": [
      "kubernetes",
      "prometheus"
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "cursorSync": "crosshair",
    "variables": [
      {
        "name": "datasource",
        "type": "datasource",
        "datasourceType": "prometheus",
        "default": "prom"
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(kube_node_info,cluster)",
        "sort": "alpha",
        "allowCustomValue": true
      },
      {
        "name": "resolution",
        "type": "interval",
        "options": [
          "1s",
          "15s",
          "30s",
          "1m",
          "3m",
          "5m"
        ],
        "default": "30s"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(apiserver_request_total{cluster=\"$cluster\"}, job)",
        "sort": "alpha",
        "multi": true,
        "allowCustomValue": true
      }
    ],
    "panels": [
      {
        "id": "p42",
        "type": "stat",
        "title": "API Server - Health Status",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "up{cluster=~\"$cluster\", job=~\"$job\"}",
            "legend": "{{ instance }}"
          }
        ],
        "thresholds": [
          {
            "color": "critical"
          },
          {
            "value": 1,
            "color": "ok"
          }
        ],
        "mappings": [
          {
            "value": "0",
            "text": "DOWN"
          },
          {
            "value": "1",
            "text": "UP"
          }
        ],
        "display": {
          "colorMode": "background",
          "graph": false,
          "textMode": "valueAndName",
          "orientation": "horizontal"
        }
      },
      {
        "id": "p60",
        "type": "table",
        "title": "Deprecated Kubernetes Resources",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "apiserver_requested_deprecated_apis{cluster=~\"$cluster\"}"
          }
        ],
        "transform": [
          {
            "type": "labelsToFields",
            "include": [
              "group",
              "job",
              "removed_release",
              "resource",
              "version",
              "name"
            ]
          },
          {
            "type": "merge"
          },
          {
            "type": "organize",
            "exclude": [
              "Time",
              "Value",
              "job"
            ],
            "order": [
              "namespace",
              "group",
              "version",
              "resource",
              "removed_release",
              "job",
              "Time",
              "Value"
            ]
          }
        ]
      },
      {
        "id": "p38",
        "type": "timeseries",
        "title": "API Server - HTTP Requests by code",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum by (code) (rate(apiserver_request_total{cluster=~\"$cluster\"}[$__rate_interval]))",
            "legend": "{{ code }}",
            "interval": "${resolution}"
          }
        ],
        "unit": "short",
        "fill": 25,
        "lineInterpolation": "smooth",
        "points": "never",
        "display": {
          "tooltip": "all"
        }
      },
      {
        "id": "p39",
        "type": "timeseries",
        "title": "API Server - HTTP Requests by verb",
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum by (verb) (rate(apiserver_request_total{cluster=~\"$cluster\"}[$__rate_interval]))",
            "legend": "{{ verb}}",
            "interval": "${resolution}"
          }
        ],
        "unit": "short",
        "fill": 25,
        "lineInterpolation": "smooth",
        "points": "never",
        "display": {
          "tooltip": "all"
        }
      },
      {
        "id": "p53",
        "type": "timeseries",
        "title": "API Server - HTTP Requests Latency by instance",
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(rate(apiserver_request_duration_seconds_sum{cluster=~\"$cluster\", job=~\"$job\"}[$__rate_interval])) by (instance)\n/\nsum(rate(apiserver_request_duration_seconds_count{cluster=~\"$cluster\", job=~\"$job\"}[$__rate_interval])) by (instance)",
            "legend": "{{ instance }}",
            "interval": "${resolution}"
          }
        ],
        "unit": "ms",
        "fill": 25,
        "lineInterpolation": "smooth",
        "points": "never"
      },
      {
        "id": "p54",
        "type": "timeseries",
        "title": "API Server - HTTP Requests Latency by verb",
        "gridPos": {
          "x": 12,
          "y": 16,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(rate(apiserver_request_duration_seconds_sum{cluster=~\"$cluster\", job=~\"$job\"}[$__rate_interval])) by (verb)\n/\nsum(rate(apiserver_request_duration_seconds_count{cluster=~\"$cluster\", job=~\"$job\"}[$__rate_interval])) by (verb)",
            "legend": "{{ verb }}",
            "interval": "${resolution}"
          }
        ],
        "unit": "ms",
        "fill": 25,
        "lineInterpolation": "smooth",
        "points": "never",
        "display": {
          "tooltip": "all"
        }
      },
      {
        "id": "p50",
        "type": "timeseries",
        "title": "API Server - Errors by Instance",
        "gridPos": {
          "x": 0,
          "y": 24,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum by(instance) (rate(apiserver_request_total{code=~\"5..\", cluster=~\"$cluster\", job=~\"$job\"}[$__rate_interval]))\n / (sum by(instance) (rate(apiserver_request_total{cluster=~\"$cluster\", job=~\"$job\"}[$__rate_interval])) > 0)",
            "legend": "{{ instance }}",
            "interval": "${resolution}"
          }
        ],
        "unit": "short",
        "fill": 25,
        "lineInterpolation": "smooth",
        "points": "never"
      },
      {
        "id": "p51",
        "type": "timeseries",
        "title": "API Server - Errors by verb",
        "gridPos": {
          "x": 12,
          "y": 24,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum by(verb) (rate(apiserver_request_total{code=~\"5..\", cluster=~\"$cluster\", job=~\"$job\"}[$__rate_interval]))\n / (sum by(verb) (rate(apiserver_request_total{cluster=~\"$cluster\", job=~\"$job\"}[$__rate_interval])) > 0)",
            "legend": "{{ verb }}",
            "interval": "${resolution}"
          }
        ],
        "unit": "short",
        "fill": 25,
        "lineInterpolation": "smooth",
        "points": "never",
        "display": {
          "tooltip": "all"
        }
      },
      {
        "id": "p40",
        "type": "timeseries",
        "title": "API Server - Stacked HTTP Requests by instance",
        "gridPos": {
          "x": 0,
          "y": 32,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(rate(apiserver_request_total{cluster=~\"$cluster\"}[$__rate_interval])) by (instance)",
            "legend": "{{ instance }}",
            "interval": "${resolution}"
          }
        ],
        "unit": "short",
        "fill": 25,
        "lineInterpolation": "smooth",
        "points": "never",
        "stack": "normal"
      },
      {
        "id": "p56",
        "type": "timeseries",
        "title": "API Server - Work Queue by instance",
        "gridPos": {
          "x": 12,
          "y": 32,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "sum(workqueue_depth{cluster=~\"$cluster\", job=~\"$job\"}) by (instance)",
            "legend": "{{ instance }}",
            "interval": "${resolution}"
          }
        ],
        "unit": "short",
        "fill": 25,
        "lineInterpolation": "smooth",
        "points": "never"
      },
      {
        "id": "p47",
        "type": "timeseries",
        "title": "API Server - CPU Usage by instance",
        "gridPos": {
          "x": 0,
          "y": 40,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "rate(process_cpu_seconds_total{cluster=~\"$cluster\", job=~\"$job\"}[$__rate_interval])",
            "legend": "{{ instance }}",
            "interval": "${resolution}"
          }
        ],
        "unit": "percent",
        "decimals": 2,
        "fill": 25,
        "lineInterpolation": "smooth",
        "points": "never"
      },
      {
        "id": "p48",
        "type": "timeseries",
        "title": "API Server - Memory Usage by instance",
        "gridPos": {
          "x": 12,
          "y": 40,
          "w": 12,
          "h": 8
        },
        "datasource": "${datasource}",
        "queries": [
          {
            "query": "process_resident_memory_bytes{cluster=~\"$cluster\", job=~\"$job\"}",
            "legend": "{{ instance }}",
            "interval": "${resolution}"
          }
        ],
        "unit": "bytes",
        "fill": 25,
        "lineInterpolation": "smooth",
        "points": "never"
      }
    ]
  }
