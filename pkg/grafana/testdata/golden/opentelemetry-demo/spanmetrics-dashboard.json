  "spec": {
    "specVersion": "0",
    "title": "Spanmetrics Demo Dashboard",
    "description": "Spanmetrics way of demo application view.",
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "refresh": "5m",
    "variables": [
      {
        "name": "service",
        "type": "query",
        "datasource": "prom",
        "query": "query_result(count by (service_name)(count_over_time(traces_span_metrics_calls_total[$__range])))",
        "regex": "/.*service_name=\"(.*)\".*/",
        "sort": "alpha",
        "refresh": "timeRange",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "allowCustomValue": true
      },
      {
        "name": "span_name",
        "type": "query",
        "datasource": "prom",
        "query": "query_result(sum ({__name__=~\".*traces_span_metrics_calls_total\",service_name=~\"$service\"})  by (span_name))",
        "regex": "/.*span_name=\"(.*)\".*/",
        "refresh": "timeRange",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "allowCustomValue": true
      }
    ],
    "panels": [
      {
        "id": "p26",
        "type": "text",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 2
        },
        "content": "This dashboard uses RED metrics generated for all services by the spanmetrics connector configured in the OpenTelemetry Collector.\n<br>\nChart panels may require 5 minutes after the Demo is started before rendering data."
      },
      {
        "id": "p24",
        "type": "row",
        "title": "Service Level - Throughput and Latencies",
        "gridPos": {
          "x": 0,
          "y": 2,
          "w": 24,
          "h": 1
        },
        "panels": [
          {
            "id": "p2",
            "type": "gauge",
            "title": "Top 3x3 - Service Latency - quantile95",
            "gridPos": {
              "x": 0,
              "y": 3,
              "w": 12,
              "h": 20
            },
            "datasource": "prom",
            "queries": [
              {
                "query": "topk(7,histogram_quantile(0.50, sum(rate(traces_span_metrics_duration_milliseconds_bucket{service_name=~\"$service\", span_name=~\"$span_name\"}[$__rate_interval])) by (le,service_name)))",
                "legend": "{{service_name}}-quantile_0.50",
                "hide": true
              },
              {
                "query": "topk(7,histogram_quantile(0.95, sum(rate(traces_span_metrics_duration_milliseconds_bucket{service_name=~\"$service\", span_name=~\"$span_name\"}[$__range])) by (le,service_name)))",
                "legend": "{{service_name}}",
                "instant": true
              },
              {
                "query": "histogram_quantile(0.99, sum(rate(traces_span_metrics_duration_milliseconds_bucket{service_name=~\"$service\", span_name=~\"$span_name\"}[$__rate_interval])) by (le,service_name))",
                "legend": "quantile99",
                "hide": true
              },
              {
                "query": "histogram_quantile(0.999, sum(rate(traces_span_metrics_duration_milliseconds_bucket{service_name=~\"$service\", span_name=~\"$span_name\"}[$__rate_interval])) by (le,service_name))",
                "legend": "quantile999",
                "hide": true
              }
            ],
            "unit": "ms",
            "thresholds": [
              {
                "color": "info"
              },
              {
                "value": 2,
                "color": "ok"
              },
              {
                "value": 64,
                "color": "warning"
              },
              {
                "value": 128,
                "color": "warning"
              },
              {
                "value": 256,
                "color": "critical"
              }
            ],
            "interval": "5m"
          },
          {
            "id": "p4",
            "type": "bargauge",
            "title": "Top 7 Services Mean Rate over Range",
            "gridPos": {
              "x": 12,
              "y": 3,
              "w": 12,
              "h": 13
            },
            "datasource": "prom",
            "queries": [
              {
                "query": "topk(7,sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"$service\", span_name=~\"$span_name\"}[$__range])))",
                "legend": "{{service_name}}",
                "instant": true
              }
            ],
            "unit": "reqps",
            "decimals": 2,
            "thresholds": [
              {
                "color": "ok"
              },
              {
                "value": 1,
                "color": "info"
              },
              {
                "value": 2,
                "color": "warning"
              },
              {
                "value": 10,
                "color": "critical"
              }
            ],
            "interval": "5m",
            "display": {
              "reduce": "mean",
              "orientation": "horizontal",
              "barStyle": "lcd"
            }
          },
          {
            "id": "p15",
            "type": "bargauge",
