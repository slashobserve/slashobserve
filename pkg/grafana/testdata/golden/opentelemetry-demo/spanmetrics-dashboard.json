            "gridPos": {
              "x": 0,
              "y": 24,
              "w": 24,
              "h": 11
            },
            "datasource": "prom",
            "queries": [
              {
                "ref": "Rate",
                "query": "topk(7, sum(rate(traces_span_metrics_calls_total{service_name=~\"$service\", span_name=~\"$span_name\"}[$__range])) by (span_name,service_name)) ",
                "instant": true,
                "format": "table"
              },
              {
                "query": "topk(7, sum(rate(traces_span_metrics_calls_total{status_code=\"STATUS_CODE_ERROR\",service_name=~\"$service\", span_name=~\"$span_name\"}[$__range])) by (span_name,service_name))",
                "instant": true,
                "format": "table"
              }
            ],
            "unit": "reqps",
            "decimals": 2,
            "transform": [
              {
                "type": "joinByField",
                "field": "span_name"
              },
              {
                "type": "organize",
                "exclude": [
                  "Time 1",
                  "Time 2"
                ],
                "rename": {
                  "Value #Error Rate": "Error Rate",
                  "Value #Rate": "Rate",
                  "service_name 1": "Rate in Service",
                  "service_name 2": "Error Rate in Service"
                }
              },
              {
                "type": "calculateField",
                "alias": "bRate",
                "reduceRow": "sum"
              },
              {
                "type": "calculateField",
                "alias": "eRate",
                "reduceRow": "sum"
              },
              {
                "type": "organize",
                "exclude": [
                  "Error Rate",
                  "Rate"
                ],
                "rename": {
                  "Rate in Service": "Service",
                  "bRate": "Rate",
                  "eRate": "Error Rate",
                  "span_name": "span_name Name"
                },
                "order": [
                  "span_name",
                  "Rate",
                  "bRate",
                  "eRate",
                  "Error Rate",
                  "Rate in Service",
                  "Error Rate in Service"
                ]
              },
              {
                "type": "sortBy",
                "field": "Rate",
                "desc": true
              }
            ],
            "interval": "5m"
          }
        ]
