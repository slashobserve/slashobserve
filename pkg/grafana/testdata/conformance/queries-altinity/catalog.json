    { "id": "query=macro-delta", "path": "query", "value": "$delta(bytes) FROM $table" },
    { "id": "query=macro-deltaColumns", "path": "query", "value": "$deltaColumns(status, bytes) FROM $table" },
    { "id": "query=macro-deltaColumnsAggregated", "path": "query", "value": "$deltaColumnsAggregated(service, status, bytes) FROM $table" },
    { "id": "query=macro-increase", "path": "query", "value": "$increase(bytes) FROM $table" },
