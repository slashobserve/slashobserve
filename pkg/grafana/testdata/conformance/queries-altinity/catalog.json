    { "id": "query=macro-increaseColumnsAggregated", "path": "query", "value": "$increaseColumnsAggregated(service, status, bytes) FROM $table" },
    { "id": "query=macro-columns", "path": "query", "value": "$columns(status, count() c) FROM $table" },
    { "id": "query=macro-columnsMs", "path": "query", "value": "$columnsMs(status, count() c) FROM $table" },
    { "id": "query=macro-lttb", "path": "query", "value": "$lttb(100, t, c) FROM (SELECT $timeSeries AS t, count() AS c FROM $table GROUP BY t)" },
    { "id": "query=macro-lttbMs", "path": "query", "value": "$lttbMs(100, t, c) FROM (SELECT $timeSeriesMs AS t, count() AS c FROM $table GROUP BY t)" },
    { "id": "query=macro-adhoc", "path": "query", "value": "SELECT count() FROM $table WHERE $adhoc" },
    { "id": "query=macro-unescape", "path": "query", "value": "SELECT count() FROM $table WHERE window = $unescape($res)" },
    { "id": "query=macro-conditionalTest", "path": "query", "value": "SELECT count() FROM $table WHERE $conditionalTest(window IN ($res), $res)" },
