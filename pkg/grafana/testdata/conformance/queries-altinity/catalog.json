    { "id": "query=macro-table", "path": "query", "value": "SELECT count() FROM $table" },
    { "id": "query=macro-dateCol", "path": "query", "value": "SELECT $dateCol, count() FROM $table GROUP BY 1", "with": {"dateColDataType": "event_date"} },
    { "id": "query=macro-dateTimeCol", "path": "query", "value": "SELECT $dateTimeCol, count() FROM $table GROUP BY 1" },
    { "id": "query=macro-from", "path": "query", "value": "SELECT count() FROM $table WHERE timestamp >= $from" },
    { "id": "query=macro-to", "path": "query", "value": "SELECT count() FROM $table WHERE timestamp <= $to" },
    { "id": "query=macro-interval", "path": "query", "value": "SELECT intDiv(toUInt32(timestamp), $interval) AS bucket, count() FROM $table GROUP BY bucket" },
    { "id": "query=macro-timeFilter", "path": "query", "value": "SELECT count() FROM $table WHERE $timeFilter", "with": {"dateColDataType": "event_date"} },
    { "id": "query=macro-timeFilterMs", "path": "query", "value": "SELECT count() FROM $table WHERE $timeFilterMs" },
    { "id": "query=macro-timeFilterByColumn", "path": "query", "value": "SELECT count() FROM $table WHERE $timeFilterByColumn(created_at)" },
    { "id": "query=macro-timeFilter64ByColumn", "path": "query", "value": "SELECT count() FROM $table WHERE $timeFilter64ByColumn(created_at)" },
    { "id": "query=macro-timeSeries", "path": "query", "value": "SELECT $timeSeries AS t, count() FROM $table GROUP BY t" },
    { "id": "query=macro-timeSeriesMs", "path": "query", "value": "SELECT $timeSeriesMs AS t, count() FROM $table GROUP BY t" },
    { "id": "query=macro-naturalTimeSeries", "path": "query", "value": "SELECT $naturalTimeSeries AS t, count() FROM $table GROUP BY t" },
    { "id": "query=macro-rate", "path": "query", "value": "$rate(count() c) FROM $table" },
    { "id": "query=macro-rateColumns", "path": "query", "value": "$rateColumns(status, count()) FROM $table" },
    { "id": "query=macro-rateColumnsAggregated", "path": "query", "value": "$rateColumnsAggregated(service, status, count() c, sum(bytes) b) FROM $table" },
    { "id": "query=macro-perSecond", "path": "query", "value": "$perSecond(bytes) FROM $table" },
    { "id": "query=macro-perSecondColumns", "path": "query", "value": "$perSecondColumns(status, bytes) FROM $table" },
