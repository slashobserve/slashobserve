{
  "grafana": "v12.3.0",
  "sources": [
    "kinds/dashboard/dashboard_kind.cue",
    "apps/dashboard/pkg/apis/dashboard/v2beta1/dashboard_spec.cue"
  ],
  "root": "templating.list[0]",
  "entries": [
    { "id": "query=label-values-instance", "path": "query", "value": "label_values(up, instance)" },
    { "id": "query=object-form", "path": "query", "value": {"query": "label_values(up, instance)", "refId": "PrometheusVariableQueryEditor-VariableQuery"} },
    { "id": "query=label-names", "path": "query", "value": "label_names()" },
    { "id": "query=metrics", "path": "query", "value": "metrics(node_.*)" },
    { "id": "query=query-result", "path": "query", "value": "query_result(count by (job) (up))" },
    { "id": "datasource=clickhouse", "path": "datasource", "value": {"type": "grafana-clickhouse-datasource", "uid": "ch"}, "with": {"query": {"rawSql": "SELECT DISTINCT ServiceName FROM otel_traces", "refId": "A"}} },
    { "id": "datasource=loki", "path": "datasource", "value": {"type": "loki", "uid": "loki"}, "with": {"query": "label_values({app=\"web\"}, pod)"} },
    { "id": "datasource=elasticsearch", "path": "datasource", "value": {"type": "elasticsearch", "uid": "es"}, "with": {"query": "{\"find\": \"terms\", \"field\": \"host\", \"query\": \"env:prod\"}"} },
    { "id": "datasource=opensearch", "path": "datasource", "value": {"type": "grafana-opensearch-datasource", "uid": "os"}, "with": {"query": "{\"find\": \"terms\", \"field\": \"host\"}"} },
    { "id": "query=elasticsearch-fields", "path": "query", "value": "{\"find\": \"fields\", \"type\": \"keyword\"}", "with": {"datasource": {"type": "elasticsearch", "uid": "es"}}, "expect": "excluded" },
    { "id": "query=elasticsearch-size", "path": "query", "value": "{\"find\": \"terms\", \"field\": \"host\", \"size\": 50}", "with": {"datasource": {"type": "elasticsearch", "uid": "es"}}, "expect": "convert_noted" },
    { "id": "refresh=0", "path": "refresh", "value": 0, "with": {"options": [{"text": "api", "value": "api", "selected": true}]} },
    { "id": "refresh=2", "path": "refresh", "value": 2 },
    { "id": "sort=1", "path": "sort", "value": 1 },
    { "id": "sort=2", "path": "sort", "value": 2 },
    { "id": "sort=3", "path": "sort", "value": 3 },
    { "id": "sort=4", "path": "sort", "value": 4 },
    { "id": "sort=5", "path": "sort", "value": 5 },
    { "id": "sort=6", "path": "sort", "value": 6 },
    { "id": "sort=7", "path": "sort", "value": 7 },
    { "id": "sort=8", "path": "sort", "value": 8 },
    { "id": "regex=filter", "path": "regex", "value": "/prod-.*/" },
    { "id": "regex=capture-group", "path": "regex", "value": "/prod-(.*)/" },
    { "id": "regex=named-groups", "path": "regex", "value": "/(?<text>[^:]+):(?<value>.*)/" },
    { "id": "regexApplyTo=text", "path": "regexApplyTo", "value": "text", "with": {"regex": "/prod-.*/"}, "expect": "convert_noted" },
    { "id": "regex=case-insensitive-flag", "path": "regex", "value": "/(.*)-api/i" },
    { "id": "multi=true", "path": "multi", "value": true },
    { "id": "includeAll=true", "path": "includeAll", "value": true },
    { "id": "allValue=regex-all", "path": "allValue", "value": ".*", "with": {"includeAll": true} },
    { "id": "allowCustomValue=false", "path": "allowCustomValue", "value": false },
    { "id": "current=b", "path": "current", "value": {"text": "b", "value": "b"} },
    { "id": "current=list", "path": "current", "value": {"text": ["a", "b"], "value": ["a", "b"]}, "with": {"multi": true} },
    { "id": "current=all", "path": "current", "value": {"text": "All", "value": "$__all"}, "with": {"includeAll": true} },
    { "id": "hide=1", "path": "hide", "value": 1 },
    { "id": "hide=2", "path": "hide", "value": 2 },
    { "id": "hide=3", "path": "hide", "value": 3, "expect": "excluded" },
    { "id": "label=Pod", "path": "label", "value": "Pod" },
    { "id": "description=text", "path": "description", "value": "Pick a pod" },
    { "id": "skipUrlSync=true", "path": "skipUrlSync", "value": true },
    { "id": "options=saved", "path": "options", "value": [{"selected": true, "text": "a", "value": "a"}], "expect": "bookkeeping" },
    { "id": "staticOptions=none-option", "path": "staticOptions", "value": [{"text": "None", "value": ""}] },
    { "id": "staticOptionsOrder=before", "path": "staticOptionsOrder", "value": "before", "with": {"staticOptions": [{"text": "None", "value": ""}]} },
    { "id": "staticOptionsOrder=after", "path": "staticOptionsOrder", "value": "after", "with": {"staticOptions": [{"text": "None", "value": ""}]} },
    { "id": "staticOptionsOrder=sorted", "path": "staticOptionsOrder", "value": "sorted", "with": {"staticOptions": [{"text": "None", "value": ""}]} },
    {"id": "current.selected=true", "path": "current.selected", "value": true, "expect": "bookkeeping"},
    {"id": "current.isNone=true", "path": "current.isNone", "value": true, "expect": "bookkeeping"},
    {"id": "definition=label-values", "path": "definition", "value": "label_values(up, job)", "expect": "bookkeeping"},
    {"id": "useTags=true", "path": "useTags", "value": true, "expect": "bookkeeping"},
    {"id": "query.add_metadata=state", "path": "query.add_metadata", "value": false, "with": {"datasource": {"type": "grafana-clickhouse-datasource", "uid": "ch"}, "query": {"rawSql": "SELECT DISTINCT ServiceName FROM otel_traces", "refId": "A"}}, "expect": "bookkeeping"},
    {"id": "query.contextWindowSize=state", "path": "query.contextWindowSize", "value": "10", "with": {"datasource": {"type": "grafana-clickhouse-datasource", "uid": "ch"}, "query": {"rawSql": "SELECT DISTINCT ServiceName FROM otel_traces", "refId": "A"}}, "expect": "bookkeeping"},
    {"id": "query.datasourceMode=state", "path": "query.datasourceMode", "value": "multi", "with": {"datasource": {"type": "grafana-clickhouse-datasource", "uid": "ch"}, "query": {"rawSql": "SELECT DISTINCT ServiceName FROM otel_traces", "refId": "A"}}, "expect": "bookkeeping"},
    {"id": "query.editorMode=state", "path": "query.editorMode", "value": "builder", "with": {"datasource": {"type": "grafana-clickhouse-datasource", "uid": "ch"}, "query": {"rawSql": "SELECT DISTINCT ServiceName FROM otel_traces", "refId": "A"}}, "expect": "bookkeeping"},
    {"id": "query.editorType=state", "path": "query.editorType", "value": "sql", "with": {"datasource": {"type": "grafana-clickhouse-datasource", "uid": "ch"}, "query": {"rawSql": "SELECT DISTINCT ServiceName FROM otel_traces", "refId": "A"}}, "expect": "bookkeeping"},
    {"id": "query.extrapolate=state", "path": "query.extrapolate", "value": true, "with": {"datasource": {"type": "grafana-clickhouse-datasource", "uid": "ch"}, "query": {"rawSql": "SELECT DISTINCT ServiceName FROM otel_traces", "refId": "A"}}, "expect": "bookkeeping"},
    {"id": "query.format=state", "path": "query.format", "value": 1, "with": {"datasource": {"type": "grafana-clickhouse-datasource", "uid": "ch"}, "query": {"rawSql": "SELECT DISTINCT ServiceName FROM otel_traces", "refId": "A"}}, "expect": "bookkeeping"},
    {"id": "query.formattedQuery=state", "path": "query.formattedQuery", "value": "SELECT 1", "with": {"datasource": {"type": "grafana-clickhouse-datasource", "uid": "ch"}, "query": {"rawSql": "SELECT DISTINCT ServiceName FROM otel_traces", "refId": "A"}}, "expect": "bookkeeping"},
    {"id": "query.intervalFactor=state", "path": "query.intervalFactor", "value": 2, "with": {"datasource": {"type": "grafana-clickhouse-datasource", "uid": "ch"}, "query": {"rawSql": "SELECT DISTINCT ServiceName FROM otel_traces", "refId": "A"}}, "expect": "bookkeeping"},
    {"id": "query.qryType=state", "path": "query.qryType", "value": "sql", "with": {"datasource": {"type": "grafana-clickhouse-datasource", "uid": "ch"}, "query": {"rawSql": "SELECT DISTINCT ServiceName FROM otel_traces", "refId": "A"}}, "expect": "bookkeeping"},
    {"id": "query.rawQuery=state", "path": "query.rawQuery", "value": "SELECT 1", "with": {"datasource": {"type": "grafana-clickhouse-datasource", "uid": "ch"}, "query": {"rawSql": "SELECT DISTINCT ServiceName FROM otel_traces", "refId": "A"}}, "expect": "bookkeeping"},
    {"id": "query.rawSql=distinct-service", "path": "query.rawSql", "value": "SELECT DISTINCT ServiceName FROM otel_traces", "with": {"datasource": {"type": "grafana-clickhouse-datasource", "uid": "ch"}, "query": {"rawSql": "SELECT 1", "refId": "A"}}},
    {"id": "query.round=state", "path": "query.round", "value": "0s", "with": {"datasource": {"type": "grafana-clickhouse-datasource", "uid": "ch"}, "query": {"rawSql": "SELECT DISTINCT ServiceName FROM otel_traces", "refId": "A"}}, "expect": "bookkeeping"},
    {"id": "query.skip_comments=state", "path": "query.skip_comments", "value": true, "with": {"datasource": {"type": "grafana-clickhouse-datasource", "uid": "ch"}, "query": {"rawSql": "SELECT DISTINCT ServiceName FROM otel_traces", "refId": "A"}}, "expect": "bookkeeping"},
    {"id": "query.useWindowFuncForMacros=state", "path": "query.useWindowFuncForMacros", "value": true, "with": {"datasource": {"type": "grafana-clickhouse-datasource", "uid": "ch"}, "query": {"rawSql": "SELECT DISTINCT ServiceName FROM otel_traces", "refId": "A"}}, "expect": "bookkeeping"}
  ]
}
