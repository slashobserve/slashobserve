    {
      "id": 6,
      "type": "nodeGraph",
      "title": "Service map",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.5.1",
          "queryType": "table",
          "rawSql": "SELECT ServiceName AS id, ServiceName AS title, toString(count()) AS mainstat, toString(round(avg(Duration) / 1000000, 1)) AS secondarystat, (count() - countIf(StatusCode = 'Error')) / count() AS arc__success, countIf(StatusCode = 'Error') / count() AS arc__errors FROM otel_traces WHERE $__timeFilter(Timestamp) GROUP BY ServiceName LIMIT 30",
          "refId": "nodes"
        },
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.5.1",
          "queryType": "table",
          "rawSql": "SELECT concat(p.ServiceName, '-', c.ServiceName) AS id, p.ServiceName AS source, c.ServiceName AS target, count() AS mainstat FROM otel_traces AS c INNER JOIN otel_traces AS p ON c.ParentSpanId = p.SpanId AND c.TraceId = p.TraceId WHERE $__timeFilter(c.Timestamp) AND p.ServiceName != c.ServiceName GROUP BY source, target LIMIT 50",
          "refId": "edges"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "edges": {
          "mainStatUnit": "ms"
        },
        "layoutAlgorithm": "force",
        "nodes": {
          "arcs": [
            {
              "color": "green",
              "field": "arc__success"
            },
            {
              "color": "red",
              "field": "arc__errors"
            }
          ],
          "mainStatUnit": "ms",
          "secondaryStatUnit": "percentunit"
        },
        "zoomMode": "cooperative"
      }
    },
