        {"call":{"name":"update_panels","raw":"{\"n\": 1}"},"expect":{"verdict":"refuse","step":"Refused update_panels: the same save was sent again"}},
        {"check":{"usage":{"repair_rounds":0}}}
      ]
    },
    {
      "name": "a forgotten save can be sent again unchanged",
      "source": "TestAForgottenSaveCanBeSentAgainUnchanged",
