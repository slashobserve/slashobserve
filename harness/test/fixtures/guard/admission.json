    {
      "name": "reordered keys are one read",
      "source": "one call key",
      "start": {"mode":"create"},
      "steps": [
        {"turn":{"saves":0}},
        {"call":{"name":"get_panels","input":{"a":1,"b":2}},"expect":{"verdict":"dispatch"}},
        {"call":{"name":"get_panels","raw":"{\"b\":2,\"a\":1}"},"expect":{"verdict":"reuse","reuse_of":0}},
        {"turn":{"saves":1}},
        {"call":{"name":"update_panels","input":{"a":1,"b":2}},"expect":{"verdict":"dispatch"}},
        {"turn":{"saves":1}},
        {"call":{"name":"update_panels","raw":"{\"b\": 2, \"a\": 1}"},"expect":{"verdict":"refuse","step":"Refused update_panels: the same save was sent again"}}
