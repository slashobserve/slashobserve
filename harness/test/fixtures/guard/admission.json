    {
      "name": "a turn reuses a duplicate read and refuses a second save",
      "source": "TestAdmitOrdersAThreeReadTurnWithADuplicateAndTwoSaves",
      "start": {"mode":"create"},
      "steps": [
        {"turn":{"saves":2}},
        {"call":{"name":"get_panels","input":{"a":1}},"expect":{"verdict":"dispatch"}},
        {"call":{"name":"list_metrics","input":{}},"expect":{"verdict":"dispatch"}},
        {"call":{"name":"get_panels","raw":"{ \"a\": 1 }"},"expect":{"verdict":"reuse","reuse_of":0,"step":"Reused the result of an identical call"}},
        {"call":{"name":"update_panels","input":{"n":1}},"expect":{"verdict":"dispatch"}},
        {"call":{"name":"update_panels","input":{"n":2}},"expect":{"verdict":"refuse"}},
        {"turn":{"saves":2}},
        {"call":{"name":"update_panels","input":{"n":2}},"expect":{"verdict":"dispatch"}},
        {"call":{"name":"update_dashboard","input":{}},"expect":{"verdict":"refuse","code":"invalid_request","message":"only one save per turn","step":"The update_dashboard call was sent back for a fix: it was a second save in the same turn"}}
      ]
    },
    {
      "name": "a read refused as repeated is reused, not answered, in the same turn",
      "source": "TestAdmitRefusesAReadOfARefusedKeyAgainInTheSameTurn",
      "start": {"mode":"create"},
      "steps": [
        {"turn":{"saves":0}},
        {"call":{"name":"get_panels","input":{}},"result":{"is_error":true}},
        {"turn":{"saves":0}},
        {"call":{"name":"get_panels","input":{}},"result":{"is_error":true}},
        {"turn":{"saves":0}},
        {"call":{"name":"get_panels","input":{}},"expect":{"verdict":"refuse","step":"Refused get_panels: the same read was asked 3 times"}},
        {"call":{"name":"get_panels","input":{}},"expect":{"verdict":"reuse","reuse_of":0}},
        {"end_turn":{"stop":null}},
        {"check":{"usage":{"stalled_turns":1}}}
      ]
    },
    {
      "name": "save_finding is refused once the run builds",
      "source": "TestAdmitRefusesSaveFindingOnceBuilding",
      "start": {"mode":"create","building":true},
      "steps": [
        {"turn":{"saves":1}},
        {"call":{"name":"save_finding","input":{}},"expect":{"verdict":"refuse","step":"The save_finding call was sent back for a fix: this run is building a dashboard, so it cannot save an answer","message":"this run already saved panels; finish the dashboard instead of saving a finding"}}
      ]
    },
    {
      "name": "a save after a rejection is a repair, and its repeat is refused",
      "source": "TestAdmitRefusesARepeatedSaveAndMarksARepairPhase",
