{
  "about": "Reads, saves and their identity: replays, reuse, repeated calls and the one save per turn.",
  "traces": [
    {
      "name": "a repeated save is refused, and a restart forgets the saves",
      "source": "TestStateRefusesARepeatedSave",
      "start": {"mode":"revise"},
      "steps": [
        {"turn":{"saves":1}},
        {"call":{"name":"update_panels","input":{"n":1}},"expect":{"verdict":"dispatch"}},
        {"turn":{"saves":1}},
        {"call":{"name":"update_panels","input":{"n":2}},"expect":{"verdict":"dispatch"}},
        {"turn":{"saves":1}},
        {"call":{"name":"update_panels","input":{"n":1}},"expect":{"verdict":"refuse","step":"Refused update_panels: the same save was sent again","code":"invalid_request","message":"this save is identical to an earlier one and changes nothing; save the next panel, or set finish: true when every planned panel is built"}},
        {"turn":{"saves":1}},
        {"call":{"name":"update_panels","input":{"n":1}},"expect":{"verdict":"refuse"}},
        {"restart":{}},
        {"turn":{"saves":1}},
        {"call":{"name":"update_panels","input":{"n":1}},"expect":{"verdict":"dispatch"}}
      ]
    },
    {
      "name": "a successful read is replayed once and the third is refused",
      "source": "TestStateReplaysASuccessAndRefusesTheThird",
      "start": {"mode":"create"},
      "steps": [
        {"turn":{"saves":0}},
        {"call":{"name":"get_panels","input":{}},"expect":{"verdict":"dispatch"},"result":{}},
        {"turn":{"saves":0}},
        {"call":{"name":"get_panels","input":{}},"expect":{"verdict":"replay","note":"This is the result of the same earlier call. A third identical call is refused.","step":"Reused the result of an identical call"}},
        {"turn":{"saves":0}},
        {"call":{"name":"get_panels","input":{}},"expect":{"verdict":"refuse","step":"Refused get_panels: the same read was asked 3 times","code":"invalid_request","message":"this exact call already ran 2 times; use its earlier result, change its input, or save"}},
        {"turn":{"saves":0}},
        {"call":{"name":"get_panels","input":{}},"expect":{"verdict":"refuse"}}
      ]
    },
