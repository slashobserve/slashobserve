{
  "prompt": "Show this per route",
  "turns": [
    {
      "tool_calls": [
        {
          "name": "lint_query",
          "input": {
            "datasource": "prom",
            "query": "sum by (route) (rate(http_requests_total[$__rate_interval]))"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "update_dashboard",
          "input": {
            "summary": "Show requests per second by route",
            "spec": {
              "specVersion": "0",
              "title": "E2E dashboard",
              "tags": ["e2e"],
              "time": { "from": "now-15m", "to": "now" },
              "panels": [
                {
                  "id": "rps",
                  "type": "timeseries",
                  "title": "Requests per second by route",
                  "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
                  "datasource": "prom",
                  "queries": [
                    {
                      "query": "sum by (route) (rate(http_requests_total[$__rate_interval]))"
                    }
                  ]
                },
                {
                  "id": "log_services",
                  "type": "table",
                  "title": "Log rows by service",
                  "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
                  "datasource": "ch",
                  "queries": [
                    {
                      "query": "SELECT ServiceName AS service, count() AS n FROM otel_logs WHERE $__timeFilter(Timestamp) GROUP BY service ORDER BY n DESC LIMIT 10"
                    }
                  ]
                }
              ]
            }
          }
        }
      ],
      "expect": [
        { "is_error": false }
      ]
    }
  ]
}
