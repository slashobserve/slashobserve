{
  "prompt": "Show this per route",
  "turns": [
    {
      "tool_calls": [
        {
          "name": "lint_query",
          "input": {
            "datasource": "prom",
            "query": "sum by (route) (rate(http_requests_total[$__rate_interval]))"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "update_panels",
          "input": {
            "summary": "Show requests per second by route",
            "upsert": [
              {
                "id": "rps",
                "type": "timeseries",
                "title": "Requests per second by route",
                "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
                "datasource": "prom",
                "queries": [
                  {
                    "query": "sum by (route) (rate(http_requests_total[$__rate_interval]))"
                  }
                ]
              }
            ],
            "dashboard": { "title": "E2E dashboard" },
            "finish": true
          }
        }
      ],
      "expect": [{ "is_error": false }]
    }
  ]
}
