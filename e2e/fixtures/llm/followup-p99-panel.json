{
  "prompt": "Add a p99 latency panel",
  "turns": [
    {
      "tool_calls": [
        {
          "name": "lint_query",
          "input": {
            "datasource": "prom",
            "query": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[$__rate_interval])))"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "update_dashboard",
          "input": {
            "summary": "Add a p99 latency panel",
            "spec": {
              "specVersion": "0",
              "title": "E2E dashboard",
              "tags": ["e2e"],
              "timeRange": { "from": "now-15m", "to": "now" },
              "panels": [
                {
                  "id": "rps",
                  "type": "timeseries",
                  "title": "Requests per second by route",
                  "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
                  "datasource": { "type": "prometheus", "uid": "prom" },
                  "query": "sum by (route) (rate(http_requests_total[$__rate_interval]))"
                },
                {
                  "id": "log_services",
                  "type": "table",
                  "title": "Log rows by service",
                  "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
                  "datasource": { "type": "clickhouse", "uid": "ch" },
                  "query": "SELECT ServiceName AS service, count() AS n FROM otel_logs WHERE $__timeFilter(Timestamp) GROUP BY service ORDER BY n DESC LIMIT 10"
                },
                {
                  "id": "p99_latency",
                  "type": "timeseries",
                  "title": "p99 latency",
                  "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
                  "datasource": { "type": "prometheus", "uid": "prom" },
                  "query": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[$__rate_interval])))"
                }
              ]
            }
          }
        }
      ],
      "expect": [{ "is_error": false }]
    }
  ]
}
