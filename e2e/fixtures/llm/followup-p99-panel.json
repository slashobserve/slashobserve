{
  "prompt": "Add a p99 latency panel",
  "turns": [
    {
      "tool_calls": [
        {
          "name": "lint_query",
          "input": {
            "datasource": "prom",
            "query": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[$__rate_interval])))"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "update_panels",
          "input": {
            "summary": "Add a p99 latency panel",
            "upsert": [
              {
                "id": "p99_latency",
                "type": "timeseries",
                "title": "p99 latency",
                "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
                "datasource": "prom",
                "queries": [
                  {
                    "query": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[$__rate_interval])))"
                  }
                ]
              }
            ],
            "dashboard": { "title": "E2E dashboard" },
            "finish": true
          }
        }
      ],
      "expect": [{ "is_error": false }]
    }
  ]
}
