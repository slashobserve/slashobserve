{
  "prompt": "astronomy shop RED metrics by endpoint",
  "turns": [
    {
      "tool_calls": [
        {
          "name": "list_metrics",
          "input": { "datasource": "prom", "search": "traces_span" }
        },
        {
          "name": "list_labels",
          "input": { "datasource": "prom", "metric": "traces_span_metrics_calls_total" }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "lint_query",
          "input": {
            "datasource": "prom",
            "query": "sum by (span_name) (rate(traces_span_metrics_calls_total{service_name=\"frontend\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))"
          }
        },
        {
          "name": "lint_query",
          "input": {
            "datasource": "prom",
            "query": "sum by (status_code) (rate(traces_span_metrics_calls_total{service_name=\"frontend\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))"
          }
        },
        {
          "name": "lint_query",
          "input": {
            "datasource": "prom",
            "query": "histogram_quantile(0.99, sum by (le, span_name) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"frontend\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "create_dashboard",
          "input": {
            "summary": "Create demo shop RED metrics",
            "planned_panels": 3,
            "spec": {
              "specVersion": "0",
              "title": "Astronomy shop RED metrics",
              "tags": ["e2e"],
              "time": { "from": "now-15m", "to": "now" },
              "panels": [
                {
                  "id": "req_rate",
                  "type": "timeseries",
                  "title": "Request rate by route",
                  "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
                  "datasource": "prom",
                  "queries": [
                    {
                      "query": "sum by (span_name) (rate(traces_span_metrics_calls_total{service_name=\"frontend\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])"
                    }
                  ],
                  "unit": "reqps"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "create_dashboard",
          "input": {
            "summary": "Create demo shop RED metrics",
            "planned_panels": 3,
            "spec": {
              "specVersion": "0",
              "title": "Astronomy shop RED metrics",
              "tags": ["e2e"],
              "time": { "from": "now-15m", "to": "now" },
              "panels": [
                {
                  "id": "req_rate",
                  "type": "timeseries",
                  "title": "Request rate by route",
                  "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
                  "datasource": "prom",
                  "queries": [
                    {
                      "query": "sum by (span_name) (rate(traces_span_metrics_calls_total{service_name=\"frontend\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))"
                    }
                  ],
                  "unit": "reqps"
                }
              ]
            }
          }
        }
      ],
      "expect": [{ "is_error": true, "contains": "query_invalid" }]
    },
    {
      "tool_calls": [
        {
          "name": "update_panels",
          "input": {
            "summary": "Add requests by status",
            "upsert": [
              {
                "id": "req_status",
                "type": "timeseries",
                "title": "Requests by status",
                "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
                "datasource": "prom",
                "queries": [
                  {
                    "query": "sum by (status_code) (rate(traces_span_metrics_calls_total{service_name=\"frontend\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))"
                  }
                ],
                "unit": "reqps"
              }
            ]
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "update_panels",
          "input": {
            "summary": "Add p99 latency by route",
            "upsert": [
              {
                "id": "p99_latency",
                "type": "timeseries",
                "title": "p99 latency by route",
                "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
                "datasource": "prom",
                "queries": [
                  {
                    "query": "histogram_quantile(0.99, sum by (le, span_name) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"frontend\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))"
                  }
                ],
                "unit": "ms"
              }
            ],
            "finish": true
          }
        }
      ]
    }
  ]
}
