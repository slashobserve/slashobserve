{
  "prompt": "add a requests by pod panel",
  "turns": [
    {
      "tool_calls": [
        {
          "name": "update_dashboard",
          "input": {
            "summary": "Add requests by pod",
            "spec": {
              "specVersion": "0",
              "title": "Demo shop RED metrics",
              "tags": [
                "e2e"
              ],
              "timeRange": {
                "from": "now-15m",
                "to": "now"
              },
              "panels": [
                {
                  "id": "req_rate",
                  "type": "timeseries",
                  "title": "Request rate by route",
                  "gridPos": {
                    "x": 0,
                    "y": 0,
                    "w": 12,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "prom"
                  },
                  "query": "sum by (route) (rate(http_requests_total[$__rate_interval]))",
                  "unit": "reqps"
                },
                {
                  "id": "req_status",
                  "type": "timeseries",
                  "title": "Requests by status",
                  "gridPos": {
                    "x": 12,
                    "y": 0,
                    "w": 12,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "prom"
                  },
                  "query": "sum by (status) (rate(http_requests_total[$__rate_interval]))",
                  "unit": "reqps"
                },
                {
                  "id": "p99_latency",
                  "type": "timeseries",
                  "title": "p99 latency by route",
                  "gridPos": {
                    "x": 0,
                    "y": 8,
                    "w": 12,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "prom"
                  },
                  "query": "histogram_quantile(0.99, sum by (le, route) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
                  "unit": "s"
                },
                {
                  "id": "req_pod",
                  "type": "timeseries",
                  "title": "Requests by pod",
                  "gridPos": {
                    "x": 12,
                    "y": 8,
                    "w": 12,
                    "h": 8
                  },
                  "datasource": {
                    "type": "prometheus",
                    "uid": "prom"
                  },
                  "query": "sum by (pod) (rate(http_requests_total[$__rate_interval]))",
                  "unit": "reqps"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
