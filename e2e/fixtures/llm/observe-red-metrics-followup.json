{
  "prompt": "add a requests by service panel",
  "turns": [
    {
      "tool_calls": [
        {
          "name": "update_dashboard",
          "input": {
            "summary": "Add requests by service",
            "spec": {
              "specVersion": "0",
              "title": "Astronomy shop RED metrics",
              "tags": ["e2e"],
              "time": { "from": "now-15m", "to": "now" },
              "panels": [
                {
                  "id": "req_rate",
                  "type": "timeseries",
                  "title": "Request rate by route",
                  "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
                  "datasource": "prom",
                  "queries": [
                    {
                      "query": "sum by (span_name) (rate(traces_span_metrics_calls_total{service_name=\"frontend\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))"
                    }
                  ],
                  "unit": "reqps"
                },
                {
                  "id": "req_status",
                  "type": "timeseries",
                  "title": "Requests by status",
                  "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
                  "datasource": "prom",
                  "queries": [
                    {
                      "query": "sum by (status_code) (rate(traces_span_metrics_calls_total{service_name=\"frontend\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))"
                    }
                  ],
                  "unit": "reqps"
                },
                {
                  "id": "p99_latency",
                  "type": "timeseries",
                  "title": "p99 latency by route",
                  "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
                  "datasource": "prom",
                  "queries": [
                    {
                      "query": "histogram_quantile(0.99, sum by (le, span_name) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=\"frontend\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))"
                    }
                  ],
                  "unit": "ms"
                },
                {
                  "id": "req_service",
                  "type": "timeseries",
                  "title": "Requests by service",
                  "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
                  "datasource": "prom",
                  "queries": [
                    {
                      "query": "sum by (service_name) (rate(traces_span_metrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))"
                    }
                  ],
                  "unit": "reqps"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
