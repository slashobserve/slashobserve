{
  "summary": "Rename the e2e dashboard",
  "spec": {
    "specVersion": "0",
    "title": "E2E dashboard renamed",
    "tags": ["e2e"],
    "timeRange": { "from": "now-15m", "to": "now" },
    "panels": [
      {
        "id": "rps",
        "type": "timeseries",
        "title": "Requests per second",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "prom" },
        "query": "sum(rate(http_requests_total[$__rate_interval]))"
      },
      {
        "id": "log_services",
        "type": "table",
        "title": "Log rows by service",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "datasource": { "type": "clickhouse", "uid": "ch" },
        "query": "SELECT ServiceName AS service, count() AS n FROM otel_logs WHERE $__timeFilter(Timestamp) GROUP BY service ORDER BY n DESC LIMIT 10"
      }
    ]
  }
}
