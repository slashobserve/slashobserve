{
  "summary": "Create the query proxy dashboard",
  "spec": {
    "specVersion": "0",
    "title": "Query proxy dashboard",
    "tags": ["e2e"],
    "time": { "from": "now-15m", "to": "now" },
    "variables": [
      {
        "name": "job",
        "type": "query",
        "datasource": "prom",
        "query": "label_values(up, job)"
      },
      {
        "name": "n",
        "type": "custom",
        "options": ["1", "50"]
      },
      {
        "name": "delay",
        "type": "custom",
        "options": ["0", "2"]
      },
      {
        "name": "service",
        "type": "query",
        "datasource": "ch",
        "query": "SELECT DISTINCT ServiceName FROM otel_logs WHERE $__timeFilter(Timestamp)"
      },
      {
        "name": "services",
        "type": "query",
        "datasource": "ch",
        "query": "SELECT DISTINCT ServiceName FROM otel_logs WHERE $__timeFilter(Timestamp)",
        "multi": true,
        "includeAll": true
      }
    ],
    "panels": [
      {
        "id": "p_up",
        "type": "timeseries",
        "title": "Targets up",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "datasource": "prom",
        "queries": [
          { "query": "count(up{job=~\"$job\"})" }
        ]
      },
      {
        "id": "p_logs",
        "type": "table",
        "title": "Log rows for one service",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "datasource": "ch",
        "queries": [
          {
            "query": "SELECT count() AS n FROM otel_logs WHERE ServiceName = '$service' AND $__timeFilter(Timestamp)"
          }
        ]
      },
      {
        "id": "p_series",
        "type": "table",
        "title": "Series cap",
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
        "datasource": "prom_tight",
        "queries": [
          {
            "query": "topk($n, count by (__name__) ({__name__=~\"prometheus_.+\"}))"
          }
        ]
      },
      {
        "id": "p_points",
        "type": "timeseries",
        "title": "Point cap",
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
        "datasource": "prom_tight",
        "queries": [
          { "query": "up{job=\"prometheus\"}" }
        ]
      },
      {
        "id": "p_sleep",
        "type": "table",
        "title": "Timeout",
        "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
        "datasource": "ch_tight",
        "queries": [
          { "query": "SELECT sleep(${delay:csv}) AS s" }
        ]
      },
      {
        "id": "p_all",
        "type": "table",
        "title": "Log rows for all services",
        "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
        "datasource": "ch",
        "queries": [
          {
            "query": "SELECT count() AS n FROM otel_logs WHERE ServiceName IN (${services}) AND $__timeFilter(Timestamp)"
          }
        ]
      },
      {
        "id": "p_multi",
        "type": "timeseries",
        "title": "Several queries",
        "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
        "datasource": "prom",
        "queries": [
          { "query": "count(up)", "legend": "all" },
          {
            "ref": "B",
            "query": "count(up{job=~\"$job\"})",
            "legend": "job"
          },
          { "query": "vector(1)", "hide": true }
        ]
      },
      {
        "id": "p_multi_tight",
        "type": "table",
        "title": "Several queries, one over the series cap",
        "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
        "datasource": "prom_tight",
        "queries": [
          { "query": "count(up)" },
          {
            "ref": "B",
            "query": "topk($n, count by (__name__) ({__name__=~\"prometheus_.+\"}))"
          }
        ]
      },
      {
        "id": "p_globals",
        "type": "table",
        "title": "Global macros",
        "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
        "datasource": "ch",
        "queries": [
          {
            "query": "SELECT $__interval_ms AS interval_ms, $__range_s AS range_s, $__range_ms AS range_ms, ${__from:date:seconds} AS from_s, $__to AS to_ms, $__dashboard AS dashboard, ${__user.login} AS login"
          }
        ]
      },
      {
        "id": "p_chmacros",
        "type": "table",
        "title": "ClickHouse plugin macros",
        "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
        "datasource": "ch",
        "queries": [
          {
            "query": "SELECT $__timeInterval(Timestamp) AS t, count() AS n FROM (SELECT toDate(Timestamp) AS day, Timestamp, ServiceName FROM otel_logs) WHERE $__dateTimeFilter(day, Timestamp) AND $__conditionalAll(ServiceName IN (${services:singlequote}), $services) AND Timestamp >= $__fromTime_ms AND Timestamp <= $__toTime GROUP BY t ORDER BY t LIMIT 100"
          }
        ]
      }
    ]
  }
}
