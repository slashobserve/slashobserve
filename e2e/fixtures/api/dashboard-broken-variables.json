{
  "summary": "Variables that resolve to nothing or fail",
  "spec": {
    "specVersion": "0",
    "title": "Broken variables",
    "time": { "from": "now-15m", "to": "now" },
    "variables": [
      {
        "name": "ghost",
        "type": "query",
        "datasource": "prom",
        "query": "label_values(up{job=\"does-not-exist\"}, job)",
        "includeAll": true
      },
      {
        "name": "bad",
        "type": "query",
        "datasource": "prom",
        "query": "up",
        "includeAll": true
      }
    ],
    "panels": [
      {
        "id": "p0",
        "type": "timeseries",
        "title": "Depends on ghost",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
        "datasource": "prom",
        "queries": [
          { "query": "up{job=~\"$ghost\"}" }
        ]
      },
      {
        "id": "p1",
        "type": "timeseries",
        "title": "Independent",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
        "datasource": "prom",
        "queries": [
          { "query": "up" }
        ]
      }
    ]
  }
}
