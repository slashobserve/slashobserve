{
  "specVersion": "0",
  "title": "E2E overview",
  "time": { "from": "now-15m", "to": "now" },
  "variables": [
    {
      "name": "service",
      "label": "Service",
      "type": "query",
      "multi": true,
      "includeAll": true,
      "datasource": "prom",
      "query": "label_values(traces_span_metrics_calls_total{service_name=~\"checkout|payment\",span_kind=\"SPAN_KIND_SERVER\"}, service_name)"
    }
  ],
  "panels": [
    {
      "id": "rps",
      "type": "timeseries",
      "title": "Shop requests per second",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": "prom",
      "queries": [
        {
          "query": "sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legend": "{{service_name}}"
        }
      ],
      "unit": "reqps"
    },
    {
      "id": "error_rate",
      "type": "stat",
      "title": "Checkout error rate",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": "prom",
      "queries": [
        {
          "query": "(sum(rate(traces_span_metrics_calls_total{service_name=\"checkout\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[5m])) or vector(0)) / sum(rate(traces_span_metrics_calls_total{service_name=\"checkout\",span_kind=\"SPAN_KIND_SERVER\"}[5m]))"
        }
      ],
      "unit": "percentunit",
      "decimals": 2,
      "thresholds": [
        { "value": 0.01, "color": "warning" },
        { "value": 0.05, "color": "critical" }
      ]
    },
    {
      "id": "rps_by_service",
      "type": "bargauge",
      "title": "Requests by service",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": "prom",
      "queries": [
        {
          "query": "sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\"}[5m]))",
          "legend": "{{service_name}}"
        }
      ],
      "unit": "reqps",
      "min": 0
    },
    {
      "id": "logs",
      "type": "table",
      "title": "Log rows by service",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "datasource": "ch",
      "queries": [
        {
          "query": "SELECT ServiceName AS service, count() AS n FROM otel_logs WHERE $__timeFilter(Timestamp) GROUP BY service ORDER BY n DESC LIMIT 10"
        }
      ]
    }
  ]
}
