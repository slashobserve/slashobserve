{
  "specVersion": "0",
  "title": "E2E live fault",
  "time": { "from": "now-5m", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "id": "fault_rate",
      "type": "stat",
      "title": "Cart error rate",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 5 },
      "datasource": "prom",
      "queries": [
        {
          "query": "(sum(rate(traces_span_metrics_calls_total{service_name=\"cart\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[3m])) or vector(0)) / sum(rate(traces_span_metrics_calls_total{service_name=\"cart\",span_kind=\"SPAN_KIND_SERVER\"}[3m]))"
        }
      ],
      "unit": "percentunit",
      "thresholds": [
        { "value": 0.01, "color": "warning" },
        { "value": 0.05, "color": "critical" }
      ]
    }
  ]
}
