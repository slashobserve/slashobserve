{
  "specVersion": "0",
  "title": "E2E links",
  "time": { "from": "now-15m", "to": "now" },
  "variables": [
    {
      "name": "env",
      "label": "Environment",
      "type": "custom",
      "options": ["prod", "staging"]
    },
    {
      "name": "target",
      "type": "custom",
      "options": ["javascript:alert(1)"],
      "hide": "variable"
    }
  ],
  "links": [
    {
      "title": "Runbook",
      "url": "https://example.com/runbook?env=${env}",
      "newTab": true
    }
  ],
  "panels": [
    {
      "id": "rps",
      "type": "timeseries",
      "title": "Shop requests per second",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": "prom",
      "queries": [
        {
          "query": "sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"checkout|payment\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legend": "{{service_name}}"
        }
      ],
      "unit": "reqps",
      "links": [
        {
          "title": "Explore ${env}",
          "url": "/dashboards?q=${env}",
          "newTab": true
        },
        { "title": "Bad", "url": "${target}" }
      ]
    },
    {
      "id": "p_none",
      "type": "timeseries",
      "title": "Nothing here",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": "prom",
      "queries": [{ "query": "count(traces_span_metrics_calls_total)" }],
      "noValue": "Nothing yet"
    }
  ]
}
