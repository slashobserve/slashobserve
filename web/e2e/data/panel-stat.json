{
  "specVersion": "0",
  "title": "E2E stat panels",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": "st_bg",
      "type": "stat",
      "title": "Background",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": "prom",
      "queries": [{ "query": "sum(rate(http_requests_total[5m]))" }],
      "unit": "reqps",
      "thresholds": [{ "color": "ok" }, { "value": 0.001, "color": "warning" }],
      "display": { "colorMode": "background" }
    },
    {
      "id": "st_map",
      "type": "stat",
      "title": "Mapped",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": "prom",
      "queries": [{ "query": "min(up{job=\"prometheus\"})" }],
      "mappings": [
        { "value": "1", "text": "Up", "color": "ok" },
        { "value": "0", "text": "Down", "color": "critical" }
      ]
    },
    {
      "id": "st_prefix",
      "type": "stat",
      "title": "Prefix",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": "prom",
      "queries": [{ "query": "sum(rate(http_requests_total[5m]))" }],
      "unit": "prefix:$",
      "decimals": 1
    },
    {
      "id": "st_link",
      "type": "stat",
      "title": "Linked",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": "prom",
      "queries": [{ "query": "sum(rate(http_requests_total[5m]))" }],
      "links": [
        {
          "title": "Details for ${__series.name}",
          "url": "/dashboards?q=${__value.raw}"
        }
      ]
    },
    {
      "id": "st_pods",
      "type": "stat",
      "title": "Pods",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 4 },
      "datasource": "prom",
      "queries": [
        {
          "query": "sum by (pod) (rate(http_requests_total[5m]))",
          "legend": "{{pod}}"
        }
      ],
      "display": {
        "orientation": "horizontal",
        "textMode": "valueAndName",
        "reduce": "max"
      }
    }
  ]
}
