{
  "specVersion": "0",
  "title": "E2E gauge panels",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": "g_err",
      "type": "gauge",
      "title": "Error percent",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": "prom",
      "queries": [
        {
          "query": "100 * (1 - sum(rate(traces_span_metrics_calls_total{status_code!=\"STATUS_CODE_ERROR\",span_kind=\"SPAN_KIND_SERVER\"}[5m])) / sum(rate(traces_span_metrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[5m])))"
        }
      ],
      "unit": "percent",
      "min": 0,
      "max": 100,
      "thresholds": [
        { "color": "ok" },
        { "value": 1, "color": "warning" },
        { "value": 5, "color": "critical" }
      ]
    },
    {
      "id": "g_pods",
      "type": "gauge",
      "title": "Requests by service",
      "gridPos": { "x": 8, "y": 0, "w": 16, "h": 8 },
      "datasource": "prom",
      "queries": [
        {
          "query": "sum by (service_name) (rate(traces_span_metrics_calls_total{service_name=~\"checkout|payment\",span_kind=\"SPAN_KIND_SERVER\"}[5m]))",
          "legend": "{{service_name}}"
        }
      ],
      "unit": "reqps",
      "display": { "thresholdMarkers": false }
    }
  ]
}
