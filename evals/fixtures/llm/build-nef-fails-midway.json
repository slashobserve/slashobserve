{
  "prompt": "eval build: the first save is accepted and every later save is rejected",
  "turns": [
    {
      "tool_calls": [
        {
          "name": "create_dashboard",
          "input": {
            "summary": "Start Node Exporter Full",
            "planned_panels": 3,
            "spec": {
              "specVersion": "0",
              "title": "Node Exporter Full",
              "time": {
                "from": "now-1h",
                "to": "now"
              },
              "panels": [
                {
                  "id": "row_cpu",
                  "type": "row",
                  "title": "CPU",
                  "gridPos": {
                    "x": 0,
                    "y": 0,
                    "w": 24,
                    "h": 1
                  },
                  "panels": [
                    {
                      "id": "cpu_busy",
                      "type": "timeseries",
                      "title": "CPU Busy",
                      "gridPos": {
                        "x": 0,
                        "y": 1,
                        "w": 12,
                        "h": 8
                      },
                      "datasource": "prom",
                      "queries": [
                        {
                          "query": "sum(rate(node_cpu_seconds_total{mode!=\"idle\"}[$__rate_interval]))"
                        }
                      ],
                      "unit": "percentunit"
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    {
      "tool_calls": [
