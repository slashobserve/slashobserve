{
  "specVersion": "0",
  "title": "Demo shop overview",
  "description": "Is the demo shop healthy: traffic, orders, its database, and what checkout's logs and traces say.",
  "tags": ["demo", "shop"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    { "id": "p_requests", "type": "stat", "title": "Requests per second",
      "description": "Requests per second the frontend answered, the traffic customers send.",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 }, "datasource": "prom", "unit": "reqps",
      "queries": [{ "query": "sum(rate(http_requests_total{job=\"shop\",service=\"frontend\"}[$__rate_interval]))" }] },
    { "id": "p_error_ratio", "type": "stat", "title": "Server errors",
      "description": "Share of frontend requests that ended with a 5xx status.",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 }, "datasource": "prom", "unit": "percentunit", "decimals": 2,
      "thresholds": [{ "color": "ok" }, { "value": 0.01, "color": "warning" }, { "value": 0.05, "color": "critical" }],
      "queries": [{ "query": "(sum(rate(http_requests_total{job=\"shop\",service=\"frontend\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_requests_total{job=\"shop\",service=\"frontend\"}[$__rate_interval]))" }] },
    { "id": "p_latency_p95", "type": "stat", "title": "p95 latency",
      "description": "95th percentile time the frontend took to answer a request.",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 }, "datasource": "prom", "unit": "s",
      "queries": [{ "query": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"shop\",service=\"frontend\"}[$__rate_interval])))" }] },
    { "id": "p_orders_per_minute", "type": "stat", "title": "Orders processed",
      "description": "Orders the checkout workers took off the queue and completed, per minute.",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 }, "datasource": "prom", "unit": "suffix: /min",
      "queries": [{ "query": "sum(rate(shop_orders_processed_total{result=\"ok\"}[$__rate_interval])) * 60" }] },
    { "id": "p_queue_depth", "type": "stat", "title": "Orders waiting",
      "description": "Orders in the checkout queue that no worker has started yet.",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 }, "datasource": "prom", "unit": "short", "decimals": 0,
      "queries": [{ "query": "sum(shop_orders_queue_depth)" }] },
    { "id": "p_db_pool_in_use", "type": "stat", "title": "Database pool in use",
      "description": "Share of inventory database connections held by a query, across all pods.",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 }, "datasource": "prom", "unit": "percentunit",
      "thresholds": [{ "color": "ok" }, { "value": 0.8, "color": "warning" }, { "value": 0.9, "color": "critical" }],
      "queries": [{ "query": "sum(shop_db_pool_in_use) / sum(shop_db_pool_max)" }] },
    { "id": "r_traffic", "type": "row", "title": "Is traffic healthy?",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 1 },
      "panels": [
        { "id": "p_requests_by_route", "type": "timeseries", "title": "Requests per second by route",
          "gridPos": { "x": 0, "y": 5, "w": 8, "h": 8 }, "datasource": "prom", "unit": "reqps",
          "queries": [{ "query": "sum by (route) (rate(http_requests_total{job=\"shop\"}[$__rate_interval]))", "legend": "{{route}}" }] },
        { "id": "p_errors_by_route", "type": "timeseries", "title": "Server error ratio by route",
          "gridPos": { "x": 8, "y": 5, "w": 8, "h": 8 }, "datasource": "prom", "unit": "percentunit",
          "queries": [{ "query": "(sum by (route) (rate(http_requests_total{job=\"shop\",status=~\"5..\"}[$__rate_interval])) or sum by (route) (rate(http_requests_total{job=\"shop\"}[$__rate_interval])) * 0) / sum by (route) (rate(http_requests_total{job=\"shop\"}[$__rate_interval]))", "legend": "{{route}}" }] },
        { "id": "p_latency_by_route", "type": "timeseries", "title": "p95 latency by route",
          "gridPos": { "x": 16, "y": 5, "w": 8, "h": 8 }, "datasource": "prom", "unit": "s",
          "queries": [{ "query": "histogram_quantile(0.95, sum by (route, le) (rate(http_request_duration_seconds_bucket{job=\"shop\"}[$__rate_interval])))", "legend": "{{route}}" }] }
      ] },
    { "id": "r_orders", "type": "row", "title": "Are orders flowing?",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 1 },
      "panels": [
        { "id": "p_orders_by_result", "type": "timeseries", "title": "Orders processed per minute by result",
          "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 }, "datasource": "prom", "unit": "suffix: /min",
          "queries": [{ "query": "sum by (result) (rate(shop_orders_processed_total[$__rate_interval])) * 60", "legend": "{{result}}" }] },
        { "id": "p_order_processing", "type": "timeseries", "title": "Order processing time",
          "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 }, "datasource": "prom", "unit": "s",
          "queries": [
            { "query": "histogram_quantile(0.5, sum by (le) (rate(shop_order_processing_seconds_bucket[$__rate_interval])))", "legend": "p50" },
            { "query": "histogram_quantile(0.95, sum by (le) (rate(shop_order_processing_seconds_bucket[$__rate_interval])))", "legend": "p95" },
            { "query": "histogram_quantile(0.99, sum by (le) (rate(shop_order_processing_seconds_bucket[$__rate_interval])))", "legend": "p99" }
          ] },
        { "id": "p_queue_depth_by_pod", "type": "timeseries", "title": "Orders waiting by pod",
          "gridPos": { "x": 0, "y": 22, "w": 12, "h": 8 }, "datasource": "prom", "unit": "short",
          "queries": [{ "query": "sum by (pod) (shop_orders_queue_depth)", "legend": "{{pod}}" }] },
        { "id": "p_queue_age_by_pod", "type": "timeseries", "title": "Oldest waiting order by pod",
          "gridPos": { "x": 12, "y": 22, "w": 12, "h": 8 }, "datasource": "prom", "unit": "s",
          "queries": [{ "query": "max by (pod) (shop_orders_queue_oldest_age_seconds)", "legend": "{{pod}}" }] }
      ] },
    { "id": "r_database", "type": "row", "title": "Is the database keeping up?",
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 1 },
      "panels": [
        { "id": "p_pool_by_pod", "type": "timeseries", "title": "Pool connections in use by pod",
          "gridPos": { "x": 0, "y": 31, "w": 8, "h": 8 }, "datasource": "prom", "unit": "percentunit", "min": 0, "max": 1,
          "queries": [{ "query": "sum by (pod) (shop_db_pool_in_use) / sum by (pod) (shop_db_pool_max)", "legend": "{{pod}}" }] },
        { "id": "p_query_time", "type": "timeseries", "title": "p95 query time by query",
          "gridPos": { "x": 8, "y": 31, "w": 8, "h": 8 }, "datasource": "prom", "unit": "s",
          "queries": [{ "query": "histogram_quantile(0.95, sum by (query, le) (rate(shop_db_query_duration_seconds_bucket[$__rate_interval])))", "legend": "{{query}}" }] },
        { "id": "p_cache_hit_ratio", "type": "timeseries", "title": "Product cache hit ratio by service",
          "gridPos": { "x": 16, "y": 31, "w": 8, "h": 8 }, "datasource": "prom", "unit": "percentunit", "min": 0, "max": 1,
          "queries": [{ "query": "sum by (service) (rate(shop_product_cache_requests_total{result=\"hit\"}[$__rate_interval])) / sum by (service) (rate(shop_product_cache_requests_total[$__rate_interval]))", "legend": "{{service}}" }] }
      ] },
    { "id": "r_logs", "type": "row", "title": "What do the logs say?",
      "gridPos": { "x": 0, "y": 39, "w": 24, "h": 1 },
      "panels": [
        { "id": "p_log_volume", "type": "timeseries", "title": "Checkout log lines by severity",
          "gridPos": { "x": 0, "y": 40, "w": 12, "h": 8 }, "datasource": "ch", "unit": "short",
          "queries": [{ "query": "SELECT $__timeInterval(Timestamp) AS time, SeverityText AS severity, count() AS lines FROM otel_logs WHERE $__timeFilter(Timestamp) AND ServiceName = 'checkout' GROUP BY time, severity ORDER BY time", "legend": "{{severity}}" }] },
        { "id": "p_error_messages", "type": "table", "title": "Checkout errors by message",
          "gridPos": { "x": 12, "y": 40, "w": 12, "h": 8 }, "datasource": "ch", "unit": "short",
          "queries": [{ "query": "SELECT Body AS message, count() AS lines FROM otel_logs WHERE $__timeFilter(Timestamp) AND ServiceName = 'checkout' AND SeverityText = 'ERROR' GROUP BY message ORDER BY lines DESC LIMIT 10", "format": "table" }] },
        { "id": "p_checkout_errors", "type": "logs", "title": "Checkout error lines",
          "gridPos": { "x": 0, "y": 48, "w": 24, "h": 10 }, "datasource": "ch",
          "queries": [{ "query": "SELECT Timestamp, SeverityText, Body, TraceId FROM otel_logs WHERE $__timeFilter(Timestamp) AND ServiceName = 'checkout' AND SeverityText = 'ERROR' ORDER BY Timestamp DESC LIMIT 200", "format": "logs" }],
          "display": { "showTime": true } },
        { "id": "p_checkout_span_time", "type": "timeseries", "title": "Checkout span time p95",
          "gridPos": { "x": 0, "y": 58, "w": 12, "h": 8 }, "datasource": "ch", "unit": "ms",
          "queries": [{ "query": "SELECT $__timeInterval(Timestamp) AS time, quantile(0.95)(Duration) / 1e6 AS p95 FROM otel_traces WHERE $__timeFilter(Timestamp) AND ServiceName = 'checkout' AND SpanName = 'POST /checkout' GROUP BY time ORDER BY time" }],
          "display": { "legend": "hidden" } },
        { "id": "p_slowest_checkouts", "type": "table", "title": "Slowest checkouts",
          "gridPos": { "x": 12, "y": 58, "w": 12, "h": 8 }, "datasource": "ch",
          "queries": [{ "query": "SELECT Timestamp AS time, TraceId AS trace_id, Duration / 1e6 AS duration_ms, StatusCode AS status FROM otel_traces WHERE $__timeFilter(Timestamp) AND ServiceName = 'checkout' AND SpanName = 'POST /checkout' ORDER BY Duration DESC LIMIT 20", "format": "table" }],
          "overrides": [
            { "match": { "field": "duration_ms" }, "unit": "ms" },
            { "match": { "field": "trace_id" }, "links": [{ "title": "Open trace", "url": "/t/${__data.fields.trace_id}?ds=ch" }] }
          ] }
      ] }
  ]
}
