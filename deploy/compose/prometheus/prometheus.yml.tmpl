global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: [localhost:9090]

  - job_name: shop
    scrape_interval: 5s
    static_configs:
      - targets: [frontend-0:8080, checkout-0:8080, checkout-1:8080, payments-0:8080]

  - job_name: otel-collector
    static_configs:
      - targets: [otel-collector:8888]

  - job_name: node
    static_configs:
      - targets: [node-exporter:9100]
    relabel_configs:
      - target_label: instance
        replacement: demo-node

  - job_name: cadvisor
    static_configs:
      - targets: [cadvisor:8080]
    metric_relabel_configs:
      - source_labels: [container_label_com_docker_compose_project]
        regex: __COMPOSE_PROJECT__
        target_label: __tmp_same_project
        replacement: "1"
      - source_labels: [__name__, __tmp_same_project]
        regex: "container_.+;"
        action: drop
      - source_labels: [container_label_com_docker_compose_service]
        target_label: pod
      - source_labels: [container_label_com_docker_compose_service]
        regex: "(.+)-[0-9]+"
        target_label: service
      - source_labels: [container_label_com_docker_compose_project]
        target_label: compose_project
      - regex: "__tmp_same_project|container_label_.+"
        action: labeldrop
