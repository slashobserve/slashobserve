issuer: {{ getenv "DEX_ISSUER" }}
storage:
  type: memory
web:
  http: 0.0.0.0:5556
oauth2:
  skipApprovalScreen: true
staticClients:
  - id: slashobserve
    name: SlashObserve
    secret: {{ getenv "DEX_CLIENT_SECRET" }}
    redirectURIs:
      - {{ getenv "DEX_REDIRECT_URI" }}
enablePasswordDB: true
staticPasswords:
  # Development-only logins, all with password "password" (Dex's documented example hash).
  # admin@example.com is on the allowed domain and listed in SLASHOBSERVE_ADMIN_EMAILS; outsider@example.org exists to prove refusal.
  # editor, commenter and viewer start as Editors; an Admin sets their roles on the People page.
  - email: "admin@example.com"
    hash: "$2a$10$2b2cU8CPhOTaGrs1HRQuAueS7JTT5ZHsHSzYiFPm1leZck7Mc8T4W"
    username: "admin"
    userID: "08a8684b-db88-4b73-90a9-3cd1661f5466"
  - email: "editor@example.com"
    hash: "$2a$10$2b2cU8CPhOTaGrs1HRQuAueS7JTT5ZHsHSzYiFPm1leZck7Mc8T4W"
